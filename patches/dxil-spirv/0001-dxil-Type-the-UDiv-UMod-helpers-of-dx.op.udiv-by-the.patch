From 15e5c86f51b3822e8503ae98adb162048d146902 Mon Sep 17 00:00:00 2001
From: Grzegorz <grzegorz2047@gmail.com>
Date: Wed, 25 Nov 2026 01:57:03 +0100
Subject: [PATCH 1/3] dxil: Type the UDiv/UMod helpers of dx.op.udiv by the
 operand type.

emit_dxbc_udiv_instruction passed the instruction's result type, the
{quotient, remainder} pair, to get_helper_call_id(). The helpers were
built with that struct as their parameter and return type while being
called with i32 operands, so spirv-val rejected the module
("OpFunctionCall Argument's type does not match Function's parameter
type") and NVIDIA's Vulkan driver crashed in vkCreateComputePipelines.

DXC never emits dx.op.udiv (opcode 68) for HLSL integer division, so
only producers writing DXIL directly reach this path. Use the type of
the first operand; the pair is still built from the two calls below.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 opcodes/dxil/dxil_arithmetic.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/opcodes/dxil/dxil_arithmetic.cpp b/opcodes/dxil/dxil_arithmetic.cpp
index 6148d75..ce5018b 100644
--- a/opcodes/dxil/dxil_arithmetic.cpp
+++ b/opcodes/dxil/dxil_arithmetic.cpp
@@ -572,7 +572,9 @@ bool emit_dxbc_udiv_instruction(Converter::Impl &impl, const llvm::CallInst *ins
 	spv::Id id0 = impl.get_id_for_value(instruction->getOperand(1));
 	spv::Id id1 = impl.get_id_for_value(instruction->getOperand(2));
 
-	spv::Id type_id = impl.get_type_id(instruction->getType());
+	// The helpers take and return the operands' scalar type; the instruction itself returns
+	// the {quotient, remainder} pair, which is built below.
+	spv::Id type_id = impl.get_type_id(instruction->getOperand(1)->getType());
 	spv::Id quot_id = impl.spirv_module.get_helper_call_id(HelperCall::UDiv, type_id);
 	spv::Id rem_id = impl.spirv_module.get_helper_call_id(HelperCall::UMod, type_id);
 
