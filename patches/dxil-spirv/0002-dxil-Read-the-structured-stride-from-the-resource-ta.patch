From 7f171ca164e1e09a51cd185bc1abf6ce242716ba Mon Sep 17 00:00:00 2001
From: Grzegorz <grzegorz2047@gmail.com>
Date: Wed, 25 Nov 2026 02:17:26 +0100
Subject: [PATCH 2/3] dxil: Read the structured stride from the resource tags
 by tag.

A resource's extended properties are a list of (tag, value) pairs. The
stride was read as operand 1 of that list, so a RWByteAddressBuffer
that uses 64-bit atomics, which DXC tags { 3 (Atomic64Use), 1 }, got a
structured stride of 1. On the physical-pointer path (root UAVs)
build_physical_pointer_address_for_raw_load_store() then treated it as
structured and added the elementOffset operand, which is undef for raw
buffers, to every load address: OpIAdd(index * 1, OpUndef).

Seen with XCL's recompiled shaders on an RTX 3060: a compute shader
with 64-bit atomics on such a buffer hung the GPU until the device was
lost, and another read garbage before its atomics (expected 3856, got
0). After the fix both pass, and the loads use a plain access chain.

Take the stride from tag 1 (StructuredBufferElementStride) only, in
emit_srvs(), emit_uavs() and get_raw_buffer_meta().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dxil_converter.cpp | 28 ++++++++++++++++++++--------
 1 file changed, 20 insertions(+), 8 deletions(-)

diff --git a/dxil_converter.cpp b/dxil_converter.cpp
index 90f963e..c89c7c1 100644
--- a/dxil_converter.cpp
+++ b/dxil_converter.cpp
@@ -172,6 +172,21 @@ static T get_constant_metadata(const llvm::MDNode *node, unsigned index)
 	    llvm::cast<llvm::ConstantAsMetadata>(node->getOperand(index))->getValue()->getUniqueInteger().getSExtValue());
 }
 
+// Resource extended properties are a flat list of (tag, value) pairs.
+// Only kDxilStructuredBufferElementStrideTag (1) carries a stride. Other tags,
+// e.g. kDxilAtomic64UseTag (3) which DXC emits as { 3, 1 } on a RWByteAddressBuffer
+// that uses 64-bit atomics, must not be mistaken for a stride.
+static uint32_t get_structured_stride_from_tags(const llvm::MDNode *tags)
+{
+	if (!tags)
+		return 0;
+	unsigned num_ops = tags->getNumOperands();
+	for (unsigned i = 0; i + 1 < num_ops; i += 2)
+		if (get_constant_metadata(tags, i) == 1)
+			return get_constant_metadata(tags, i + 1);
+	return 0;
+}
+
 static String get_string_metadata(const llvm::MDNode *node, unsigned index)
 {
 #ifdef HAVE_LLVMBC
@@ -1299,9 +1314,8 @@ bool Converter::Impl::emit_srvs(const llvm::MDNode *srvs, const llvm::MDNode *re
 		else
 		{
 			// Structured/Raw buffers, just use uint for good measure, we'll bitcast as needed.
-			// Field 1 is stride, but we don't care about that unless we will support an SSBO path.
-			if (tags)
-				stride = get_constant_metadata(tags, 1);
+			// The stride is the value of tag 1 (StructuredBufferElementStride), if present.
+			stride = get_structured_stride_from_tags(tags);
 		}
 
 		unsigned alignment = resource_kind == DXIL::ResourceKind::RawBuffer ? 16 : (stride & -int(stride));
@@ -1891,10 +1905,9 @@ bool Converter::Impl::emit_uavs(const llvm::MDNode *uavs, const llvm::MDNode *re
 		else
 		{
 			// Structured/Raw buffers, just use uint for good measure, we'll bitcast as needed.
-			// Field 1 is stride, but we don't care about that unless we will support an SSBO path.
+			// The stride is the value of tag 1 (StructuredBufferElementStride), if present.
 			format = spv::ImageFormatR32ui;
-			if (tags)
-				stride = get_constant_metadata(tags, 1);
+			stride = get_structured_stride_from_tags(tags);
 		}
 
 		unsigned alignment = resource_kind == DXIL::ResourceKind::RawBuffer ? 16 : (stride & -int(stride));
@@ -3259,8 +3272,7 @@ Converter::Impl::get_raw_buffer_meta(DXIL::ResourceType resource_type, unsigned
 			llvm::MDNode *tags = nullptr;
 			if (entry->getNumOperands() > tag_index && entry->getOperand(tag_index))
 				tags = llvm::dyn_cast<llvm::MDNode>(entry->getOperand(tag_index));
-			if (tags)
-				meta.stride = get_constant_metadata(tags, 1);
+			meta.stride = get_structured_stride_from_tags(tags);
 			return meta;
 		}
 	}
