From 2fa78590a9650812a5d9bee7164c6fc8045cf1ff Mon Sep 17 00:00:00 2001
From: Grzegorz <grzegorz2047@gmail.com>
Date: Wed, 25 Nov 2026 01:57:03 +0100
Subject: [PATCH 1/3] vkd3d: Accept objects whose vtable pointer was swapped
 for an extended copy.

XCL (an Xbox Series compatibility layer) adopts every D3D12 object it
hands to a title by replacing the object's vtable pointer with an
extended copy of the original; element [-1] of the copy holds the
original vtable. vkd3d-proton identifies its own objects by comparing
iface->lpVtbl with its vtables, so with such objects:

- the asserts in the impl_from_*() helpers fired (release builds keep
  asserts unless b_ndebug is set),
- d3d12_command_allocator_from_iface() and the bundle variant returned
  NULL, so CreateCommandList failed with E_INVALIDARG,
- d3d12_command_list_from_iface() returned NULL, and
  ExecuteCommandLists crashed dereferencing it.

Add VKD3D_VTBL_IS(), true when the vtable is ours or when element [-1]
of it is ours, and use it for every identity check in libs/vkd3d.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/vkd3d/bundle.c        |  4 ++--
 libs/vkd3d/command.c       | 18 +++++++++---------
 libs/vkd3d/meta_commands.c |  2 +-
 libs/vkd3d/vkd3d_private.h | 29 ++++++++++++++++++-----------
 4 files changed, 30 insertions(+), 23 deletions(-)

diff --git a/libs/vkd3d/bundle.c b/libs/vkd3d/bundle.c
index b667148..5cd45d7 100644
--- a/libs/vkd3d/bundle.c
+++ b/libs/vkd3d/bundle.c
@@ -238,7 +238,7 @@ HRESULT d3d12_bundle_allocator_create(struct d3d12_device *device,
 
 static struct d3d12_bundle_allocator *d3d12_bundle_allocator_from_iface(ID3D12CommandAllocator *iface)
 {
-    if (!iface || iface->lpVtbl != &d3d12_bundle_allocator_vtbl)
+    if (!iface || !VKD3D_VTBL_IS(iface, &d3d12_bundle_allocator_vtbl))
         return NULL;
 
     return impl_from_ID3D12CommandAllocator(iface);
@@ -1922,7 +1922,7 @@ void d3d12_bundle_execute(struct d3d12_bundle *bundle, d3d12_command_list_iface
 
 struct d3d12_bundle *d3d12_bundle_from_iface(ID3D12GraphicsCommandList *iface)
 {
-    if (!iface || iface->lpVtbl != (struct ID3D12GraphicsCommandListVtbl *)&d3d12_bundle_vtbl)
+    if (!iface || !VKD3D_VTBL_IS(iface, &d3d12_bundle_vtbl))
         return NULL;
 
     return impl_from_ID3D12GraphicsCommandList((d3d12_command_list_iface *)iface);
diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 2fa163c..f38195d 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -3352,7 +3352,7 @@ static bool d3d12_command_allocator_allocate_query_from_heap_type(struct d3d12_c
 
 static struct d3d12_command_allocator *d3d12_command_allocator_from_iface(ID3D12CommandAllocator *iface)
 {
-    if (!iface || iface->lpVtbl != &d3d12_command_allocator_vtbl)
+    if (!iface || !VKD3D_VTBL_IS(iface, &d3d12_command_allocator_vtbl))
         return NULL;
 
     return impl_from_ID3D12CommandAllocator(iface);
@@ -23467,19 +23467,19 @@ struct d3d12_command_list *d3d12_command_list_from_iface(ID3D12CommandList *ifac
         return NULL;
 
 #ifdef VKD3D_ENABLE_PROFILING
-    is_valid |= iface->lpVtbl == (struct ID3D12CommandListVtbl *)&d3d12_command_list_vtbl_profiled;
+    is_valid |= VKD3D_VTBL_IS(iface, &d3d12_command_list_vtbl_profiled);
 #endif
 
     /* A little annoying, but we only have to validate this on submission,
      * so the overhead is irrelevant. */
     is_valid |=
-            iface->lpVtbl == (struct ID3D12CommandListVtbl *)&d3d12_command_list_vtbl_default ||
-            iface->lpVtbl == (struct ID3D12CommandListVtbl *)&d3d12_command_list_vtbl_embedded_64_16 ||
-            iface->lpVtbl == (struct ID3D12CommandListVtbl *)&d3d12_command_list_vtbl_embedded_32_32 ||
-            iface->lpVtbl == (struct ID3D12CommandListVtbl *)&d3d12_command_list_vtbl_embedded_32_16 ||
-            iface->lpVtbl == (struct ID3D12CommandListVtbl *)&d3d12_command_list_vtbl_embedded_128_32 ||
-            iface->lpVtbl == (struct ID3D12CommandListVtbl *)&d3d12_command_list_vtbl_embedded_128_16 ||
-            iface->lpVtbl == (struct ID3D12CommandListVtbl *)&d3d12_command_list_vtbl_embedded_default;
+            VKD3D_VTBL_IS(iface, &d3d12_command_list_vtbl_default) ||
+            VKD3D_VTBL_IS(iface, &d3d12_command_list_vtbl_embedded_64_16) ||
+            VKD3D_VTBL_IS(iface, &d3d12_command_list_vtbl_embedded_32_32) ||
+            VKD3D_VTBL_IS(iface, &d3d12_command_list_vtbl_embedded_32_16) ||
+            VKD3D_VTBL_IS(iface, &d3d12_command_list_vtbl_embedded_128_32) ||
+            VKD3D_VTBL_IS(iface, &d3d12_command_list_vtbl_embedded_128_16) ||
+            VKD3D_VTBL_IS(iface, &d3d12_command_list_vtbl_embedded_default);
 
     if (!is_valid)
         return NULL;
diff --git a/libs/vkd3d/meta_commands.c b/libs/vkd3d/meta_commands.c
index 851e95d..d594e30 100644
--- a/libs/vkd3d/meta_commands.c
+++ b/libs/vkd3d/meta_commands.c
@@ -629,6 +629,6 @@ struct d3d12_meta_command *impl_from_ID3D12MetaCommand(ID3D12MetaCommand *iface)
 {
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_meta_command_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_meta_command_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_meta_command, ID3D12MetaCommand_iface);
 }
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 26b09c1..036694b 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -35,6 +35,13 @@
 #include "vkd3d_shader.h"
 #include "vkd3d_threads.h"
 #include "vkd3d_platform.h"
+
+/* XCL (Xbox Series compatibility layer) "adopts" D3D12 objects by replacing their vtable
+ * pointer with an extended copy whose element [-1] holds the original vtable. An object is
+ * ours when its vtable is ours, or when it is such a copy of ours. */
+#define VKD3D_VTBL_IS(iface, vtbl) \
+    ((const void *)(iface)->lpVtbl == (const void *)(vtbl) || \
+     ((const void *const *)(iface)->lpVtbl)[-1] == (const void *)(vtbl))
 #include "vkd3d_swapchain_factory.h"
 #include "vkd3d_command_list_vkd3d_ext.h"
 #include "vkd3d_command_queue_vkd3d_ext.h"
@@ -704,7 +711,7 @@ static inline struct d3d12_fence *impl_from_ID3D12Fence1(ID3D12Fence1 *iface)
     extern CONST_VTBL struct ID3D12Fence1Vtbl d3d12_fence_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_fence_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_fence_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_fence, ID3D12Fence_iface);
 }
 
@@ -755,7 +762,7 @@ static inline struct d3d12_shared_fence *shared_impl_from_ID3D12Fence1(ID3D12Fen
     extern CONST_VTBL struct ID3D12Fence1Vtbl d3d12_shared_fence_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_shared_fence_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_shared_fence_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_shared_fence, ID3D12Fence_iface);
 }
 
@@ -771,9 +778,9 @@ static inline bool is_shared_ID3D12Fence1(ID3D12Fence1 *iface)
 {
     extern CONST_VTBL struct ID3D12Fence1Vtbl d3d12_shared_fence_vtbl;
     extern CONST_VTBL struct ID3D12Fence1Vtbl d3d12_fence_vtbl;
-    assert(iface->lpVtbl ==  &d3d12_shared_fence_vtbl || iface->lpVtbl == &d3d12_fence_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_shared_fence_vtbl) || VKD3D_VTBL_IS(iface, &d3d12_fence_vtbl));
 
-    return iface->lpVtbl ==  &d3d12_shared_fence_vtbl;
+    return VKD3D_VTBL_IS(iface, &d3d12_shared_fence_vtbl);
 }
 
 static inline bool is_shared_ID3D12Fence(ID3D12Fence *iface)
@@ -1076,7 +1083,7 @@ static inline struct d3d12_heap *impl_from_ID3D12Heap1(ID3D12Heap1 *iface)
     extern CONST_VTBL struct ID3D12Heap1Vtbl d3d12_heap_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_heap_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_heap_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_heap, ID3D12Heap_iface);
 }
 
@@ -1301,7 +1308,7 @@ static inline struct d3d12_resource *impl_from_ID3D12Resource2(ID3D12Resource2 *
     extern CONST_VTBL struct ID3D12Resource2Vtbl d3d12_resource_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_resource_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_resource_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_resource, ID3D12Resource_iface);
 }
 
@@ -1723,7 +1730,7 @@ static inline struct d3d12_descriptor_heap *impl_from_ID3D12DescriptorHeap(ID3D1
     extern CONST_VTBL struct ID3D12DescriptorHeapVtbl d3d12_descriptor_heap_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_descriptor_heap_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_descriptor_heap_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_descriptor_heap, ID3D12DescriptorHeap_iface);
 }
 
@@ -1916,7 +1923,7 @@ static inline struct d3d12_query_heap *impl_from_ID3D12QueryHeap(ID3D12QueryHeap
     extern CONST_VTBL struct ID3D12QueryHeapVtbl d3d12_query_heap_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_query_heap_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_query_heap_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_query_heap, ID3D12QueryHeap_iface);
 }
 
@@ -2110,7 +2117,7 @@ static inline struct d3d12_root_signature *impl_from_ID3D12RootSignature(ID3D12R
     extern CONST_VTBL struct ID3D12RootSignatureVtbl d3d12_root_signature_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_root_signature_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_root_signature_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_root_signature, ID3D12RootSignature_iface);
 }
 
@@ -2556,7 +2563,7 @@ static inline struct d3d12_pipeline_state *impl_from_ID3D12PipelineState(ID3D12P
     extern CONST_VTBL struct ID3D12PipelineStateVtbl d3d12_pipeline_state_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_pipeline_state_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_pipeline_state_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_pipeline_state, ID3D12PipelineState_iface);
 }
 
@@ -4072,7 +4079,7 @@ static inline struct d3d12_command_signature *impl_from_ID3D12CommandSignature(I
     extern CONST_VTBL struct ID3D12CommandSignatureVtbl d3d12_command_signature_vtbl;
     if (!iface)
         return NULL;
-    assert(iface->lpVtbl == &d3d12_command_signature_vtbl);
+    assert(VKD3D_VTBL_IS(iface, &d3d12_command_signature_vtbl));
     return CONTAINING_RECORD(iface, struct d3d12_command_signature, ID3D12CommandSignature_iface);
 }
 
