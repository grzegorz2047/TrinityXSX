@@ -9432,6 +9434,88 @@ static void STDMETHODCALLTYPE d3d12_command_list_Dispatch(d3d12_command_list_ifa
     d3d12_command_list_check_compute_barrier(list);
 }
 
+/* D3D12 predicates copies, but VK_EXT_conditional_rendering does not apply to transfer commands.
+ * Copy with a compute shader instead: its dispatch is predicated like any other. The app's
+ * barriers around the copy only cover the COPY stage, hence the full barriers. */
+static void d3d12_command_list_copy_buffer_predicated(struct d3d12_command_list *list,
+        VkDeviceAddress dst_va, VkDeviceAddress src_va, VkDeviceSize byte_count)
+{
+    const struct vkd3d_predicate_ops *predicate_ops = &list->device->meta_ops.predicate;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    union vkd3d_predicate_command_direct_args direct_args;
+    struct vkd3d_predicate_copy_buffer_args args;
+    struct vkd3d_scratch_allocation scratch;
+    unsigned int workgroup_count;
+    VkMemoryBarrier2 vk_barrier;
+    VkDependencyInfo dep_info;
+
+    if (!byte_count)
+        return;
+
+    memset(&vk_barrier, 0, sizeof(vk_barrier));
+    vk_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2;
+    vk_barrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    vk_barrier.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+    vk_barrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    vk_barrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT | VK_ACCESS_2_SHADER_WRITE_BIT;
+
+    memset(&dep_info, 0, sizeof(dep_info));
+    dep_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep_info.memoryBarrierCount = 1;
+    dep_info.pMemoryBarriers = &vk_barrier;
+
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dep_info));
+
+    /* The dispatch has to be inside the conditional rendering scope. */
+    d3d12_command_list_update_conditional_rendering_state(list, false);
+
+    while (byte_count)
+    {
+        /* Keeps the shader's 32-bit byte offsets in range. */
+        args.byte_count = (uint32_t)min(byte_count, (VkDeviceSize)1 << 30);
+        args.src_va = src_va & ~(VkDeviceAddress)3;
+        args.dst_va = dst_va & ~(VkDeviceAddress)3;
+        args.src_offset = src_va & 3;
+        args.dst_offset = dst_va & 3;
+
+        /* The shader loops over the words, so a capped group count covers any size. */
+        workgroup_count = min(vkd3d_compute_workgroup_count((args.dst_offset + args.byte_count + 3) / 4, 64), 4096u);
+
+        if (list->predication.fallback_enabled)
+        {
+            direct_args.dispatch.x = workgroup_count;
+            direct_args.dispatch.y = 1;
+            direct_args.dispatch.z = 1;
+
+            if (!d3d12_command_list_emit_predicated_command(list, VKD3D_PREDICATE_COMMAND_DISPATCH, 0, &direct_args, &scratch))
+                break;
+        }
+
+        VK_CALL(vkCmdBindPipeline(list->cmd.vk_command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE,
+                predicate_ops->vk_copy_buffer_pipeline));
+        d3d12_command_list_meta_push_data(list, list->cmd.vk_command_buffer,
+                predicate_ops->vk_copy_buffer_pipeline_layout,
+                VK_SHADER_STAGE_COMPUTE_BIT, sizeof(args), &args);
+
+        if (list->predication.fallback_enabled)
+            VK_CALL(vkCmdDispatchIndirect(list->cmd.vk_command_buffer, scratch.buffer, scratch.offset));
+        else
+            VK_CALL(vkCmdDispatch(list->cmd.vk_command_buffer, workgroup_count, 1, 1));
+
+        src_va += args.byte_count;
+        dst_va += args.byte_count;
+        byte_count -= args.byte_count;
+    }
+
+    vk_barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    vk_barrier.srcAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    vk_barrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    vk_barrier.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dep_info));
+
+    d3d12_command_list_invalidate_current_pipeline(list, true);
+}
+
 static void STDMETHODCALLTYPE d3d12_command_list_CopyBufferRegion(d3d12_command_list_iface *iface,
         ID3D12Resource *dst, UINT64 dst_offset, ID3D12Resource *src, UINT64 src_offset, UINT64 byte_count)
 {
@@ -9484,7 +9568,14 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyBufferRegion(d3d12_command_
 
     d3d12_command_list_mark_copy_buffer_write(list, copy_info.dstBuffer, buffer_copy.dstOffset, buffer_copy.size,
             !!(dst_resource->flags & VKD3D_RESOURCE_RESERVED));
-    VK_CALL(vkCmdCopyBuffer2(list->cmd.vk_command_buffer, &copy_info));
+
+    if (list->predication.va)
+    {
+        d3d12_command_list_copy_buffer_predicated(list, dst_resource->res.va + dst_offset,
+                src_resource->res.va + src_offset, byte_count);
+    }
+    else
+        VK_CALL(vkCmdCopyBuffer2(list->cmd.vk_command_buffer, &copy_info));
 
     VKD3D_BREADCRUMB_COMMAND(COPY);
 }
@@ -11276,7 +11367,14 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyResource(d3d12_command_list
 
         d3d12_command_list_mark_copy_buffer_write(list, copy_info.dstBuffer, vk_buffer_copy.dstOffset, vk_buffer_copy.size,
                 !!(dst_resource->flags & VKD3D_RESOURCE_RESERVED));
-        VK_CALL(vkCmdCopyBuffer2(list->cmd.vk_command_buffer, &copy_info));
+
+        if (list->predication.va)
+        {
+            d3d12_command_list_copy_buffer_predicated(list, dst_resource->res.va,
+                    src_resource->res.va, dst_resource->desc.Width);
+        }
+        else
+            VK_CALL(vkCmdCopyBuffer2(list->cmd.vk_command_buffer, &copy_info));
     }
     else
     {
