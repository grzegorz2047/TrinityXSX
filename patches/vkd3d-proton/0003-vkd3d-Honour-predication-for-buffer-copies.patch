     destroy_test_context(&context);
 }
 
+void test_conditional_rendering_copy_buffer(void)
+{
+    ID3D12GraphicsCommandList *command_list;
+    ID3D12Resource *conditions, *src, *dst;
+    struct test_context context;
+    struct resource_readback rb;
+    ID3D12CommandQueue *queue;
+    unsigned int i;
+    uint32_t value;
+
+    static const uint64_t predicate_args[] = {0, 1};
+    static const uint32_t src_data[] = {0x11111111, 0x22222222, 0x33323130, 0x44444444};
+    static const uint32_t dst_data[] = {0xdeadbeef, 0xdeadbeef, 0xdeadbeef, 0xdeadbeef};
+    static const uint32_t expected[] = {0xdeadbeef, 0x22222222, 0xdeadbeef, 0x323130ef};
+
+    if (!init_test_context(&context, NULL))
+        return;
+    command_list = context.list;
+    queue = context.queue;
+
+    if (is_intel_windows_device(context.device))
+    {
+        skip("Predicated rendering is broken on Intel.\n");
+        destroy_test_context(&context);
+        return;
+    }
+
+    conditions = create_default_buffer(context.device, sizeof(predicate_args),
+            D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
+    upload_buffer_data(conditions, 0, sizeof(predicate_args), &predicate_args, queue, command_list);
+    reset_command_list(command_list, context.allocator);
+    src = create_upload_buffer(context.device, sizeof(src_data), src_data);
+    dst = create_default_buffer(context.device, sizeof(dst_data),
+            D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
+    upload_buffer_data(dst, 0, sizeof(dst_data), &dst_data, queue, command_list);
+    reset_command_list(command_list, context.allocator);
+    transition_resource_state(command_list, conditions,
+            D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PREDICATION);
+
+    /* Skip on zero. */
+    ID3D12GraphicsCommandList_SetPredication(command_list, conditions, 0, D3D12_PREDICATION_OP_EQUAL_ZERO);
+    ID3D12GraphicsCommandList_CopyBufferRegion(command_list, dst, 0, src, 0, 4);
+    /* Copy on non-zero, also bytes 8-10 to 13-15. */
+    ID3D12GraphicsCommandList_SetPredication(command_list, conditions,
+            sizeof(uint64_t), D3D12_PREDICATION_OP_EQUAL_ZERO);
+    ID3D12GraphicsCommandList_CopyBufferRegion(command_list, dst, 4, src, 4, 4);
+    ID3D12GraphicsCommandList_CopyBufferRegion(command_list, dst, 13, src, 8, 3);
+    /* Skip on non-zero. */
+    ID3D12GraphicsCommandList_SetPredication(command_list, conditions,
+            sizeof(uint64_t), D3D12_PREDICATION_OP_NOT_EQUAL_ZERO);
+    ID3D12GraphicsCommandList_CopyBufferRegion(command_list, dst, 8, src, 8, 4);
+    ID3D12GraphicsCommandList_SetPredication(command_list, NULL, 0, 0);
+
+    transition_resource_state(command_list, dst,
+            D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    get_buffer_readback_with_command_list(dst, DXGI_FORMAT_R32_UINT, &rb, queue, command_list);
+    for (i = 0; i < ARRAY_SIZE(expected); i++)
+    {
+        value = get_readback_uint(&rb, i, 0, 0);
+        ok(value == expected[i], "Got %#x, expected %#x at %u.\n", value, expected[i], i);
+    }
+    release_resource_readback(&rb);
+
+    /* Skip a buffer CopyResource() on zero. */
+    reset_command_list(command_list, context.allocator);
+    transition_resource_state(command_list, dst,
+            D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COPY_DEST);
+    ID3D12GraphicsCommandList_SetPredication(command_list, conditions, 0, D3D12_PREDICATION_OP_EQUAL_ZERO);
+    ID3D12GraphicsCommandList_CopyResource(command_list, dst, src);
+    ID3D12GraphicsCommandList_SetPredication(command_list, NULL, 0, 0);
+    transition_resource_state(command_list, dst,
+            D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    get_buffer_readback_with_command_list(dst, DXGI_FORMAT_R32_UINT, &rb, queue, command_list);
+    for (i = 0; i < ARRAY_SIZE(expected); i++)
+    {
+        value = get_readback_uint(&rb, i, 0, 0);
+        ok(value == expected[i], "Got %#x, expected %#x at %u after CopyResource.\n", value, expected[i], i);
+    }
+    release_resource_readback(&rb);
+
+    ID3D12Resource_Release(conditions);
+    ID3D12Resource_Release(src);
+    ID3D12Resource_Release(dst);
+    destroy_test_context(&context);
+}
