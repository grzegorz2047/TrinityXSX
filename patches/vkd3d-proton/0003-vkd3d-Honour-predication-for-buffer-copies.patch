diff --git a/libs/vkd3d/shaders/cs_copy_buffer.comp b/libs/vkd3d/shaders/cs_copy_buffer.comp
new file mode 100644
index 0000000..51e0dbe
--- /dev/null
+++ b/libs/vkd3d/shaders/cs_copy_buffer.comp
@@ -0,0 +1,64 @@
+#version 450
+
+#extension GL_EXT_buffer_reference : require
+
+layout(local_size_x = 64) in;
+
+layout(std430, buffer_reference, buffer_reference_align = 4)
+readonly buffer src_data_t {
+  uint data[];
+};
+
+layout(std430, buffer_reference, buffer_reference_align = 4)
+buffer dst_data_t {
+  uint data[];
+};
+
+/* Copies byte_count bytes from byte src_offset of src to byte dst_offset of dst.
+ * src and dst are 4-byte aligned, the offsets are 0-3. */
+layout(push_constant)
+uniform u_info_t {
+  src_data_t src;
+  dst_data_t dst;
+  uint src_offset;
+  uint dst_offset;
+  uint byte_count;
+};
+
+uint load_src_byte(uint index) {
+  return bitfieldExtract(src.data[index >> 2u], int(8u * (index & 3u)), 8);
+}
+
+void main() {
+  uint dst_end = dst_offset + byte_count;
+  uint word_count = (dst_end + 3u) >> 2u;
+  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
+
+  for (uint word = gl_GlobalInvocationID.x; word < word_count; word += stride) {
+    uint begin = max(4u * word, dst_offset);
+    uint end = min(4u * word + 4u, dst_end);
+
+    if (src_offset == dst_offset && end - begin == 4u) {
+      /* Byte b of dst is byte b of src. */
+      dst.data[word] = src.data[word];
+      continue;
+    }
+
+    uint value = 0u;
+    uint mask = 0u;
+
+    for (uint b = begin; b < end; b++) {
+      uint shift = 8u * (b & 3u);
+      value |= load_src_byte(b - dst_offset + src_offset) << shift;
+      mask |= 0xffu << shift;
+    }
+
+    if (mask == ~0u) {
+      dst.data[word] = value;
+    } else {
+      /* Keep the bytes of the word outside the copy. */
+      atomicAnd(dst.data[word], ~mask);
+      atomicOr(dst.data[word], value);
+    }
+  }
+}
