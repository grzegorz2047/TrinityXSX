index 61c9afe..de8f321 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -7283,6 +7283,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_ClearState(d3d12_command_list_i
     d3d12_command_list_check_render_pass_validation(list, "ClearState called within a render pass.\n", false);
 
