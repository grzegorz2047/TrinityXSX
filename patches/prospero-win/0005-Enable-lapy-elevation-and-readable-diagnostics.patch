Subject: [PATCH] Enable bundled lapy elevation and readable diagnostics for PPSA83601

Restore one-shot pw_data_mount_request() elevation using the MIT lapy.elf
helper bundled in PPSA83601.ffpkg, catch SIGSYS in early fault reporting,
mirror fatal fault lines to startup.log, and use 0755/0644 permissions on
diagnostics logs.

diff --git a/native/pw_diagnostics.c b/native/pw_diagnostics.c
index c8a202e..ea9b743 100644
--- a/native/pw_diagnostics.c
+++ b/native/pw_diagnostics.c
@@ -251,8 +251,9 @@ int pw_diagnostics_open(const char *root, const char *build, const char *profile
     if (!root || snprintf(directory, sizeof(directory), "%s/logs", root) >= (int)sizeof(directory)) {
         disk_error = ENAMETOOLONG; goto out;
     }
-    if (mkdir(root, 0700) != 0 && errno != EEXIST) { disk_error = errno; goto out; }
-    if (mkdir(directory, 0700) != 0 && errno != EEXIST) { disk_error = errno; goto out; }
+    if (mkdir(root, 0755) != 0 && errno != EEXIST) { disk_error = errno; goto out; }
+    if (mkdir(directory, 0755) != 0 && errno != EEXIST) { disk_error = errno; goto out; }
+    (void)chmod(directory, 0755);
     snprintf(index, sizeof(index), "%s/next.txt", directory);
     counter = open(index, O_RDONLY);
     if (counter >= 0) {
@@ -263,7 +264,7 @@ int pw_diagnostics_open(const char *root, const char *build, const char *profile
     snprintf(current, sizeof(current), "%s/session-%u.log", directory, next);
     snprintf(previous, sizeof(previous), "%s/session-%u.previous.log", directory, next);
     (void)unlink(previous);
-    fd = open(current, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    fd = open(current, O_WRONLY | O_CREAT | O_TRUNC, 0644);
     if (fd < 0) { disk_error = errno; goto out; }
     /* Identity repeats on rotation so a retained tail can be identified. */
     snprintf(identity, sizeof(identity), "PW_REPORT/1 build=%s profile=%s cycle=%u pid=%ld time=%lld\n",
@@ -271,7 +272,7 @@ int pw_diagnostics_open(const char *root, const char *build, const char *profile
              (long)getpid(), (long long)time(NULL));
     bytes = strlen(identity);
     if (put_all(fd, identity, bytes) != 0) { disk_error = errno; close(fd); fd = -1; goto out; }
-    counter = open(index, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    counter = open(index, O_WRONLY | O_CREAT | O_TRUNC, 0644);
     if (counter < 0) { disk_error = errno; close(fd); fd = -1; goto out; }
     int n = snprintf(number, sizeof(number), "%u\n", (next + 1) % PW_DIAGNOSTICS_SESSIONS);
     int saved = put_all(counter, number, (size_t)n);
@@ -396,6 +397,12 @@ void pw_diagnostics_emergency(int signal, uintptr_t address, uint64_t pc,
     line[n++] = '\n';
     /* write() and send() only: no lock, no allocation, no formatting library. */
     if (fd >= 0) { ssize_t result = write(fd, line, n); (void)result; }
+#ifdef PW_WINE64_ROOT_DATA
+    {
+        int sfd = open(PW_WINE64_ROOT_DATA "/startup.log", O_WRONLY | O_CREAT | O_APPEND, 0644);
+        if (sfd >= 0) { ssize_t result = write(sfd, line, n); (void)result; close(sfd); }
+    }
+#endif
     (void)ps5log_raw(line, n);
 }
 
diff --git a/native/wine64_main.c b/native/wine64_main.c
index 5b39a82..0abcc96 100644
--- a/native/wine64_main.c
+++ b/native/wine64_main.c
@@ -36,6 +36,7 @@
 #include "../src/pw_script_input.h"
 #include "../src/pw_wine_launch.h"
 #include "../src/pw_game_menu.h"
+#include "pw_data_mount.h"
 #include "pw_audio_ps5.h"
 #include "pw_pad_ps5.h"
 #include "pw_hid_ps5.h"
@@ -382,7 +383,7 @@ static void wine_output_sink(const char *str, size_t len)
         if (str[i] == '\n' || sink_used == sizeof(sink_line) - 1) {
             sink_line[sink_used] = 0;
             PS5LOG_LOG("WINE %s", sink_line);
-            if (trinityxsx_sink_lines < 32) {
+            if (trinityxsx_sink_lines < 128) {
                 trinityxsx_sink_lines++;
                 trinityxsx_startup_text("WINE", sink_line);
             }
@@ -760,15 +761,23 @@ static void on_exit_report(void)
 
 /* ---- library ------------------------------------------------------------ */
 
-/* Load profiles from the storage exposed by the title's existing mounts. */
+/* Complete the one-shot helper exchange before loading profiles or starting
+ * Wine. A failed or incomplete request closes this process to Home. */
 static int open_library(void)
 {
-    library_root = PW_WINE64_ROOT_DATA;
-    int status = pw_wine_library_load(&library, library_root);
-    if (status != PW_OK || (single_program() && !pw_wine_library_find(&library, fixed_profile))) {
-        library_root = PW_WINE64_ROOT_SANDBOX;
-        status = pw_wine_library_load(&library, library_root);
-    }
+    PwDataMountResult mount;
+    int status;
+
+    status = pw_data_mount_request(&mount);
+    trinityxsx_startup("data-mount", status, mount.elevated_after * 100 + mount.helper_completed * 10 + mount.helper_errno);
+    if (status == 0) library_root = PW_WINE64_ROOT_DATA;
+    PS5LOG_LOG("PW_WINE64 data_mount data_before=%d elevated_before=%d helper_completed=%d "
+               "helper_errno=%d data_after=%d elevated_after=%d waited_ms=%d settled_ms=%d root=%s",
+               mount.data_before, mount.elevated_before, mount.helper_completed,
+               mount.helper_errno, mount.data_after, mount.elevated_after, mount.waited_ms,
+               mount.settled_ms, status == 0 ? library_root : "unavailable");
+    if (status != 0) return -1;
+    status = pw_wine_library_load(&library, library_root);
     catalog_count = 0;
     for (uint32_t i = 0; i < library.count; i++) {
         const PwWineLibraryEntry *entry = &library.entries[i];
@@ -974,6 +983,7 @@ static void install_early_fault_report(PwWineStart *start)
     sigaction(SIGBUS, &action, NULL);
     sigaction(SIGILL, &action, NULL);
     sigaction(SIGABRT, &action, NULL);
+    sigaction(SIGSYS, &action, NULL);
 }
 
 /* ---- PS5 bindings for the start sequence ------------------------------ */
