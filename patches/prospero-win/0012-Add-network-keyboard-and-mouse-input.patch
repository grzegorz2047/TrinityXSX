+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_NETINPUT_PS5_H
+#define PW_NETINPUT_PS5_H
+/*
+ * The network keyboard and mouse (src/pw_netinput.h) on the PS5: one
+ * non-blocking UDP socket through libSceNet (the calls ps5log already
+ * uses), drained once a tick by the title's loop.
+ */
+#include "../src/pw_netinput.h"
+#include <stddef.h>
+#include <stdint.h>
+
+enum { PW_NETINPUT_PS5_DATAGRAMS = 64 };   /* read per poll at most */
+
+typedef struct PwNetInputPs5Ops {
+    int (*open)(uint16_t port);             /* a bound non-blocking socket, or < 0 */
+    /* One datagram: its length and IPv4 source (host order), or < 0 when none is waiting. */
+    long (*receive)(int socket, void *buffer, size_t length, uint32_t *address, uint16_t *port);
+    void (*log)(const char *line);
+} PwNetInputPs5Ops;
+
+typedef struct PwNetInputPs5 {
+    PwNetInputPs5Ops ops;
+    int socket;                             /* -1 when closed */
+    PwNetInput input;
+    uint64_t links_logged, timeouts_logged, refused_logged;
+} PwNetInputPs5;
+
+/* Binds port on every address; logs the result. PW_OK when listening. */
+int pw_netinput_ps5_open(PwNetInputPs5 *net, const PwNetInputPs5Ops *ops, uint16_t port);
+/* Reads what waits, then times out a silent sender; logs a new sender, a
+ * timeout, and the first refused datagram of each kind of change. */
+void pw_netinput_ps5_poll(PwNetInputPs5 *net, uint64_t now_ns, PwNetInputPoll *poll);
+
+/* libSceNet, on the console. */
+const PwNetInputPs5Ops *pw_netinput_ps5_system_ops(void (*log)(const char *line));
+#endif
