+/* The network keyboard and mouse's (src/pw_netinput.h). */
+static void netinput_log(const char *line)
+{
+    PS5LOG_LOG("PW_WINE64 netinput %s", line);
+}
+
+/* One poll of the network keyboard and mouse into Wine, as the USB ones'
+ * are posted: while the console's keyboard is up only releases reach
+ * the game. */
+static void post_netinput(int (*post_input)(const PwWineInput *), const PwNetInputPoll *poll, int dialog,
+                          uint64_t *posted, uint64_t *refused)
+{
+    PwWineInput input;
+
+    if ((poll->dx || poll->dy) && !dialog) {
+        input = (PwWineInput){ PW_WINE_INPUT_MOUSE_MOVE, 0, poll->dx, poll->dy, 0 };
+        if (post_input(&input) == 0) (*posted)++;
+        else (*refused)++;
+    }
+    if (poll->wheel && !dialog) {
+        input = (PwWineInput){ PW_WINE_INPUT_MOUSE_WHEEL, 0, poll->wheel, 0, 0 };
+        if (post_input(&input) == 0) (*posted)++;
+        else (*refused)++;
+    }
+    for (size_t i = 0; i < poll->count; i++) {
+        if (dialog && poll->events[i].down) continue;
+        input = (PwWineInput){ poll->events[i].kind == PW_HID_EVENT_KEY ? PW_WINE_INPUT_KEY :
+                               PW_WINE_INPUT_MOUSE_BUTTON, poll->events[i].code, 0, 0,
+                               poll->events[i].down };
+        if (post_input(&input) == 0) (*posted)++;
+        else (*refused)++;
+    }
+}
+
