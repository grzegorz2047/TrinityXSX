diff --git a/src/pw_netinput.c b/src/pw_netinput.c
new file mode 100644
index 0000000..e614e04
--- /dev/null
+++ b/src/pw_netinput.c
@@ -0,0 +1,177 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_netinput.h"
+#include "../include/prospero_win.h"
+#include <string.h>
+
+static uint32_t get32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void put32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+int pw_netinput_parse(const uint8_t *bytes, size_t length, PwNetInputPacket *out)
+{
+    if (!bytes || !out) return PW_ERR_PRECONDITION;
+    if (length < PW_NETINPUT_PACKET) return PW_ERR_TRUNCATED;
+    if (memcmp(bytes, "TXIN", 4)) return PW_ERR_MALFORMED;
+    if (bytes[4] != PW_NETINPUT_VERSION) return PW_ERR_UNSUPPORTED;
+    memset(out, 0, sizeof(*out));
+    out->flags = bytes[5];
+    out->session = get32(bytes + 8);
+    out->sequence = get32(bytes + 12);
+    memcpy(out->keys, bytes + 16, sizeof(out->keys));
+    out->buttons = bytes[48] & 7u;
+    out->motion_x = get32(bytes + 52);
+    out->motion_y = get32(bytes + 56);
+    out->wheel = get32(bytes + 60);
+    return PW_OK;
+}
+
+size_t pw_netinput_write(const PwNetInputPacket *packet, uint8_t out[PW_NETINPUT_PACKET])
+{
+    memset(out, 0, PW_NETINPUT_PACKET);
+    memcpy(out, "TXIN", 4);
+    out[4] = PW_NETINPUT_VERSION;
+    out[5] = packet->flags;
+    put32(out + 8, packet->session);
+    put32(out + 12, packet->sequence);
+    memcpy(out + 16, packet->keys, sizeof(packet->keys));
+    out[48] = packet->buttons & 7u;
+    put32(out + 52, packet->motion_x);
+    put32(out + 56, packet->motion_y);
+    put32(out + 60, packet->wheel);
+    return PW_NETINPUT_PACKET;
+}
+
+int pw_netinput_private_address(uint32_t a)
+{
+    return (a >> 24) == 10 || (a >> 20) == 0xac1 || (a >> 16) == 0xc0a8 || (a >> 16) == 0xa9fe;
+}
+
+void pw_netinput_init(PwNetInput *input)
+{
+    if (input) memset(input, 0, sizeof(*input));
+}
+
+static int held(const uint8_t *keys, unsigned vk) { return keys[vk >> 3] >> (vk & 7) & 1u; }
+static void hold(uint8_t *keys, unsigned vk) { keys[vk >> 3] |= (uint8_t)(1u << (vk & 7)); }
+
+/* The keys a game sees: left and right Shift, Ctrl and Alt as the generic
+ * key, and no mouse-button keys (the buttons come on their own). */
+static void fold(const uint8_t *raw, uint8_t *out)
+{
+    static const uint8_t sided[6][2] = {
+        { 0xa0, 0x10 }, { 0xa1, 0x10 }, { 0xa2, 0x11 }, { 0xa3, 0x11 }, { 0xa4, 0x12 }, { 0xa5, 0x12 },
+    };
+
+    memcpy(out, raw, 32);
+    for (size_t i = 0; i < 6; i++) {
+        if (held(raw, sided[i][0])) hold(out, sided[i][1]);
+        out[sided[i][0] >> 3] &= (uint8_t)~(1u << (sided[i][0] & 7));
+    }
+    out[0] &= (uint8_t)~0x77u;   /* 0 none, 1 2 4 5 6 mouse buttons; 3 VK_CANCEL stays */
+    out[0xff >> 3] &= 0x7fu;     /* 0xff: no key */
+}
+
+static void put(PwNetInputPoll *poll, uint8_t kind, uint8_t down, uint16_t code)
+{
+    if (poll->count < PW_NETINPUT_EVENTS) poll->events[poll->count++] = (PwHidEvent){ kind, down, code };
+}
+
+/* From the delivered state to keys and buttons, releases first. */
+static void change(PwNetInput *input, const uint8_t *keys, uint8_t buttons, PwNetInputPoll *poll)
+{
+    for (unsigned vk = 0; vk < 256; vk++)
+        if (held(input->keys, vk) && !held(keys, vk)) put(poll, PW_HID_EVENT_KEY, 0, (uint16_t)vk);
+    for (uint16_t b = 0; b < 3; b++)
+        if ((input->buttons >> b & 1u) && !(buttons >> b & 1u)) put(poll, PW_HID_EVENT_BUTTON, 0, b);
+    for (unsigned vk = 0; vk < 256; vk++)
+        if (!held(input->keys, vk) && held(keys, vk)) put(poll, PW_HID_EVENT_KEY, 1, (uint16_t)vk);
+    for (uint16_t b = 0; b < 3; b++)
+        if (!(input->buttons >> b & 1u) && (buttons >> b & 1u)) put(poll, PW_HID_EVENT_BUTTON, 1, b);
+    memcpy(input->keys, keys, sizeof(input->keys));
+    input->buttons = buttons;
+}
+
+static void release_all(PwNetInput *input, PwNetInputPoll *poll)
+{
+    static const uint8_t none[32];
+    change(input, none, 0, poll);
+}
+
+static int32_t motion(uint32_t now, uint32_t before)
+{
+    int32_t d = (int32_t)(now - before);
+    if (d > PW_NETINPUT_MAX_MOTION) return PW_NETINPUT_MAX_MOTION;
+    if (d < -PW_NETINPUT_MAX_MOTION) return -PW_NETINPUT_MAX_MOTION;
+    return d;
+}
+
+int pw_netinput_receive(PwNetInput *input, const uint8_t *bytes, size_t length, uint32_t address,
+                        uint16_t port, uint64_t now_ns, PwNetInputPoll *poll)
+{
+    PwNetInputPacket packet;
+    uint8_t keys[32];
+    int fresh;
+
+    if (!input || !poll) return PW_ERR_PRECONDITION;
+    if (PW_NETINPUT_EVENTS - poll->count < PW_NETINPUT_PACKET_EVENTS) return PW_ERR_LIMIT;
+    if (pw_netinput_parse(bytes, length, &packet) != PW_OK || !pw_netinput_private_address(address)) {
+        input->refused++;
+        return PW_ERR_UNSUPPORTED;
+    }
+    /* A new sender: the first one, one whose sender went silent, or the
+     * same computer started again (another session or port). */
+    fresh = !input->linked || now_ns - input->last_ns >= PW_NETINPUT_TIMEOUT_NS ||
+            (address == input->address && (packet.session != input->session || port != input->port));
+    if (!fresh && (address != input->address || port != input->port)) {
+        input->refused++;
+        return PW_ERR_STATE;
+    }
+    if (fresh) {
+        release_all(input, poll);
+        input->linked = 1;
+        input->address = address;
+        input->port = port;
+        input->session = packet.session;
+        input->links++;
+    } else {
+        if ((int32_t)(packet.sequence - input->sequence) <= 0) {   /* late or repeated */
+            input->refused++;
+            return PW_ERR_STATE;
+        }
+        if (packet.flags & PW_NETINPUT_CAPTURING) {
+            poll->dx += motion(packet.motion_x, input->motion_x);
+            poll->dy += motion(packet.motion_y, input->motion_y);
+            poll->wheel += motion(packet.wheel, input->wheel);
+        }
+    }
+    input->sequence = packet.sequence;
+    input->motion_x = packet.motion_x;
+    input->motion_y = packet.motion_y;
+    input->wheel = packet.wheel;
+    input->last_ns = now_ns;
+    input->released = 0;
+    input->packets++;
+    if (packet.flags & PW_NETINPUT_CAPTURING) {
+        fold(packet.keys, keys);
+        change(input, keys, packet.buttons, poll);
+    } else {
+        release_all(input, poll);
+    }
+    return PW_OK;
+}
+
+void pw_netinput_tick(PwNetInput *input, uint64_t now_ns, PwNetInputPoll *poll)
+{
+    if (!input || !poll || !input->linked || input->released) return;
+    if (now_ns - input->last_ns < PW_NETINPUT_TIMEOUT_NS) return;
+    if (PW_NETINPUT_EVENTS - poll->count < PW_NETINPUT_PACKET_EVENTS) return;   /* next poll */
+    release_all(input, poll);
+    input->released = 1;
+    input->timeouts++;
+}
diff --git a/src/pw_netinput.h b/src/pw_netinput.h
new file mode 100644
index 0000000..84fd047
--- /dev/null
+++ b/src/pw_netinput.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_NETINPUT_H
+#define PW_NETINPUT_H
+/*
+ * A PC's keyboard and mouse over the local network, as Wine input: a
+ * sender on Windows (TrinityXSX's tools/netinput-sender) sends one UDP
+ * datagram per change and a heartbeat while it captures, and each carries
+ * its whole state, so a lost datagram is mended by the next one and
+ * nothing stays held:
+ *
+ *   offset  size  field (little-endian)
+ *        0     4  magic "TXIN"
+ *        4     1  version (1)
+ *        5     1  flags: bit 0 capturing (0: everything is released)
+ *        6     2  reserved, 0
+ *        8     4  session: random per sender start
+ *       12     4  sequence: +1 per datagram
+ *       16    32  held Windows virtual keys, bit (vk & 7) of byte vk >> 3
+ *       48     1  held mouse buttons: bit 0 left, 1 right, 2 middle
+ *       49     3  reserved, 0
+ *       52     4  mouse motion x, total since the session began (wraps)
+ *       56     4  mouse motion y, total (down positive)
+ *       60     4  wheel detents, total (up positive)
+ *
+ * Motion is sent as totals, so motion in a lost datagram still arrives
+ * with the next one. The receiver follows one sender at a time, from a
+ * private (LAN) address only; another may take over once the first has
+ * been silent for PW_NETINPUT_TIMEOUT_NS, which also releases whatever
+ * the first held. The left and right Shift, Ctrl and Alt keys become the
+ * generic ones, as the USB keyboard's do (src/pw_hid.c).
+ */
+#include "pw_hid.h"
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    PW_NETINPUT_PORT = 9396,
+    PW_NETINPUT_PACKET = 64,
+    PW_NETINPUT_VERSION = 1,
+    PW_NETINPUT_CAPTURING = 1u,
+    /* The changes one datagram can make: every key and button. */
+    PW_NETINPUT_PACKET_EVENTS = 256 + 3,
+    PW_NETINPUT_EVENTS = 2 * PW_NETINPUT_PACKET_EVENTS,
+    PW_NETINPUT_MAX_MOTION = 32767,       /* per datagram, either axis */
+};
+#define PW_NETINPUT_TIMEOUT_NS 500000000ull
+
+typedef struct PwNetInputPacket {
+    uint8_t flags;
+    uint32_t session, sequence;
+    uint8_t keys[32];
+    uint8_t buttons;
+    uint32_t motion_x, motion_y, wheel;
+} PwNetInputPacket;
+
+typedef struct PwNetInput {
+    int linked;                 /* a sender was accepted */
+    int released;               /* its timeout already released everything */
+    uint32_t address;           /* IPv4, host order */
+    uint16_t port;
+    uint32_t session, sequence;
+    uint64_t last_ns;           /* its newest accepted datagram */
+    uint8_t keys[32];           /* as delivered: folded, no mouse keys */
+    uint8_t buttons;
+    uint32_t motion_x, motion_y, wheel;
+    uint64_t packets, refused, links, timeouts;
+} PwNetInput;
+
+/* What the datagrams of one poll changed. */
+typedef struct PwNetInputPoll {
+    int32_t dx, dy, wheel;
+    size_t count;
+    PwHidEvent events[PW_NETINPUT_EVENTS];
+} PwNetInputPoll;
+
+/* Reads one datagram: PW_OK, PW_ERR_TRUNCATED (short), PW_ERR_MALFORMED
+ * (not TXIN) or PW_ERR_UNSUPPORTED (another version). */
+int pw_netinput_parse(const uint8_t *bytes, size_t length, PwNetInputPacket *out);
+/* Writes one (for the sender's tests and tools); returns PW_NETINPUT_PACKET. */
+size_t pw_netinput_write(const PwNetInputPacket *packet, uint8_t out[PW_NETINPUT_PACKET]);
+
+/* 10/8, 172.16/12, 192.168/16 and 169.254/16 (host order). */
+int pw_netinput_private_address(uint32_t address);
+
+void pw_netinput_init(PwNetInput *input);
+/* One datagram from address:port at now_ns: its changes are added to poll.
+ * PW_OK when it was accepted; PW_ERR_LIMIT when poll has no room for a
+ * whole datagram's changes (nothing is read then); otherwise it is
+ * refused and counted. */
+int pw_netinput_receive(PwNetInput *input, const uint8_t *bytes, size_t length, uint32_t address,
+                        uint16_t port, uint64_t now_ns, PwNetInputPoll *poll);
+/* Once per poll: a sender silent for PW_NETINPUT_TIMEOUT_NS has all it
+ * held released. */
+void pw_netinput_tick(PwNetInput *input, uint64_t now_ns, PwNetInputPoll *poll);
+#endif
diff --git a/tests/test_pw_netinput.c b/tests/test_pw_netinput.c
new file mode 100644
index 0000000..38a20ec
--- /dev/null
+++ b/tests/test_pw_netinput.c
@@ -0,0 +1,180 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../src/pw_netinput.h"
+#include "../include/prospero_win.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#define LAN 0xc0a80105u            /* 192.168.1.5 */
+#define LAN2 0xc0a80106u
+#define MS 1000000ull
+
+static void key(PwNetInputPacket *p, unsigned vk, int down)
+{
+    if (down) p->keys[vk >> 3] |= (uint8_t)(1u << (vk & 7));
+    else p->keys[vk >> 3] &= (uint8_t)~(1u << (vk & 7));
+}
+
+static int deliver(PwNetInput *in, const PwNetInputPacket *p, uint32_t address, uint16_t port, uint64_t now,
+                PwNetInputPoll *poll)
+{
+    uint8_t bytes[PW_NETINPUT_PACKET];
+    memset(poll, 0, sizeof(*poll));
+    pw_netinput_write(p, bytes);
+    return pw_netinput_receive(in, bytes, sizeof(bytes), address, port, now, poll);
+}
+
+static void test_parse(void)
+{
+    PwNetInputPacket p = { 0 }, q;
+    uint8_t bytes[PW_NETINPUT_PACKET];
+
+    p.flags = PW_NETINPUT_CAPTURING; p.session = 0x11223344u; p.sequence = 7; p.buttons = 5;
+    p.motion_x = (uint32_t)-3; p.motion_y = 9; p.wheel = 2;
+    key(&p, 'W', 1);
+    assert(pw_netinput_write(&p, bytes) == PW_NETINPUT_PACKET);
+    assert(!memcmp(bytes, "TXIN\x01\x01", 6) && bytes[8] == 0x44 && bytes[11] == 0x11);
+    assert(pw_netinput_parse(bytes, sizeof(bytes), &q) == PW_OK);
+    assert(q.session == p.session && q.sequence == 7 && q.buttons == 5 && q.flags == 1);
+    assert((int32_t)q.motion_x == -3 && q.motion_y == 9 && q.wheel == 2 && !memcmp(q.keys, p.keys, 32));
+    assert(pw_netinput_parse(bytes, PW_NETINPUT_PACKET - 1, &q) == PW_ERR_TRUNCATED);
+    bytes[4] = 2;
+    assert(pw_netinput_parse(bytes, sizeof(bytes), &q) == PW_ERR_UNSUPPORTED);
+    bytes[0] = 'X';
+    assert(pw_netinput_parse(bytes, sizeof(bytes), &q) == PW_ERR_MALFORMED);
+}
+
+static void test_private(void)
+{
+    assert(pw_netinput_private_address(0x0a000001u) && pw_netinput_private_address(0xac1f0001u));
+    assert(pw_netinput_private_address(0xc0a80001u) && pw_netinput_private_address(0xa9fe0101u));
+    assert(!pw_netinput_private_address(0xac200001u) && !pw_netinput_private_address(0x08080808u));
+}
+
+static void test_keys_and_motion(void)
+{
+    PwNetInput in;
+    PwNetInputPacket p = { 0 };
+    PwNetInputPoll poll;
+
+    pw_netinput_init(&in);
+    p.flags = PW_NETINPUT_CAPTURING; p.session = 1; p.sequence = 1;
+    p.motion_x = 1000; p.motion_y = 2000;              /* the first totals are the baseline */
+    key(&p, 'W', 1);
+    assert(deliver(&in, &p, LAN, 5000, 1 * MS, &poll) == PW_OK);
+    assert(poll.count == 1 && poll.events[0].kind == PW_HID_EVENT_KEY && poll.events[0].down &&
+           poll.events[0].code == 'W' && poll.dx == 0 && poll.dy == 0);
+
+    /* Motion is the difference of totals, even across a lost datagram. */
+    p.sequence = 3; p.motion_x = 1010; p.motion_y = 1995; p.wheel = (uint32_t)-1;
+    assert(deliver(&in, &p, LAN, 5000, 2 * MS, &poll) == PW_OK);
+    assert(poll.count == 0 && poll.dx == 10 && poll.dy == -5 && poll.wheel == -1);
+
+    /* Late and repeated datagrams change nothing. */
+    p.sequence = 2;
+    assert(deliver(&in, &p, LAN, 5000, 3 * MS, &poll) != PW_OK);
+    p.sequence = 3;
+    assert(deliver(&in, &p, LAN, 5000, 3 * MS, &poll) != PW_OK && poll.count == 0);
+
+    /* W released and A pressed with the left button: releases first. */
+    p.sequence = 4; key(&p, 'W', 0); key(&p, 'A', 1); p.buttons = 1;
+    assert(deliver(&in, &p, LAN, 5000, 4 * MS, &poll) == PW_OK);
+    assert(poll.count == 3);
+    assert(!poll.events[0].down && poll.events[0].code == 'W');
+    assert(poll.events[1].down && poll.events[1].code == 'A' && poll.events[1].kind == PW_HID_EVENT_KEY);
+    assert(poll.events[2].down && poll.events[2].kind == PW_HID_EVENT_BUTTON && poll.events[2].code == 0);
+
+    /* Capture off: everything released, motion ignored. */
+    p.sequence = 5; p.flags = 0; p.motion_x = 99999;
+    assert(deliver(&in, &p, LAN, 5000, 5 * MS, &poll) == PW_OK);
+    assert(poll.count == 2 && !poll.events[0].down && !poll.events[1].down && poll.dx == 0);
+}
+
+static void test_modifiers(void)
+{
+    PwNetInput in;
+    PwNetInputPacket p = { 0 };
+    PwNetInputPoll poll;
+
+    pw_netinput_init(&in);
+    p.flags = PW_NETINPUT_CAPTURING; p.session = 1; p.sequence = 1;
+    key(&p, 0xa0, 1); key(&p, 0xa1, 1); key(&p, 0x01, 1);       /* both Shifts, VK_LBUTTON */
+    assert(deliver(&in, &p, LAN, 5000, MS, &poll) == PW_OK);
+    assert(poll.count == 1 && poll.events[0].down && poll.events[0].code == 0x10);
+    p.sequence = 2; key(&p, 0xa0, 0);                             /* right Shift still held */
+    assert(deliver(&in, &p, LAN, 5000, 2 * MS, &poll) == PW_OK && poll.count == 0);
+    p.sequence = 3; key(&p, 0xa1, 0);
+    assert(deliver(&in, &p, LAN, 5000, 3 * MS, &poll) == PW_OK);
+    assert(poll.count == 1 && !poll.events[0].down && poll.events[0].code == 0x10);
+}
+
+static void test_senders_and_timeout(void)
+{
+    PwNetInput in;
+    PwNetInputPacket p = { 0 }, other = { 0 };
+    PwNetInputPoll poll;
+
+    pw_netinput_init(&in);
+    p.flags = other.flags = PW_NETINPUT_CAPTURING; p.session = 1; p.sequence = 1;
+    key(&p, 'W', 1);
+    assert(deliver(&in, &p, LAN, 5000, MS, &poll) == PW_OK);
+
+    /* Not from the LAN, or another computer while the first one talks. */
+    assert(deliver(&in, &other, 0x08080808u, 5000, 2 * MS, &poll) != PW_OK);
+    other.session = 2; other.sequence = 1; key(&other, 'S', 1);
+    assert(deliver(&in, &other, LAN2, 5000, 2 * MS, &poll) != PW_OK && poll.count == 0);
+
+    /* Silence: W is released once. */
+    memset(&poll, 0, sizeof(poll));
+    pw_netinput_tick(&in, 100 * MS, &poll);
+    assert(poll.count == 0);
+    pw_netinput_tick(&in, MS + PW_NETINPUT_TIMEOUT_NS, &poll);
+    assert(poll.count == 1 && !poll.events[0].down && poll.events[0].code == 'W' && in.timeouts == 1);
+    memset(&poll, 0, sizeof(poll));
+    pw_netinput_tick(&in, 2 * PW_NETINPUT_TIMEOUT_NS, &poll);
+    assert(poll.count == 0);
+
+    /* Then the other computer may take over. */
+    assert(deliver(&in, &other, LAN2, 5000, 2 * PW_NETINPUT_TIMEOUT_NS, &poll) == PW_OK);
+    assert(poll.count == 1 && poll.events[0].down && poll.events[0].code == 'S' && in.links == 2);
+
+    /* The same computer started again: what the old session held is
+     * released before the new one's state. */
+    p.session = 9; p.sequence = 1; memset(p.keys, 0, 32); key(&p, 'D', 1);
+    assert(deliver(&in, &p, LAN2, 6000, 2 * PW_NETINPUT_TIMEOUT_NS + MS, &poll) == PW_OK);
+    assert(poll.count == 2 && !poll.events[0].down && poll.events[0].code == 'S' &&
+           poll.events[1].down && poll.events[1].code == 'D');
+}
+
+static void test_room(void)
+{
+    PwNetInput in;
+    PwNetInputPacket p = { 0 };
+    PwNetInputPoll poll;
+    uint8_t bytes[PW_NETINPUT_PACKET];
+
+    pw_netinput_init(&in);
+    p.flags = PW_NETINPUT_CAPTURING; p.session = 1; p.sequence = 1;
+    memset(p.keys, 0xff, 32); p.buttons = 7;
+    pw_netinput_write(&p, bytes);
+    memset(&poll, 0, sizeof(poll));
+    assert(pw_netinput_receive(&in, bytes, sizeof(bytes), LAN, 1, MS, &poll) == PW_OK);
+    assert(poll.count <= PW_NETINPUT_PACKET_EVENTS);
+    poll.count = PW_NETINPUT_EVENTS - PW_NETINPUT_PACKET_EVENTS + 1;
+    p.sequence = 2;
+    pw_netinput_write(&p, bytes);
+    assert(pw_netinput_receive(&in, bytes, sizeof(bytes), LAN, 1, 2 * MS, &poll) == PW_ERR_LIMIT);
+    assert(in.sequence == 1);
+}
+
+int main(void)
+{
+    test_parse();
+    test_private();
+    test_keys_and_motion();
+    test_modifiers();
+    test_senders_and_timeout();
+    test_room();
+    puts("test_pw_netinput: ok");
+    return 0;
+}
diff --git a/tests/test_pw_netinput_ps5.c b/tests/test_pw_netinput_ps5.c
new file mode 100644
index 0000000..adf6536
--- /dev/null
+++ b/tests/test_pw_netinput_ps5.c
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../native/pw_netinput_ps5.h"
+#include "../include/prospero_win.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#define MS 1000000ull
+
+static struct { uint8_t bytes[PW_NETINPUT_PACKET]; uint32_t address; uint16_t port; } queue[200];
+static int queued, taken, open_result, opened_port;
+static char last_line[160];
+static int lines;
+
+static int fake_open(uint16_t port) { opened_port = port; return open_result; }
+
+static long fake_receive(int s, void *buffer, size_t length, uint32_t *address, uint16_t *port)
+{
+    assert(s == 7 && length >= PW_NETINPUT_PACKET);
+    if (taken == queued) return -1;
+    memcpy(buffer, queue[taken].bytes, PW_NETINPUT_PACKET);
+    *address = queue[taken].address;
+    *port = queue[taken].port;
+    taken++;
+    return PW_NETINPUT_PACKET;
+}
+
+static void fake_log(const char *line)
+{
+    snprintf(last_line, sizeof(last_line), "%s", line);
+    lines++;
+}
+
+static const PwNetInputPs5Ops ops = { fake_open, fake_receive, fake_log };
+
+static void push(uint32_t sequence, unsigned vk, int down, uint32_t mx, uint32_t address)
+{
+    PwNetInputPacket p = { 0 };
+    p.flags = PW_NETINPUT_CAPTURING; p.session = 0xabcd; p.sequence = sequence; p.motion_x = mx;
+    if (down) p.keys[vk >> 3] |= (uint8_t)(1u << (vk & 7));
+    pw_netinput_write(&p, queue[queued].bytes);
+    queue[queued].address = address;
+    queue[queued].port = 50000;
+    queued++;
+}
+
+int main(void)
+{
+    static PwNetInputPs5 net;
+    static PwNetInputPoll poll;
+
+    open_result = -1;
+    assert(pw_netinput_ps5_open(&net, &ops, PW_NETINPUT_PORT) == PW_ERR_NOT_FOUND && net.socket == -1);
+    assert(opened_port == PW_NETINPUT_PORT && strstr(last_line, "socket=-1"));
+    pw_netinput_ps5_poll(&net, MS, &poll);              /* closed: nothing, no crash */
+    assert(poll.count == 0);
+
+    open_result = 7;
+    assert(pw_netinput_ps5_open(&net, &ops, PW_NETINPUT_PORT) == PW_OK);
+
+    /* Several datagrams in one tick: the newest state, the summed motion. */
+    push(1, 'W', 1, 0, 0xc0a80105u);
+    push(2, 'W', 1, 5, 0xc0a80105u);
+    push(3, 'W', 0, 12, 0xc0a80105u);
+    push(1, 'S', 1, 0, 0x08080808u);                  /* not from the LAN */
+    lines = 0;
+    pw_netinput_ps5_poll(&net, 2 * MS, &poll);
+    assert(taken == 4 && poll.dx == 12 && poll.count == 2);
+    assert(poll.events[0].down && poll.events[0].code == 'W' && !poll.events[1].down);
+    assert(lines == 2 && strstr(last_line, "refused #1 from 8.8.8.8:50000"));
+
+    /* Many datagrams: every one is read within the per-poll limit. */
+    for (uint32_t s = 4; s < 4 + 100; s++) push(s, 'A', s & 1, 12, 0xc0a80105u);
+    pw_netinput_ps5_poll(&net, 3 * MS, &poll);
+    assert(taken == 4 + PW_NETINPUT_PS5_DATAGRAMS);
+    pw_netinput_ps5_poll(&net, 4 * MS, &poll);
+    assert(taken == queued);
+
+    /* Silence releases what is held, and says so. */
+    push(200, 'D', 1, 12, 0xc0a80105u);
+    pw_netinput_ps5_poll(&net, 5 * MS, &poll);
+    assert(poll.count >= 1);
+    pw_netinput_ps5_poll(&net, 5 * MS + PW_NETINPUT_TIMEOUT_NS, &poll);
+    assert(poll.count == 1 && !poll.events[0].down && poll.events[0].code == 'D');
+    assert(strstr(last_line, "sender silent"));
+    puts("test_pw_netinput_ps5: ok");
+    return 0;
+}
