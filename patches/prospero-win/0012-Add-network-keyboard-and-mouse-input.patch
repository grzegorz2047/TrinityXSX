diff --git a/native/pw_netinput_ps5.c b/native/pw_netinput_ps5.c
new file mode 100644
index 0000000..37d1f89
--- /dev/null
+++ b/native/pw_netinput_ps5.c
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_netinput_ps5.h"
+#include "../include/prospero_win.h"
+#include <stdio.h>
+#include <string.h>
+
+static void logf_(const PwNetInputPs5 *net, const char *line)
+{
+    if (net->ops.log) net->ops.log(line);
+}
+
+int pw_netinput_ps5_open(PwNetInputPs5 *net, const PwNetInputPs5Ops *ops, uint16_t port)
+{
+    char line[96];
+
+    if (!net || !ops || !ops->open || !ops->receive) return PW_ERR_PRECONDITION;
+    memset(net, 0, sizeof(*net));
+    net->ops = *ops;
+    pw_netinput_init(&net->input);
+    net->socket = ops->open(port);
+    snprintf(line, sizeof(line), "listen udp port=%u socket=%d", (unsigned)port, net->socket);
+    logf_(net, line);
+    if (net->socket < 0) {
+        net->socket = -1;
+        return PW_ERR_NOT_FOUND;
+    }
+    return PW_OK;
+}
+
+void pw_netinput_ps5_poll(PwNetInputPs5 *net, uint64_t now_ns, PwNetInputPoll *poll)
+{
+    PwNetInput *in;
+    char line[128];
+
+    memset(poll, 0, sizeof(*poll));
+    if (!net || net->socket < 0) return;
+    in = &net->input;
+    for (int i = 0; i < PW_NETINPUT_PS5_DATAGRAMS; i++) {
+        uint8_t bytes[2 * PW_NETINPUT_PACKET];
+        uint32_t address = 0;
+        uint16_t port = 0;
+        long got;
+
+        if (PW_NETINPUT_EVENTS - poll->count < PW_NETINPUT_PACKET_EVENTS) break;   /* the rest next tick */
+        got = net->ops.receive(net->socket, bytes, sizeof(bytes), &address, &port);
+        if (got < 0) break;
+        if (pw_netinput_receive(in, bytes, (size_t)got, address, port, now_ns, poll) != PW_OK &&
+            (in->refused & (in->refused - 1)) == 0 && in->refused != net->refused_logged) {
+            /* the 1st, 2nd, 4th, 8th... refused datagram */
+            net->refused_logged = in->refused;
+            snprintf(line, sizeof(line), "refused #%llu from %u.%u.%u.%u:%u length=%ld",
+                     (unsigned long long)in->refused, address >> 24, address >> 16 & 255,
+                     address >> 8 & 255, address & 255, (unsigned)port, got);
+            logf_(net, line);
+        }
+        if (in->links != net->links_logged) {
+            net->links_logged = in->links;
+            snprintf(line, sizeof(line), "sender %u.%u.%u.%u:%u session=%08x",
+                     in->address >> 24, in->address >> 16 & 255, in->address >> 8 & 255,
+                     in->address & 255, (unsigned)in->port, (unsigned)in->session);
+            logf_(net, line);
+        }
+    }
+    pw_netinput_tick(in, now_ns, poll);
+    if (in->timeouts != net->timeouts_logged) {
+        net->timeouts_logged = in->timeouts;
+        snprintf(line, sizeof(line), "sender silent: released everything (datagrams=%llu refused=%llu)",
+                 (unsigned long long)in->packets, (unsigned long long)in->refused);
+        logf_(net, line);
+    }
+}
+
+#ifndef PW_NETINPUT_PS5_HOST_TEST
+#include <sys/socket.h>
+#include <netinet/in.h>
+
+int sceNetSocket(const char *name, int domain, int type, int protocol);
+int sceNetSocketClose(int socket);
+int sceNetSetsockopt(int socket, int level, int option, const void *value, socklen_t length);
+int sceNetBind(int socket, const struct sockaddr *address, socklen_t length);
+int sceNetRecvfrom(int socket, void *buffer, size_t length, int flags, struct sockaddr *from,
+                   socklen_t *from_length);
+
+enum { PW_SCE_SO_NBIO = 0x1200 };   /* as ps5log_ps5_net.c */
+
+static int system_open(uint16_t port)
+{
+    struct sockaddr_in address;
+    int enabled = 1;
+    int s = sceNetSocket("pw-netinput", AF_INET, SOCK_DGRAM, 0);
+
+    if (s < 0) return s;
+    memset(&address, 0, sizeof(address));
+    address.sin_len = sizeof(address);
+    address.sin_family = AF_INET;
+    address.sin_port = (in_port_t)((port >> 8) | (port << 8 & 0xff00));   /* network order */
+    address.sin_addr.s_addr = 0;                                          /* INADDR_ANY */
+    if (sceNetSetsockopt(s, SOL_SOCKET, PW_SCE_SO_NBIO, &enabled, sizeof(enabled)) < 0 ||
+        sceNetBind(s, (const struct sockaddr *)&address, sizeof(address)) < 0) {
+        (void)sceNetSocketClose(s);
+        return -1;
+    }
+    return s;
+}
+
+static long system_receive(int s, void *buffer, size_t length, uint32_t *address, uint16_t *port)
+{
+    struct sockaddr_in from;
+    socklen_t from_length = sizeof(from);
+    int got;
+
+    memset(&from, 0, sizeof(from));
+    got = sceNetRecvfrom(s, buffer, length, 0, (struct sockaddr *)&from, &from_length);
+    if (got < 0) return -1;
+    {
+        const uint8_t *a = (const uint8_t *)&from.sin_addr.s_addr, *p = (const uint8_t *)&from.sin_port;
+        *address = (uint32_t)a[0] << 24 | (uint32_t)a[1] << 16 | (uint32_t)a[2] << 8 | a[3];
+        *port = (uint16_t)(p[0] << 8 | p[1]);
+    }
+    return got;
+}
+
+const PwNetInputPs5Ops *pw_netinput_ps5_system_ops(void (*log)(const char *line))
+{
+    static PwNetInputPs5Ops ops;
+    ops.open = system_open;
+    ops.receive = system_receive;
+    ops.log = log;
+    return &ops;
+}
+#endif
