diff --git a/wine/ps5/pw_wine_cwd_libc.c b/wine/ps5/pw_wine_cwd_libc.c
index 03c6407..0508d18 100644
--- a/wine/ps5/pw_wine_cwd_libc.c
+++ b/wine/ps5/pw_wine_cwd_libc.c
@@ -222,6 +222,28 @@ static int lstat_resolved(struct resolved *r, struct stat *st)
     return result;
 }
 
+/* A title can inspect an opened work directory even when its mount does not
+ * implement lstat. Reject the final name if it is a virtual or native link. */
+int pw_wine_stat_server_directory(const char *path, struct stat *st)
+{
+    struct resolved r;
+    ssize_t link_length;
+    int fd, result, saved;
+
+    if (resolve(&r, path, 0) || load_parent_table(&r)) return -1;
+    do {
+        if (is_link(r.full, &link_length)) { errno = ELOOP; return -1; }
+        fd = __real_open(r.full, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    } while (fd < 0 && reload(&r));
+    if (fd < 0) return -1;
+
+    result = fstat(fd, st);
+    saved = errno;
+    __real_close(fd);
+    if (result) errno = saved;
+    return result;
+}
+
 static int stat_resolved(struct resolved *r, struct stat *st)
 {
     int result;
diff --git a/wine/patches/0998-server-ps5-inspect-directories-by-descriptor.patch b/wine/patches/0998-server-ps5-inspect-directories-by-descriptor.patch
new file mode 100644
index 0000000..364adc3
--- /dev/null
+++ b/wine/patches/0998-server-ps5-inspect-directories-by-descriptor.patch
@@ -0,0 +1,39 @@
+Subject: [PATCH] server: inspect PS5 work directories by descriptor
+
+Use a directory descriptor for the two directory checks in server startup.
+Retain the existing directory creation and identity checks.
+
+--- a/server/request.c
++++ b/server/request.c
+@@ -948,17 +948,27 @@
+     if (!do_it_once++) unlink( server_socket_name );
+ }
+ 
++static int stat_server_directory( const char *name, struct stat *st )
++{
++#ifdef __PROSPERO__
++    extern int pw_wine_stat_server_directory( const char *path, struct stat *st );
++    return pw_wine_stat_server_directory( name, st );
++#else
++    return lstat( name, st );
++#endif
++}
++
+ /* create a directory and check its permissions */
+ static void create_dir( const char *name, struct stat *st )
+ {
+-    if (lstat( name, st ) == -1)
++    if (stat_server_directory( name, st ) == -1)
+     {
+         if (errno != ENOENT)
+-            fatal_error( "lstat %s: %s\n", name, strerror( errno ));
++            fatal_error( "inspect directory %s: %s\n", name, strerror( errno ));
+         if (mkdir( name, 0700 ) == -1 && errno != EEXIST)
+             fatal_error( "mkdir %s: %s\n", name, strerror( errno ));
+-        if (lstat( name, st ) == -1)
+-            fatal_error( "lstat %s: %s\n", name, strerror( errno ));
++        if (stat_server_directory( name, st ) == -1)
++            fatal_error( "inspect directory %s: %s\n", name, strerror( errno ));
+     }
+     if (!S_ISDIR(st->st_mode)) fatal_error( "%s is not a directory\n", name );
+ #ifndef __PROSPERO__  /* one user; its file systems do not keep unix owners */
