From 913b7e6883d8756462d351ef2e9ace39ba38fe81 Mon Sep 17 00:00:00 2001
From: TrinityXSX <trinityxsx@users.noreply.github.com>
Date: Thu, 26 Nov 2026 10:37:12 +0100
Subject: [PATCH] Sync bundled XCL runtime after UID 0 elevation and tune RADV
 cache

---
 native/wine64_main.c | 178 ++++++++++++++++++++++++++++++++++++++++++-
 src/pw_wine_start.h  |   2 +-
 2 files changed, 177 insertions(+), 3 deletions(-)

diff --git a/native/wine64_main.c b/native/wine64_main.c
index d356187..9a22090 100644
--- a/native/wine64_main.c
+++ b/native/wine64_main.c
@@ -50,7 +50,10 @@
 #include "pw_wine_display.h"
 #include "../include/prospero_win.h"
 
+#include <dirent.h>
+#include <errno.h>
 #include <fcntl.h>
+#include <limits.h>
 #include <pthread.h>
 #include <signal.h>
 #include <stdio.h>
@@ -759,6 +762,173 @@ static void on_exit_report(void)
     pw_diagnostics_close("wine64-exit");
 }
 
+/* ---- elevated runtime sync --------------------------------------------- */
+
+#ifndef PATH_MAX
+#define PATH_MAX 1024
+#endif
+
+static int trinityxsx_read_stamp(const char *path, char *buf, size_t cap, size_t *out_len)
+{
+    int fd = open(path, O_RDONLY | O_NOFOLLOW);
+    if (fd < 0) return -1;
+    size_t total = 0;
+    while (total < cap) {
+        ssize_t n = read(fd, buf + total, cap - total);
+        if (n == 0) break;
+        if (n < 0) {
+            if (errno == EINTR) continue;
+            close(fd);
+            return -1;
+        }
+        total += (size_t)n;
+    }
+    close(fd);
+    *out_len = total;
+    return 0;
+}
+
+static int trinityxsx_copy_file_atomic(const char *src, const char *dst)
+{
+    int in_fd = open(src, O_RDONLY | O_NOFOLLOW);
+    if (in_fd < 0) return -1;
+    char tmp[PATH_MAX];
+    int n = snprintf(tmp, sizeof(tmp), "%s.tmp", dst);
+    if (n <= 0 || (size_t)n >= sizeof(tmp)) {
+        close(in_fd);
+        errno = ENAMETOOLONG;
+        return -1;
+    }
+    (void)unlink(tmp);
+    int out_fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, 0666);
+    if (out_fd < 0) {
+        int err = errno;
+        close(in_fd);
+        errno = err;
+        return -1;
+    }
+    char buf[16384];
+    int failed = 0;
+    while (!failed) {
+        ssize_t r = read(in_fd, buf, sizeof(buf));
+        if (r == 0) break;
+        if (r < 0) {
+            if (errno == EINTR) continue;
+            failed = 1;
+            break;
+        }
+        for (ssize_t off = 0; off < r;) {
+            ssize_t w = write(out_fd, buf + off, (size_t)(r - off));
+            if (w < 0 && errno == EINTR) continue;
+            if (w <= 0) {
+                failed = 1;
+                break;
+            }
+            off += w;
+        }
+    }
+    int err = errno;
+    close(in_fd);
+    if (close(out_fd) != 0) {
+        err = errno;
+        failed = 1;
+    }
+    if (failed) {
+        (void)unlink(tmp);
+        errno = err;
+        return -1;
+    }
+    if (rename(tmp, dst) != 0) {
+        err = errno;
+        (void)unlink(tmp);
+        errno = err;
+        return -1;
+    }
+    (void)chmod(dst, 0777);
+    return 0;
+}
+
+static int trinityxsx_copy_xcl_tree(const char *src_dir, const char *dst_dir, int top_level)
+{
+    if (mkdir(dst_dir, 0777) != 0 && errno != EEXIST) return -1;
+    (void)chmod(dst_dir, 0777);
+    DIR *dir = opendir(src_dir);
+    if (!dir) return -1;
+    int rc = 0;
+    struct dirent *ent;
+    while ((ent = readdir(dir)) != NULL) {
+        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
+        if (top_level && (strcmp(ent->d_name, "runtime-stamp.txt") == 0 ||
+                          strcmp(ent->d_name, "games") == 0)) continue;
+        char from[PATH_MAX], to[PATH_MAX];
+        if (snprintf(from, sizeof(from), "%s/%s", src_dir, ent->d_name) >= (int)sizeof(from) ||
+            snprintf(to, sizeof(to), "%s/%s", dst_dir, ent->d_name) >= (int)sizeof(to)) {
+            errno = ENAMETOOLONG;
+            rc = -1;
+            break;
+        }
+        struct stat st;
+        if (lstat(from, &st) != 0) {
+            rc = -1;
+            break;
+        }
+        if (S_ISDIR(st.st_mode)) {
+            if (trinityxsx_copy_xcl_tree(from, to, 0) != 0) {
+                rc = -1;
+                break;
+            }
+        } else if (S_ISREG(st.st_mode)) {
+            if (trinityxsx_copy_file_atomic(from, to) != 0) {
+                rc = -1;
+                break;
+            }
+        }
+    }
+    int err = errno;
+    closedir(dir);
+    errno = err;
+    return rc;
+}
+
+/* Refresh prefix/drive_c/XCL runtime binaries after Lapy elevates this process
+ * to UID 0, so files owned by UID 0 (e.g. FTP or prior ProsperoStore installs)
+ * update cleanly without EPERM while preserving saves, profiles, and games. */
+static void trinityxsx_sync_runtime_elevated(const char *root)
+{
+    const char *seed_xcl = "/app0/data-seed/prefix/drive_c/XCL";
+    char seed_stamp[PATH_MAX], dst_prefix[PATH_MAX], dst_drive_c[PATH_MAX];
+    char dst_xcl[PATH_MAX], dst_stamp[PATH_MAX];
+    if (snprintf(seed_stamp, sizeof(seed_stamp), "%s/runtime-stamp.txt", seed_xcl) >= (int)sizeof(seed_stamp) ||
+        snprintf(dst_prefix, sizeof(dst_prefix), "%s/prefix", root) >= (int)sizeof(dst_prefix) ||
+        snprintf(dst_drive_c, sizeof(dst_drive_c), "%s/prefix/drive_c", root) >= (int)sizeof(dst_drive_c) ||
+        snprintf(dst_xcl, sizeof(dst_xcl), "%s/prefix/drive_c/XCL", root) >= (int)sizeof(dst_xcl) ||
+        snprintf(dst_stamp, sizeof(dst_stamp), "%s/runtime-stamp.txt", dst_xcl) >= (int)sizeof(dst_stamp)) {
+        return;
+    }
+    char a[128], b[128];
+    size_t la = 0, lb = 0;
+    if (trinityxsx_read_stamp(seed_stamp, a, sizeof(a), &la) != 0 || la == 0) return;
+    if (trinityxsx_read_stamp(dst_stamp, b, sizeof(b), &lb) == 0 && lb == la && memcmp(a, b, la) == 0) {
+        return; /* already current */
+    }
+    (void)mkdir(dst_prefix, 0777);
+    (void)mkdir(dst_drive_c, 0777);
+    if (trinityxsx_copy_xcl_tree(seed_xcl, dst_xcl, 1) != 0) {
+        int err = errno;
+        trinityxsx_startup("runtime-sync-elevated", 1, err);
+        PS5LOG_LOG("PW_WINE64 runtime_sync status=copy-failed errno=%d uid=%ld", err, (long)getuid());
+        return;
+    }
+    if (trinityxsx_copy_file_atomic(seed_stamp, dst_stamp) != 0) {
+        int err = errno;
+        trinityxsx_startup("runtime-sync-elevated", 2, err);
+        PS5LOG_LOG("PW_WINE64 runtime_sync status=stamp-failed errno=%d uid=%ld", err, (long)getuid());
+        return;
+    }
+    trinityxsx_startup("runtime-updated-elevated", 0, (int)getuid());
+    PS5LOG_LOG("PW_WINE64 runtime_sync status=updated uid=%ld", (long)getuid());
+}
+
 /* ---- library ------------------------------------------------------------ */
 
 /* Complete the one-shot helper exchange before loading profiles or starting
@@ -777,6 +947,7 @@ static int open_library(void)
                mount.helper_errno, mount.data_after, mount.elevated_after, mount.waited_ms,
                mount.settled_ms, status == 0 ? library_root : "unavailable");
     if (status != 0) return -1;
+    trinityxsx_sync_runtime_elevated(library_root);
     status = pw_wine_library_load(&library, library_root);
     catalog_count = 0;
     for (uint32_t i = 0; i < library.count; i++) {
@@ -1028,7 +1199,7 @@ int main(int argc, char **argv)
 {
     static char prefix[PW_WINE_LIBRARY_PATH + PW_APP_ID_CAPACITY], desktop[24], view[8] = "window";
     static char radv_cache[PW_WINE_LIBRARY_PATH + 16];
-    enum { WINE64_FIXED_ENV_COUNT = 7,
+    enum { WINE64_FIXED_ENV_COUNT = 9,
            WINE64_PROFILE_ENV_CAPACITY = 3 + PW_GAME_GRAPHICS_ENV_MAX + PW_GAME_RUNTIME_ENV_MAX + PW_GAME_CPU_ENV_MAX +
                                          PW_GAME_CLOCK_ENV_MAX + PW_GAME_DEBUG_ENV_MAX };
     static PwWineStartEnv extra[WINE64_FIXED_ENV_COUNT + WINE64_PROFILE_ENV_CAPACITY] = {
@@ -1045,8 +1216,11 @@ int main(int argc, char **argv)
          * every launch compiled every pipeline again (2 s of compiles in
          * the first 100 s of GTA San Andreas, in 25-50 ms frames). The
          * driver keeps the first value, so this must be set before it
-         * starts; a profile's [debug] env line still overrides it. */
+         * starts; raise max size to 4 GiB so large Xbox Series titles do
+         * not evict compiled pipelines. */
         { "MESA_SHADER_CACHE_DIR", radv_cache },
+        { "MESA_SHADER_CACHE_DISABLE", "false" },
+        { "MESA_SHADER_CACHE_MAX_SIZE", "4G" },
         { NULL, NULL }, { NULL, NULL }, { NULL, NULL }, { NULL, NULL }, /* profile-specific environment */
     };
     _Static_assert(sizeof(extra) / sizeof(extra[0]) ==
diff --git a/src/pw_wine_start.h b/src/pw_wine_start.h
index f09d980..3ffe2a1 100644
--- a/src/pw_wine_start.h
+++ b/src/pw_wine_start.h
@@ -18,7 +18,7 @@
 #include "pw_wine_launch.h"
 
 enum {
-    PW_WINE_START_MAX_ENV = 25,
+    PW_WINE_START_MAX_ENV = 28,
     /* wine, the executable and every word a profile's arguments may split into */
     PW_WINE_START_MAX_ARGS = 2 + PW_WINE_LAUNCH_WORDS,
     /* Stages, reported so a failed start names where it stopped. */
