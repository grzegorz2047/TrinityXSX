         APP "[input]\ncross space\n",
         APP "[input]\n = space\n",
@@ -385,9 +387,16 @@ static void test_presets(void)
     assert(!strcmp(p.input.preset, "bomb") && !strcmp(p.input.player2, "bomb-p2"));
     assert(parse(APP "[input]\npreset = bomb\n", &p) == PW_OK && !p.input.player2[0]);
 
+    /* A PC's keyboard and mouse: off unless the profile says otherwise. */
+    assert(parse(APP "[input]\nmode = xinput\n", &p) == PW_OK && p.input.remote == PW_GAME_REMOTE_OFF);
+    assert(parse(APP "[input]\nremote = sender\n", &p) == PW_OK && p.input.remote == PW_GAME_REMOTE_SENDER);
+    assert(parse(APP "[input]\nremote = browser\n", &p) == PW_OK && p.input.remote == PW_GAME_REMOTE_BROWSER);
+    assert(parse(APP "[input]\nremote = off\n", &p) == PW_OK && p.input.remote == PW_GAME_REMOTE_OFF);
+
     /* A preset holds only [input] and cannot chain another preset. */
     assert(preset("[input]\npreset = other\n", &input) == PW_ERR_MALFORMED);
     assert(preset("[input]\nplayer2 = other\n", &input) == PW_ERR_MALFORMED);
+    assert(preset("[input]\nremote = browser\n", &input) == PW_ERR_MALFORMED);
     assert(preset("[display]\ndesktop = 800x600\n", &input) == PW_ERR_MALFORMED);
     assert(preset(APP, &input) == PW_ERR_MALFORMED);
     assert(preset("; nothing\n", &input) == PW_ERR_MALFORMED);
