diff --git a/tests/test_pw_webinput.c b/tests/test_pw_webinput.c
new file mode 100644
index 0000000..7399ac2
--- /dev/null
+++ b/tests/test_pw_webinput.c
@@ -0,0 +1,300 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../src/pw_webinput.h"
+#include "../include/prospero_win.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#define MS 1000000ull
+#define LAN 0xc0a801cfu            /* 192.168.1.207 */
+
+/* Fake sockets: what the client sent (in), what the server sent (out). */
+typedef struct Fake {
+    int used, closed;
+    uint8_t in[8192];
+    size_t in_used, in_read;
+    char out[65536];
+    size_t out_used;
+} Fake;
+static Fake fakes[32];
+static int pending[8], pending_count;
+static uint32_t pending_address[8];
+static size_t send_limit = 100000;
+static int closes;
+
+static int fake_accept(int listener, uint32_t *address)
+{
+    assert(listener == 99);
+    if (!pending_count) return -1;
+    *address = pending_address[0];
+    int s = pending[0];
+    memmove(pending, pending + 1, sizeof(pending[0]) * (size_t)(pending_count - 1));
+    memmove(pending_address, pending_address + 1, sizeof(pending_address[0]) * (size_t)(pending_count - 1));
+    pending_count--;
+    return s;
+}
+
+static long fake_receive(int s, void *buffer, size_t length)
+{
+    Fake *f = &fakes[s];
+    size_t n = f->in_used - f->in_read;
+    if (f->closed == 2) return 0;          /* the peer hung up */
+    if (!n) return -1;
+    if (n > length) n = length;
+    memcpy(buffer, f->in + f->in_read, n);
+    f->in_read += n;
+    return (long)n;
+}
+
+static long fake_send(int s, const void *buffer, size_t length)
+{
+    Fake *f = &fakes[s];
+    size_t n = length < send_limit ? length : send_limit;
+    if (n > sizeof(f->out) - f->out_used) n = sizeof(f->out) - f->out_used;
+    memcpy(f->out + f->out_used, buffer, n);
+    f->out_used += n;
+    return (long)n;
+}
+
+static void fake_close(int s)
+{
+    if (s != 99) fakes[s].closed = 1;
+    closes++;
+}
+
+static char last_log[160];
+static void fake_log(const char *line) { snprintf(last_log, sizeof(last_log), "%s", line); }
+
+static const PwWebInputOps ops = { fake_accept, fake_receive, fake_send, fake_close, fake_log };
+
+static int connect_client(uint32_t address, const char *request)
+{
+    static int next = 1;
+    int s = next++;
+    memset(&fakes[s], 0, sizeof(fakes[s]));
+    fakes[s].used = 1;
+    memcpy(fakes[s].in, request, strlen(request));
+    fakes[s].in_used = strlen(request);
+    pending[pending_count] = s;
+    pending_address[pending_count++] = address;
+    return s;
+}
+
+static void client_text(int s, const char *text)
+{
+    Fake *f = &fakes[s];
+    const uint8_t mask[4] = { 0x11, 0x22, 0x33, 0x44 };
+    size_t n = strlen(text);
+    f->in[f->in_used++] = 0x81;
+    f->in[f->in_used++] = (uint8_t)(0x80 | n);
+    memcpy(f->in + f->in_used, mask, 4);
+    f->in_used += 4;
+    for (size_t i = 0; i < n; i++) f->in[f->in_used++] = (uint8_t)(text[i] ^ mask[i & 3]);
+}
+
+static const char *ws_request(const char *pin, const char *host, const char *origin)
+{
+    static char r[512];
+    snprintf(r, sizeof(r),
+             "GET /ws?pin=%s HTTP/1.1\r\nHost: %s\r\nOrigin: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
+             "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n",
+             pin, host, origin);
+    return r;
+}
+
+static int has_event(const PwNetInputPoll *p, uint8_t kind, uint16_t code, uint8_t down)
+{
+    for (size_t i = 0; i < p->count; i++)
+        if (p->events[i].kind == kind && p->events[i].code == code && p->events[i].down == down) return 1;
+    return 0;
+}
+
+static void test_crypto(void)
+{
+    uint8_t d[20];
+    char b[64], accept[29];
+    pw_webinput_sha1((const uint8_t *)"abc", 3, d);
+    pw_webinput_base64(d, 20, b, sizeof(b));
+    assert(!strcmp(b, "qZk+NkcGgWq6PiVxeFDCbJzQ2J0="));
+    /* 56 bytes: the padding spills into a second block. */
+    pw_webinput_sha1((const uint8_t *)"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", 56, d);
+    pw_webinput_base64(d, 20, b, sizeof(b));
+    assert(!strcmp(b, "hJg+RBw70m66rkqh+VEp5eVGcPE="));
+    pw_webinput_base64((const uint8_t *)"fo", 2, b, sizeof(b));
+    assert(!strcmp(b, "Zm8="));
+    pw_webinput_accept_key("dGhlIHNhbXBsZSBub25jZQ==", 24, accept);
+    assert(!strcmp(accept, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="));   /* RFC 6455, section 1.3 */
+}
+
+static void test_page_and_refusals(void)
+{
+    static PwWebInput web;
+    static PwNetInputPoll poll;
+    int s;
+
+    assert(pw_webinput_open(&web, &ops, 99, "12a4") == PW_ERR_PRECONDITION);
+    assert(pw_webinput_open(&web, &ops, 99, "123") == PW_ERR_PRECONDITION);
+    assert(pw_webinput_open(&web, &ops, 99, "4821") == PW_OK);
+
+    /* The page, in pieces when the socket takes little at a time, then closed. */
+    send_limit = 1000;
+    s = connect_client(LAN, "GET /?pin=4821 HTTP/1.1\r\nHost: 192.168.1.170:8361\r\n\r\n");
+    for (int i = 0; i < 40 && !fakes[s].closed; i++) { memset(&poll, 0, sizeof(poll)); pw_webinput_poll(&web, MS, &poll); }
+    send_limit = 100000;
+    assert(fakes[s].closed && strstr(fakes[s].out, "HTTP/1.1 200 OK"));
+    assert(fakes[s].out_used > pw_webinput_page_length && strstr(fakes[s].out, "<!doctype html>"));
+    assert(!memcmp(fakes[s].out + fakes[s].out_used - pw_webinput_page_length, pw_webinput_page,
+                   pw_webinput_page_length));
+
+    /* Not from the LAN: closed unanswered. */
+    s = connect_client(0x08080808u, "GET / HTTP/1.1\r\n\r\n");
+    pw_webinput_poll(&web, MS, &poll);
+    assert(fakes[s].closed && !fakes[s].out_used);
+
+    /* Unknown paths and methods. */
+    s = connect_client(LAN, "GET /etc HTTP/1.1\r\n\r\n");
+    pw_webinput_poll(&web, MS, &poll);
+    assert(fakes[s].closed && strstr(fakes[s].out, "404"));
+    s = connect_client(LAN, "POST / HTTP/1.1\r\n\r\n");
+    pw_webinput_poll(&web, MS, &poll);
+    assert(fakes[s].closed && strstr(fakes[s].out, "405"));
+
+    /* The WebSocket: a name as Host (DNS rebinding), a foreign Origin. */
+    s = connect_client(LAN, ws_request("4821", "evil.example:8361", "http://evil.example:8361"));
+    pw_webinput_poll(&web, MS, &poll);
+    assert(strstr(fakes[s].out, "403") && web.controller < 0);
+    s = connect_client(LAN, ws_request("4821", "192.168.1.170:8361", "http://evil.example"));
+    pw_webinput_poll(&web, MS, &poll);
+    assert(strstr(fakes[s].out, "403") && web.controller < 0);
+
+    /* Wrong PINs, then a lockout that even the right PIN waits out. */
+    for (int i = 0; i < PW_WEBINPUT_PIN_FREE; i++) {
+        s = connect_client(LAN, ws_request("0000", "192.168.1.170:8361", "http://192.168.1.170:8361"));
+        pw_webinput_poll(&web, 2 * MS, &poll);
+        assert(strstr(fakes[s].out, "403"));
+    }
+    assert(strstr(last_log, "wrong PIN"));
+    s = connect_client(LAN, ws_request("4821", "192.168.1.170:8361", "http://192.168.1.170:8361"));
+    pw_webinput_poll(&web, 3 * MS, &poll);
+    assert(strstr(fakes[s].out, "429") && web.controller < 0);
+    s = connect_client(LAN, ws_request("4821", "192.168.1.170:8361", "http://192.168.1.170:8361"));
+    pw_webinput_poll(&web, 3 * MS + PW_WEBINPUT_LOCKOUT_NS, &poll);
+    assert(strstr(fakes[s].out, "101 Switching Protocols") && web.controller >= 0);
+    assert(strstr(fakes[s].out, "Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo="));
+    assert(strstr(fakes[s].out, "target 192.168.1.170:8361"));
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_close(&web, &poll);
+    assert(fakes[s].closed);
+}
+
+static void test_input(void)
+{
+    static PwWebInput web;
+    static PwNetInputPoll poll;
+    const char *ok = ws_request("4821", "192.168.1.170:8361", "http://192.168.1.170:8361");
+    uint64_t t = 10 * MS;
+    int a, b;
+
+    assert(pw_webinput_open(&web, &ops, 99, "4821") == PW_OK);
+    a = connect_client(LAN, ok);
+    pw_webinput_poll(&web, t, &poll);
+    assert(web.controller >= 0);
+
+    /* Input before "on" is dropped. */
+    client_text(a, "k 87 1");
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += MS, &poll);
+    assert(poll.count == 0);
+
+    client_text(a, "on");
+    client_text(a, "k 160 1");       /* left Shift: the generic key */
+    client_text(a, "k 87 1");
+    client_text(a, "b 0 1");
+    client_text(a, "m 5 -3");
+    client_text(a, "m 1 1");
+    client_text(a, "w 2");
+    client_text(a, "k 999 1");       /* not a key: ignored */
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += MS, &poll);
+    assert(web.capturing && poll.count == 3);
+    assert(has_event(&poll, PW_HID_EVENT_KEY, 0x10, 1) && has_event(&poll, PW_HID_EVENT_KEY, 'W', 1));
+    assert(has_event(&poll, PW_HID_EVENT_BUTTON, 0, 1));
+    assert(poll.dx == 6 && poll.dy == -2 && poll.wheel == 2);
+
+    /* Ping gets a pong; heartbeats keep a capturing page alive. */
+    {
+        Fake *f = &fakes[a];
+        size_t before = f->out_used;
+        f->in[f->in_used++] = 0x89; f->in[f->in_used++] = 0x80;
+        f->in[f->in_used++] = 1; f->in[f->in_used++] = 2; f->in[f->in_used++] = 3; f->in[f->in_used++] = 4;
+        memset(&poll, 0, sizeof(poll));
+        pw_webinput_poll(&web, t += MS, &poll);
+        assert(f->out_used == before + 2 && (uint8_t)f->out[before] == 0x8a);
+    }
+    for (int i = 0; i < 4; i++) {
+        client_text(a, "h");
+        memset(&poll, 0, sizeof(poll));
+        pw_webinput_poll(&web, t += PW_WEBINPUT_IDLE_NS / 2, &poll);
+        assert(web.capturing && poll.count == 0);
+    }
+
+    /* "off" releases everything. */
+    client_text(a, "off");
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += MS, &poll);
+    assert(!web.capturing && poll.count == 3);
+    assert(has_event(&poll, PW_HID_EVENT_KEY, 0x10, 0) && has_event(&poll, PW_HID_EVENT_KEY, 'W', 0));
+    assert(has_event(&poll, PW_HID_EVENT_BUTTON, 0, 0));
+
+    /* A silent capturing page is released. */
+    client_text(a, "on");
+    client_text(a, "k 65 1");
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += MS, &poll);
+    assert(has_event(&poll, PW_HID_EVENT_KEY, 'A', 1));
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += PW_WEBINPUT_IDLE_NS + MS, &poll);
+    assert(!web.capturing && has_event(&poll, PW_HID_EVENT_KEY, 'A', 0) && strstr(last_log, "silent"));
+
+    /* Another page takes over: the first is closed and what it held is released. */
+    client_text(a, "on");
+    client_text(a, "k 68 1");
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += MS, &poll);
+    b = connect_client(LAN, ok);
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += MS, &poll);
+    assert(fakes[a].closed && !fakes[b].closed && has_event(&poll, PW_HID_EVENT_KEY, 'D', 0));
+    assert(web.controller >= 0 && web.clients[web.controller].socket == b);
+
+    /* The page goes away (TCP closed): released too. */
+    client_text(b, "on");
+    client_text(b, "b 1 1");
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += MS, &poll);
+    assert(has_event(&poll, PW_HID_EVENT_BUTTON, 1, 1));
+    fakes[b].closed = 2;
+    memset(&poll, 0, sizeof(poll));
+    pw_webinput_poll(&web, t += MS, &poll);
+    assert(web.controller < 0 && has_event(&poll, PW_HID_EVENT_BUTTON, 1, 0));
+
+    /* An unmasked frame ends the connection. */
+    a = connect_client(LAN, ok);
+    pw_webinput_poll(&web, t += MS, &poll);
+    fakes[a].in[fakes[a].in_used++] = 0x81;
+    fakes[a].in[fakes[a].in_used++] = 0x02;
+    fakes[a].in[fakes[a].in_used++] = 'o';
+    fakes[a].in[fakes[a].in_used++] = 'n';
+    pw_webinput_poll(&web, t += MS, &poll);
+    assert(fakes[a].closed && web.controller < 0);
+    pw_webinput_close(&web, &poll);
+}
+
+int main(void)
+{
+    test_crypto();
+    test_page_and_refusals();
+    test_input();
+    puts("test_pw_webinput: ok");
+    return 0;
+}
