diff --git a/src/pw_webinput.c b/src/pw_webinput.c
new file mode 100644
index 0000000..8ff9868
--- /dev/null
+++ b/src/pw_webinput.c
@@ -0,0 +1,499 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_webinput.h"
+#include "../include/prospero_win.h"
+#include <stdio.h>
+#include <string.h>
+
+static uint32_t rol(uint32_t v, unsigned n) { return v << n | v >> (32 - n); }
+
+void pw_webinput_sha1(const uint8_t *data, size_t length, uint8_t out[20])
+{
+    uint32_t h[5] = { 0x67452301u, 0xefcdab89u, 0x98badcfeu, 0x10325476u, 0xc3d2e1f0u };
+    uint64_t bits = (uint64_t)length * 8u;
+    size_t total = (length + 9 + 63) / 64 * 64;
+
+    for (size_t at = 0; at < total; at += 64) {
+        uint32_t w[80], a, b, c, d, e;
+        uint8_t block[64];
+        for (size_t i = 0; i < 64; i++) {
+            size_t k = at + i;
+            block[i] = k < length ? data[k] : k == length ? 0x80 : 0;
+            if (k >= total - 8) block[i] = (uint8_t)(bits >> (8 * (total - 1 - k)));
+        }
+        for (int i = 0; i < 16; i++)
+            w[i] = (uint32_t)block[4 * i] << 24 | (uint32_t)block[4 * i + 1] << 16 |
+                   (uint32_t)block[4 * i + 2] << 8 | block[4 * i + 3];
+        for (int i = 16; i < 80; i++) w[i] = rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+        a = h[0]; b = h[1]; c = h[2]; d = h[3]; e = h[4];
+        for (int i = 0; i < 80; i++) {
+            uint32_t f, k, t;
+            if (i < 20) { f = (b & c) | (~b & d); k = 0x5a827999u; }
+            else if (i < 40) { f = b ^ c ^ d; k = 0x6ed9eba1u; }
+            else if (i < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8f1bbcdcu; }
+            else { f = b ^ c ^ d; k = 0xca62c1d6u; }
+            t = rol(a, 5) + f + e + k + w[i];
+            e = d; d = c; c = rol(b, 30); b = a; a = t;
+        }
+        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;
+    }
+    for (int i = 0; i < 5; i++) {
+        out[4 * i] = (uint8_t)(h[i] >> 24); out[4 * i + 1] = (uint8_t)(h[i] >> 16);
+        out[4 * i + 2] = (uint8_t)(h[i] >> 8); out[4 * i + 3] = (uint8_t)h[i];
+    }
+}
+
+size_t pw_webinput_base64(const uint8_t *data, size_t length, char *out, size_t capacity)
+{
+    static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    size_t used = 0;
+
+    if (capacity < (length + 2) / 3 * 4 + 1) return 0;
+    for (size_t i = 0; i < length; i += 3) {
+        uint32_t n = (uint32_t)data[i] << 16 | (i + 1 < length ? (uint32_t)data[i + 1] << 8 : 0) |
+                     (i + 2 < length ? data[i + 2] : 0);
+        out[used++] = alphabet[n >> 18 & 63];
+        out[used++] = alphabet[n >> 12 & 63];
+        out[used++] = i + 1 < length ? alphabet[n >> 6 & 63] : '=';
+        out[used++] = i + 2 < length ? alphabet[n & 63] : '=';
+    }
+    out[used] = 0;
+    return used;
+}
+
+void pw_webinput_accept_key(const char *key, size_t key_length, char out[29])
+{
+    static const char guid[] = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
+    uint8_t joined[128], digest[20];
+
+    if (key_length > sizeof(joined) - (sizeof(guid) - 1)) key_length = sizeof(joined) - (sizeof(guid) - 1);
+    memcpy(joined, key, key_length);
+    memcpy(joined + key_length, guid, sizeof(guid) - 1);
+    pw_webinput_sha1(joined, key_length + sizeof(guid) - 1, digest);
+    pw_webinput_base64(digest, sizeof(digest), out, 29);
+}
+
+static void logf_(const PwWebInput *web, const char *line)
+{
+    if (web->ops.log) web->ops.log(line);
+}
+
+static void address_text(uint32_t a, char out[16])
+{
+    snprintf(out, 16, "%u.%u.%u.%u", a >> 24, a >> 16 & 255, a >> 8 & 255, a & 255);
+}
+
+int pw_webinput_open(PwWebInput *web, const PwWebInputOps *ops, int listener, const char *pin)
+{
+    size_t n = pin ? strlen(pin) : 0;
+
+    if (!web || !ops || !ops->accept || !ops->receive || !ops->send || !ops->close || listener < 0 ||
+        n < 4 || n >= sizeof(web->pin))
+        return PW_ERR_PRECONDITION;
+    for (size_t i = 0; i < n; i++)
+        if (pin[i] < '0' || pin[i] > '9') return PW_ERR_PRECONDITION;
+    memset(web, 0, sizeof(*web));
+    web->ops = *ops;
+    web->listener = listener;
+    memcpy(web->pin, pin, n + 1);
+    web->controller = -1;
+    pw_netinput_init(&web->delivered);
+    for (int i = 0; i < PW_WEBINPUT_CLIENTS; i++) web->clients[i].socket = -1;
+    return PW_OK;
+}
+
+/* Nothing held, nothing captured; the game is told what was released. */
+static void release(PwWebInput *web, PwNetInputPoll *poll)
+{
+    web->capturing = 0;
+    memset(web->keys, 0, sizeof(web->keys));
+    web->buttons = 0;
+    pw_netinput_release(&web->delivered, poll);
+}
+
+static void drop(PwWebInput *web, int index, PwNetInputPoll *poll)
+{
+    PwWebInputClient *c = &web->clients[index];
+
+    if (c->socket < 0) return;
+    web->ops.close(c->socket);
+    if (index == web->controller) {
+        web->controller = -1;
+        if (web->capturing) logf_(web, "page gone: capture stopped");
+        release(web, poll);
+    }
+    memset(c, 0, sizeof(*c));
+    c->socket = -1;
+}
+
+/* Queues bytes to send; returns 0 when they do not fit. */
+static int queue(PwWebInputClient *c, const void *bytes, size_t length)
+{
+    if (c->head_sent == c->head_used) c->head_sent = c->head_used = 0;
+    if (length > sizeof(c->head) - c->head_used) return 0;
+    memcpy(c->head + c->head_used, bytes, length);
+    c->head_used += length;
+    return 1;
+}
+
+static void frame(PwWebInputClient *c, uint8_t opcode, const char *payload, size_t length)
+{
+    uint8_t bytes[2 + 125];
+
+    if (length > 125) return;
+    bytes[0] = (uint8_t)(0x80u | opcode);
+    bytes[1] = (uint8_t)length;
+    memcpy(bytes + 2, payload, length);
+    (void)queue(c, bytes, 2 + length);
+}
+
+static void respond(PwWebInputClient *c, const char *status, const char *type, const char *body,
+                    size_t length)
+{
+    char head[sizeof(c->head)];
+    int n = snprintf(head, sizeof(head),
+                     "HTTP/1.1 %s\r\nContent-Type: %s\r\nContent-Length: %lu\r\nCache-Control: no-store\r\n"
+                     "X-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\nReferrer-Policy: no-referrer\r\n"
+                     "Connection: close\r\n\r\n", status, type, (unsigned long)length);
+    if (n > 0 && (size_t)n < sizeof(head)) (void)queue(c, head, (size_t)n);
+    c->body = body;
+    c->body_used = length;
+    c->body_sent = 0;
+    c->close_after = 1;
+}
+
+static void plain(PwWebInputClient *c, const char *status)
+{
+    respond(c, status, "text/plain; charset=utf-8", status, strlen(status));
+}
+
+/* A header's value from a request head, or NULL. */
+static const char *header(const char *head, const char *name, size_t *length)
+{
+    size_t n = strlen(name);
+    for (const char *line = strstr(head, "\r\n"); line && line[2]; line = strstr(line + 2, "\r\n")) {
+        const char *p = line + 2, *end = strstr(p, "\r\n");
+        size_t i = 0;
+        if (!end || end == p) return NULL;   /* the blank line ends the head */
+        while (i < n && p + i < end) {
+            char a = p[i], b = name[i];
+            if (a >= 'A' && a <= 'Z') a = (char)(a - 'A' + 'a');
+            if (a != b) break;
+            i++;
+        }
+        if (i == n && p[n] == ':') {
+            const char *v = p + n + 1;
+            while (v < end && (*v == ' ' || *v == '\t')) v++;
+            *length = (size_t)(end - v);
+            while (*length && (v[*length - 1] == ' ' || v[*length - 1] == '\t')) (*length)--;
+            return v;
+        }
+    }
+    return NULL;
+}
+
+/* An IPv4 literal, with or without a port: a page reached by name could be
+ * someone else's (DNS rebinding). */
+static int ipv4_host(const char *v, size_t n)
+{
+    int dots = 0, digits = 0, colon = 0;
+    if (!v || !n) return 0;
+    for (size_t i = 0; i < n; i++) {
+        if (v[i] >= '0' && v[i] <= '9') digits++;
+        else if (v[i] == '.' && !colon) { if (!digits) return 0; dots++; digits = 0; }
+        else if (v[i] == ':' && !colon && dots == 3 && digits) { colon = 1; digits = 0; }
+        else return 0;
+    }
+    return dots == 3 && digits;
+}
+
+static int pin_ok(const PwWebInput *web, const char *target)
+{
+    const char *q = strchr(target, '?');
+    size_t n = strlen(web->pin);
+    while (q) {
+        q++;
+        if (!strncmp(q, "pin=", 4)) {
+            const char *v = q + 4;
+            size_t m = strcspn(v, "& ");
+            return m == n && !memcmp(v, web->pin, n);
+        }
+        q = strchr(q, '&');
+    }
+    return 0;
+}
+
+static void handshake(PwWebInput *web, int index, const char *head, const char *target, uint64_t now_ns,
+                      PwNetInputPoll *poll)
+{
+    PwWebInputClient *c = &web->clients[index];
+    size_t host_n = 0, origin_n = 0, key_n = 0, upgrade_n = 0;
+    const char *host = header(head, "host", &host_n), *origin = header(head, "origin", &origin_n);
+    const char *key = header(head, "sec-websocket-key", &key_n), *upgrade = header(head, "upgrade", &upgrade_n);
+    char line[96], from[16], accept[29], reply[256];
+
+    address_text(c->address, from);
+    if (!upgrade || upgrade_n != 9 || strncmp(upgrade, "websocket", 9) || !key || !key_n) {
+        plain(c, "400 Bad Request");
+        return;
+    }
+    if (!ipv4_host(host, host_n) || !origin || origin_n != host_n + 7 || strncmp(origin, "http://", 7) ||
+        memcmp(origin + 7, host, host_n)) {
+        web->refused++;
+        snprintf(line, sizeof(line), "refused %s: not the page's own origin", from);
+        logf_(web, line);
+        plain(c, "403 Forbidden");
+        return;
+    }
+    if (now_ns < web->locked_until_ns) {
+        web->refused++;
+        plain(c, "429 Too Many Requests");
+        return;
+    }
+    if (!pin_ok(web, target)) {
+        web->refused++;
+        if (++web->wrong_pins >= PW_WEBINPUT_PIN_FREE) {
+            unsigned shift = web->wrong_pins - PW_WEBINPUT_PIN_FREE;
+            uint64_t wait = PW_WEBINPUT_LOCKOUT_NS << (shift > 4 ? 4 : shift);
+            if (wait > 600000000000ull) wait = 600000000000ull;
+            web->locked_until_ns = now_ns + wait;
+        }
+        snprintf(line, sizeof(line), "wrong PIN from %s (%u)", from, (unsigned)web->wrong_pins);
+        logf_(web, line);
+        plain(c, "403 Forbidden");
+        return;
+    }
+    web->wrong_pins = 0;
+    pw_webinput_accept_key(key, key_n, accept);
+    snprintf(reply, sizeof(reply),
+             "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
+             "Sec-WebSocket-Accept: %s\r\n\r\n", accept);
+    (void)queue(c, reply, strlen(reply));
+    c->websocket = 1;
+    c->close_after = 0;
+    if (web->controller >= 0 && web->controller != index) {
+        logf_(web, "another page took over");
+        drop(web, web->controller, poll);
+    }
+    web->controller = index;
+    web->sockets++;
+    snprintf(reply, sizeof(reply), "target %.*s", (int)(host_n < 64 ? host_n : 64), host);
+    frame(c, 1, reply, strlen(reply));
+    snprintf(line, sizeof(line), "page connected from %s", from);
+    logf_(web, line);
+}
+
+/* A whole request head is in: answer it. */
+static void request(PwWebInput *web, int index, uint64_t now_ns, PwNetInputPoll *poll)
+{
+    PwWebInputClient *c = &web->clients[index];
+    char head[PW_WEBINPUT_HEAD + 1], target[256];
+    size_t n = 0;
+    const char *space;
+
+    memcpy(head, c->in, c->in_used);
+    head[c->in_used] = 0;
+    c->in_used = 0;
+    if (strncmp(head, "GET ", 4)) {
+        plain(c, "405 Method Not Allowed");
+        return;
+    }
+    space = strchr(head + 4, ' ');
+    n = space ? (size_t)(space - (head + 4)) : 0;
+    if (!n || n >= sizeof(target)) {
+        plain(c, "400 Bad Request");
+        return;
+    }
+    memcpy(target, head + 4, n);
+    target[n] = 0;
+    if (!strcmp(target, "/") || !strncmp(target, "/?", 2)) {
+        web->pages++;
+        respond(c, "200 OK", "text/html; charset=utf-8", pw_webinput_page, pw_webinput_page_length);
+    } else if (!strcmp(target, "/ws") || !strncmp(target, "/ws?", 4)) {
+        handshake(web, index, head, target, now_ns, poll);
+    } else {
+        plain(c, "404 Not Found");
+    }
+}
+
+static int head_complete(const uint8_t *bytes, size_t length)
+{
+    for (size_t i = 3; i < length; i++)
+        if (bytes[i - 3] == '\r' && bytes[i - 2] == '\n' && bytes[i - 1] == '\r' && bytes[i] == '\n') return 1;
+    return 0;
+}
+
+static int number(const char **p, long *out)
+{
+    long sign = 1, v = 0;
+    int digits = 0;
+    while (**p == ' ') (*p)++;
+    if (**p == '-') { sign = -1; (*p)++; }
+    while (**p >= '0' && **p <= '9' && digits < 9) { v = v * 10 + (**p - '0'); (*p)++; digits++; }
+    *out = sign * v;
+    return digits > 0;
+}
+
+static long clamp(long v, long limit) { return v > limit ? limit : v < -limit ? -limit : v; }
+
+int pw_webinput_command(PwWebInput *web, const char *text, size_t length, uint64_t now_ns, PwNetInputPoll *poll)
+{
+    char line[PW_WEBINPUT_PAYLOAD + 1];
+    const char *p = line;
+    long a = 0, b = 0;
+    char verb[8] = { 0 };
+    size_t v = 0;
+
+    (void)now_ns;
+    if (!web || !text || !poll || length > PW_WEBINPUT_PAYLOAD) return PW_ERR_PRECONDITION;
+    memcpy(line, text, length);
+    line[length] = 0;
+    while (*p && *p != ' ' && v < sizeof(verb) - 1) verb[v++] = *p++;
+    web->commands++;
+    if (!strcmp(verb, "h") || !strcmp(verb, "target")) return PW_OK;
+    if (!strcmp(verb, "on")) {
+        if (!web->capturing) logf_(web, "capture on");
+        web->capturing = 1;
+        return PW_OK;
+    }
+    if (!strcmp(verb, "off")) {
+        if (web->capturing) logf_(web, "capture off");
+        release(web, poll);
+        return PW_OK;
+    }
+    if (strcmp(verb, "k") && strcmp(verb, "b") && strcmp(verb, "m") && strcmp(verb, "w"))
+        return PW_ERR_UNSUPPORTED;
+    if (!web->capturing) return PW_OK;   /* late input after a stop */
+    if (!number(&p, &a)) return PW_ERR_MALFORMED;
+    if (verb[0] == 'w') {
+        poll->wheel += (int32_t)clamp(a, 100);
+        return PW_OK;
+    }
+    if (!number(&p, &b)) return PW_ERR_MALFORMED;
+    if (verb[0] == 'm') {
+        poll->dx += (int32_t)clamp(a, PW_NETINPUT_MAX_MOTION);
+        poll->dy += (int32_t)clamp(b, PW_NETINPUT_MAX_MOTION);
+        return PW_OK;
+    }
+    if (verb[0] == 'k') {
+        if (a <= 0 || a >= 255) return PW_ERR_MALFORMED;
+        if (b) web->keys[a >> 3] |= (uint8_t)(1u << (a & 7));
+        else web->keys[a >> 3] &= (uint8_t)~(1u << (a & 7));
+    } else {
+        if (a < 0 || a > 2) return PW_ERR_MALFORMED;
+        if (b) web->buttons |= (uint8_t)(1u << a);
+        else web->buttons &= (uint8_t)~(1u << a);
+    }
+    pw_netinput_set(&web->delivered, web->keys, web->buttons, poll);
+    return PW_OK;
+}
+
+/* Reads the WebSocket frames that are complete; 0 when the client must go. */
+static int frames(PwWebInput *web, int index, uint64_t now_ns, PwNetInputPoll *poll, int *budget)
+{
+    PwWebInputClient *c = &web->clients[index];
+
+    while (c->in_used >= 2 && *budget > 0) {
+        uint8_t opcode = c->in[0] & 0x0f, *mask;
+        size_t length = c->in[1] & 0x7f, at = 2;
+        char payload[PW_WEBINPUT_PAYLOAD];
+
+        if (!(c->in[0] & 0x80) || !(c->in[1] & 0x80) || length == 127) return 0;   /* fragment, unmasked, huge */
+        if (length == 126) {
+            if (c->in_used < 4) return 1;
+            length = (size_t)c->in[2] << 8 | c->in[3];
+            at = 4;
+        }
+        if (length > sizeof(payload)) return 0;
+        if (c->in_used < at + 4 + length) return 1;
+        mask = c->in + at;
+        for (size_t i = 0; i < length; i++) payload[i] = (char)(c->in[at + 4 + i] ^ mask[i & 3]);
+        memmove(c->in, c->in + at + 4 + length, c->in_used - (at + 4 + length));
+        c->in_used -= at + 4 + length;
+        if (opcode == 8) return 0;
+        if (opcode == 9) frame(c, 10, payload, length);
+        if (opcode == 1 && index == web->controller) {
+            if (PW_NETINPUT_EVENTS - poll->count < 8) { *budget = 0; return 1; }
+            (void)pw_webinput_command(web, payload, length, now_ns, poll);
+            (*budget)--;
+        }
+    }
+    return 1;
+}
+
+/* Sends what is queued; 0 when the client is done or failed. */
+static int flush(PwWebInput *web, PwWebInputClient *c)
+{
+    while (c->head_sent < c->head_used) {
+        long n = web->ops.send(c->socket, c->head + c->head_sent, c->head_used - c->head_sent);
+        if (n < 0) return 0;
+        if (n == 0) return 1;
+        c->head_sent += (size_t)n;
+    }
+    while (c->body && c->body_sent < c->body_used) {
+        long n = web->ops.send(c->socket, c->body + c->body_sent, c->body_used - c->body_sent);
+        if (n < 0) return 0;
+        if (n == 0) return 1;
+        c->body_sent += (size_t)n;
+    }
+    return !c->close_after;
+}
+
+void pw_webinput_poll(PwWebInput *web, uint64_t now_ns, PwNetInputPoll *poll)
+{
+    int budget = PW_WEBINPUT_FRAMES;
+
+    if (!web || !poll || web->listener < 0) return;
+    for (int accepted = 0; accepted < 8; accepted++) {
+        uint32_t address = 0;
+        int s = web->ops.accept(web->listener, &address), slot = -1;
+        if (s < 0) break;
+        for (int i = 0; i < PW_WEBINPUT_CLIENTS && slot < 0; i++)
+            if (web->clients[i].socket < 0) slot = i;
+        if (slot < 0 || !pw_netinput_private_address(address)) {
+            web->refused++;
+            web->ops.close(s);
+            continue;
+        }
+        memset(&web->clients[slot], 0, sizeof(web->clients[slot]));
+        web->clients[slot].socket = s;
+        web->clients[slot].address = address;
+        web->clients[slot].since_ns = web->clients[slot].last_ns = now_ns;
+    }
+    for (int i = 0; i < PW_WEBINPUT_CLIENTS; i++) {
+        PwWebInputClient *c = &web->clients[i];
+        int keep = 1;
+
+        if (c->socket < 0) continue;
+        while (keep && c->in_used < sizeof(c->in) && !c->close_after) {
+            long n = web->ops.receive(c->socket, c->in + c->in_used, sizeof(c->in) - c->in_used);
+            if (n < 0) break;
+            if (n == 0) { keep = 0; break; }
+            c->in_used += (size_t)n;
+            c->last_ns = now_ns;
+            if (c->websocket) {
+                keep = frames(web, i, now_ns, poll, &budget);
+            } else {
+                if (head_complete(c->in, c->in_used)) request(web, i, now_ns, poll);
+                else if (c->in_used == sizeof(c->in)) plain(c, "431 Request Header Fields Too Large");
+            }
+        }
+        if (keep && c->websocket && c->in_used) keep = frames(web, i, now_ns, poll, &budget);
+        if (keep) keep = flush(web, c);
+        if (keep && !c->websocket && now_ns - c->since_ns > PW_WEBINPUT_HTTP_NS) keep = 0;
+        if (keep && c->websocket && now_ns - c->last_ns > 10 * PW_WEBINPUT_IDLE_NS) keep = 0;
+        if (keep && i == web->controller && web->capturing && now_ns - c->last_ns > PW_WEBINPUT_IDLE_NS) {
+            logf_(web, "page silent: capture stopped");
+            release(web, poll);
+        }
+        if (!keep) drop(web, i, poll);
+    }
+}
+
+void pw_webinput_close(PwWebInput *web, PwNetInputPoll *poll)
+{
+    if (!web) return;
+    for (int i = 0; i < PW_WEBINPUT_CLIENTS; i++) drop(web, i, poll);
+    if (web->listener >= 0) web->ops.close(web->listener);
+    web->listener = -1;
+    if (poll) release(web, poll);
+}
diff --git a/src/pw_webinput.h b/src/pw_webinput.h
new file mode 100644
index 0000000..1903cbf
--- /dev/null
+++ b/src/pw_webinput.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_WEBINPUT_H
+#define PW_WEBINPUT_H
+/*
+ * A PC's keyboard and mouse from a web page the title serves itself, so the
+ * player needs nothing installed: a browser on the LAN opens
+ * http://<console>:8361/, enters the PIN the title's menu shows, goes full
+ * screen and captures (TrinityXSX's tools/netinput-sender/src/web/index.html,
+ * which also runs from that tool on 127.0.0.1).
+ *
+ * The page sends short text commands over one WebSocket:
+ *
+ *   on · off            capture starts / stops (stop releases everything)
+ *   h                   heartbeat while capturing
+ *   k <vk> <0|1>        a Windows virtual key up or down
+ *   b <0|1|2> <0|1>     left, right or middle button up or down
+ *   m <dx> <dy>         relative mouse motion in pixels
+ *   w <detents>         wheel, up positive
+ *
+ * Keys keep their sides (0xa0..0xa5) on the wire and are folded here as the
+ * other sources' are (pw_netinput_set). One page drives input at a time: a
+ * new one takes over and the old one is closed. Everything held is released
+ * when the page stops, disconnects, or a capturing page is silent for
+ * PW_WEBINPUT_IDLE_NS. Only private (LAN) addresses are served; the
+ * WebSocket wants the PIN (?pin=), an IPv4 Host (no DNS rebinding) and an
+ * Origin that is the page's own; wrong PINs lock it out for a while.
+ *
+ * Sockets come through PwWebInputOps (native/pw_webinput_ps5.c on the
+ * console), so all of this runs in host tests too.
+ */
+#include "pw_netinput.h"
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    PW_WEBINPUT_PORT = 8361,
+    PW_WEBINPUT_CLIENTS = 6,
+    PW_WEBINPUT_HEAD = 4096,         /* a request head, and a WebSocket's unread bytes */
+    PW_WEBINPUT_PAYLOAD = 256,       /* the largest command */
+    PW_WEBINPUT_PIN_FREE = 5,        /* wrong PINs before a lockout */
+    PW_WEBINPUT_FRAMES = 128,        /* commands read per poll at most */
+};
+#define PW_WEBINPUT_IDLE_NS 1500000000ull        /* a capturing page this silent is released */
+#define PW_WEBINPUT_HTTP_NS 10000000000ull       /* a plain request has this long */
+#define PW_WEBINPUT_LOCKOUT_NS 30000000000ull    /* first lockout; doubles, up to 10 minutes */
+
+typedef struct PwWebInputOps {
+    /* A new connection and its IPv4 address (host order), or < 0 when none waits. */
+    int (*accept)(int listener, uint32_t *address);
+    /* Bytes read; 0 when the peer closed or failed; < 0 when nothing waits. */
+    long (*receive)(int socket, void *buffer, size_t length);
+    /* Bytes sent, 0 when it would block; < 0 when the connection failed. */
+    long (*send)(int socket, const void *buffer, size_t length);
+    void (*close)(int socket);
+    void (*log)(const char *line);
+} PwWebInputOps;
+
+typedef struct PwWebInputClient {
+    int socket;                      /* -1: a free slot */
+    uint32_t address;
+    int websocket;
+    uint64_t since_ns, last_ns;      /* accepted; its newest bytes */
+    uint8_t in[PW_WEBINPUT_HEAD];
+    size_t in_used;
+    char head[640];                  /* a response head still to send */
+    size_t head_used, head_sent;
+    const char *body;                /* then its body (static), then it is closed */
+    size_t body_used, body_sent;
+    int close_after;
+} PwWebInputClient;
+
+typedef struct PwWebInput {
+    PwWebInputOps ops;
+    int listener;
+    char pin[8];
+    PwWebInputClient clients[PW_WEBINPUT_CLIENTS];
+    int controller;                  /* the client whose page drives input, or -1 */
+    int capturing;
+    uint8_t keys[32], buttons;       /* as the page holds them, sides kept */
+    PwNetInput delivered;            /* what the game was given */
+    uint32_t wrong_pins;
+    uint64_t locked_until_ns;
+    uint64_t pages, sockets, refused, commands;
+} PwWebInput;
+
+/* Serves on an already listening, non-blocking socket. pin: 4 to 7 digits. */
+int pw_webinput_open(PwWebInput *web, const PwWebInputOps *ops, int listener, const char *pin);
+/* Accepts, reads and answers what waits; input changes are added to poll. */
+void pw_webinput_poll(PwWebInput *web, uint64_t now_ns, PwNetInputPoll *poll);
+/* Closes every connection and the listener; releases what was held. */
+void pw_webinput_close(PwWebInput *web, PwNetInputPoll *poll);
+
+/* The page (src/pw_webinput_page.h, generated from TrinityXSX's copy). */
+extern const char pw_webinput_page[];
+extern const size_t pw_webinput_page_length;
+
+/* For tests: SHA-1, base64, the WebSocket accept key, one command. */
+void pw_webinput_sha1(const uint8_t *data, size_t length, uint8_t out[20]);
+size_t pw_webinput_base64(const uint8_t *data, size_t length, char *out, size_t capacity);
+void pw_webinput_accept_key(const char *key, size_t key_length, char out[29]);
+int pw_webinput_command(PwWebInput *web, const char *text, size_t length, uint64_t now_ns, PwNetInputPoll *poll);
+#endif
