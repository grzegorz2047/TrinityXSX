@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_WEBINPUT_PS5_H
+#define PW_WEBINPUT_PS5_H
+/*
+ * The web page keyboard and mouse (src/pw_webinput.h) on the PS5: a
+ * non-blocking TCP listener through libSceNet, the console's LAN address
+ * for the menu, and a fresh PIN each time it opens.
+ */
+#include "../src/pw_webinput.h"
+#include <stdint.h>
+
+/* A bound, listening, non-blocking socket on every address, or < 0. */
+int pw_webinput_ps5_listen(uint16_t port);
+/* libSceNet's accept, recv, send and close. */
+const PwWebInputOps *pw_webinput_ps5_system_ops(void (*log)(const char *line));
+/* The console's IPv4 address as text, or "" when it has none. */
+void pw_webinput_ps5_address(char out[16]);
+/* Four digits mixed from a seed (the clock): enough to keep
+ * another player on the LAN from typing into the game by accident. */
+void pw_webinput_ps5_pin(uint64_t seed, char out[8]);
+#endif
