diff --git a/native/pw_webinput_ps5.c b/native/pw_webinput_ps5.c
new file mode 100644
index 0000000..bf27e94
--- /dev/null
+++ b/native/pw_webinput_ps5.c
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_webinput_ps5.h"
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+
+void pw_webinput_ps5_pin(uint64_t seed, char out[8])
+{
+    uint64_t x = seed ^ 0x2545f4914f6cdd1dull;
+    /* splitmix64 */
+    x += 0x9e3779b97f4a7c15ull;
+    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ull;
+    x = (x ^ (x >> 27)) * 0x94d049bb133111ebull;
+    x ^= x >> 31;
+    snprintf(out, 8, "%04u", (unsigned)(x % 10000u));
+}
+
+int sceNetSocket(const char *name, int domain, int type, int protocol);
+int sceNetSocketClose(int socket);
+int sceNetSetsockopt(int socket, int level, int option, const void *value, socklen_t length);
+int sceNetBind(int socket, const struct sockaddr *address, socklen_t length);
+int sceNetListen(int socket, int backlog);
+int sceNetAccept(int socket, struct sockaddr *address, socklen_t *length);
+int sceNetRecv(int socket, void *buffer, size_t length, int flags);
+int sceNetSend(int socket, const void *buffer, size_t length, int flags);
+int *sceNetErrnoLoc(void);
+int sceNetConnect(int socket, const struct sockaddr *address, socklen_t length);
+int sceNetGetsockname(int socket, struct sockaddr *address, socklen_t *length);
+
+enum {
+    PW_SCE_SO_NBIO = 0x1200,          /* as ps5log_ps5_net.c */
+    PW_SCE_EAGAIN = 35,               /* FreeBSD's EAGAIN / EWOULDBLOCK */
+};
+
+static int nonblocking(int s)
+{
+    int enabled = 1;
+    return sceNetSetsockopt(s, SOL_SOCKET, PW_SCE_SO_NBIO, &enabled, sizeof(enabled));
+}
+
+static int would_block(void)
+{
+    int *e = sceNetErrnoLoc();
+    return e && *e == PW_SCE_EAGAIN;
+}
+
+int pw_webinput_ps5_listen(uint16_t port)
+{
+    struct sockaddr_in address;
+    int reuse = 1;
+    int s = sceNetSocket("pw-webinput", AF_INET, SOCK_STREAM, 0);
+
+    if (s < 0) return s;
+    memset(&address, 0, sizeof(address));
+    address.sin_len = sizeof(address);
+    address.sin_family = AF_INET;
+    address.sin_port = (in_port_t)((port >> 8) | (port << 8 & 0xff00));   /* network order */
+    address.sin_addr.s_addr = 0;                                          /* INADDR_ANY */
+    (void)sceNetSetsockopt(s, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+    if (nonblocking(s) < 0 || sceNetBind(s, (const struct sockaddr *)&address, sizeof(address)) < 0 ||
+        sceNetListen(s, 8) < 0) {
+        (void)sceNetSocketClose(s);
+        return -1;
+    }
+    return s;
+}
+
+static int system_accept(int listener, uint32_t *address)
+{
+    struct sockaddr_in from;
+    socklen_t length = sizeof(from);
+    int s;
+
+    memset(&from, 0, sizeof(from));
+    s = sceNetAccept(listener, (struct sockaddr *)&from, &length);
+    if (s < 0) return -1;
+    {
+        const uint8_t *a = (const uint8_t *)&from.sin_addr.s_addr;
+        *address = (uint32_t)a[0] << 24 | (uint32_t)a[1] << 16 | (uint32_t)a[2] << 8 | a[3];
+    }
+    if (nonblocking(s) < 0) {
+        (void)sceNetSocketClose(s);
+        return -1;
+    }
+    return s;
+}
+
+static long system_receive(int s, void *buffer, size_t length)
+{
+    int got = sceNetRecv(s, buffer, length, 0);
+    if (got > 0) return got;
+    if (got < 0 && would_block()) return -1;
+    return 0;
+}
+
+static long system_send(int s, const void *buffer, size_t length)
+{
+    int sent = sceNetSend(s, buffer, length, 0);
+    if (sent >= 0) return sent;
+    return would_block() ? 0 : -1;
+}
+
+static void system_close(int s) { (void)sceNetSocketClose(s); }
+
+const PwWebInputOps *pw_webinput_ps5_system_ops(void (*log)(const char *line))
+{
+    static PwWebInputOps ops;
+    ops.accept = system_accept;
+    ops.receive = system_receive;
+    ops.send = system_send;
+    ops.close = system_close;
+    ops.log = log;
+    return &ops;
+}
+
+void pw_webinput_ps5_address(char out[16])
+{
+    /* The address a datagram to the internet would leave from: a UDP socket
+     * "connected" there sends nothing, and getsockname names the interface.
+     * Only libSceNet, which the title already uses. */
+    struct sockaddr_in to, local;
+    socklen_t length = sizeof(local);
+    int s = sceNetSocket("pw-webinput-ip", AF_INET, SOCK_DGRAM, 0);
+    const uint8_t *a = (const uint8_t *)&local.sin_addr.s_addr;
+
+    out[0] = 0;
+    if (s < 0) return;
+    memset(&to, 0, sizeof(to));
+    memset(&local, 0, sizeof(local));
+    to.sin_len = sizeof(to);
+    to.sin_family = AF_INET;
+    to.sin_port = (in_port_t)(53u << 8);                     /* 53, network order */
+    to.sin_addr.s_addr = (in_addr_t)(1u | 1u << 8 | 1u << 16 | 1u << 24);   /* 1.1.1.1 */
+    if (sceNetConnect(s, (const struct sockaddr *)&to, sizeof(to)) >= 0 &&
+        sceNetGetsockname(s, (struct sockaddr *)&local, &length) >= 0 && a[0])
+        snprintf(out, 16, "%u.%u.%u.%u", a[0], a[1], a[2], a[3]);
+    (void)sceNetSocketClose(s);
+}
