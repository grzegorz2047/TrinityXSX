+++ b/native/wine64_main.c
@@ -41,6 +41,7 @@
 #include "pw_pad_ps5.h"
 #include "pw_hid_ps5.h"
 #include "pw_netinput_ps5.h"
+#include "pw_webinput_ps5.h"
