 #include "pw_videoout_ps5.h"
 #include "pw_wine_library.h"
@@ -1080,6 +1081,112 @@ static void post_netinput(int (*post_input)(const PwWineInput *), const PwNetInp
     }
 }
 
+/* A PC's keyboard and mouse ([input] remote in the game's profile): the
+ * txin-sender datagrams, the title's own web page, or neither. The profile
+ * is read again every few seconds, so TrinityXSX's settings switch it while
+ * the title runs. What the mode is, and the page's address and PIN, go to
+ * <data>/netinput.txt for the library to show and to the in-game menu. */
+static struct {
+    int mode;                   /* PW_GAME_REMOTE_* in use */
+    int status;                 /* the source's open result */
+    char profile[PW_APP_ID_CAPACITY];
+    PwNetInputPs5 udp;
+    PwWebInput web;
+    PwNetInputPoll poll;
+    char address[16], pin[8];
+} remote_input = { .mode = PW_GAME_REMOTE_OFF, .status = PW_ERR_STATE };
+
+enum { REMOTE_PROFILE_MAX = PW_APP_PROFILE_MAX_BYTES };
+
+static void webinput_log(const char *line)
+{
+    PS5LOG_LOG("PW_WINE64 webinput %s", line);
+}
+
+static void remote_note(void)
+{
+    char path[256], text[160];
+    int fd, n;
+
+    snprintf(path, sizeof(path), "%s/netinput.txt", PW_WINE64_ROOT_DATA);
+    if (remote_input.mode == PW_GAME_REMOTE_BROWSER && remote_input.status == PW_OK)
+        n = snprintf(text, sizeof(text), "mode=browser\nurl=http://%s:%u\npin=%s\n",
+                     remote_input.address[0] ? remote_input.address : "PS5", (unsigned)PW_WEBINPUT_PORT,
+                     remote_input.pin);
+    else if (remote_input.mode == PW_GAME_REMOTE_SENDER && remote_input.status == PW_OK)
+        n = snprintf(text, sizeof(text), "mode=sender\naddress=%s\nport=%u\n",
+                     remote_input.address[0] ? remote_input.address : "PS5", (unsigned)PW_NETINPUT_PORT);
+    else
+        n = snprintf(text, sizeof(text), "mode=%s\n", remote_input.mode == PW_GAME_REMOTE_OFF ? "off" : "failed");
+    fd = open(path, O_CREAT | O_WRONLY | O_TRUNC, 0666);
+    if (fd < 0) return;
+    if (n > 0 && write(fd, text, (size_t)n) < 0) {}
+    close(fd);
+}
+
+/* The menu's line for it, or "" when it is off. */
+static void remote_menu_line(char *out, size_t capacity)
+{
+    out[0] = 0;
+    if (remote_input.status != PW_OK) return;
+    if (remote_input.mode == PW_GAME_REMOTE_BROWSER)
+        snprintf(out, capacity, "PC: HTTP://%s:%u  PIN %s", remote_input.address[0] ? remote_input.address : "PS5",
+                 (unsigned)PW_WEBINPUT_PORT, remote_input.pin);
+    else if (remote_input.mode == PW_GAME_REMOTE_SENDER)
+        snprintf(out, capacity, "PC: TXIN-SENDER %s", remote_input.address[0] ? remote_input.address : "");
+}
+
+/* Closes the source in use and opens mode's; what was held is posted as released. */
+static void remote_switch(int mode, uint64_t now, int (*post_input)(const PwWineInput *), uint64_t *posted,
+                          uint64_t *refused)
+{
+    /* the same mode stays; one that failed to open (a port in use) is tried again */
+    if (mode == remote_input.mode && remote_input.status == PW_OK) return;
+    memset(&remote_input.poll, 0, sizeof(remote_input.poll));
+    if (remote_input.status == PW_OK && remote_input.mode == PW_GAME_REMOTE_SENDER)
+        pw_netinput_ps5_close(&remote_input.udp, &remote_input.poll);
+    if (remote_input.status == PW_OK && remote_input.mode == PW_GAME_REMOTE_BROWSER)
+        pw_webinput_close(&remote_input.web, &remote_input.poll);
+    if (post_input) post_netinput(post_input, &remote_input.poll, 0, posted, refused);
+    remote_input.mode = mode;
+    remote_input.status = PW_OK;
+    pw_webinput_ps5_address(remote_input.address);
+    if (mode == PW_GAME_REMOTE_SENDER) {
+        remote_input.status = pw_netinput_ps5_open(&remote_input.udp, pw_netinput_ps5_system_ops(netinput_log),
+                                                   PW_NETINPUT_PORT);
+    } else if (mode == PW_GAME_REMOTE_BROWSER) {
+        int listener = pw_webinput_ps5_listen(PW_WEBINPUT_PORT);
+        pw_webinput_ps5_pin(now ^ (uint64_t)listener << 32, remote_input.pin);
+        remote_input.status = listener < 0 ? PW_ERR_NOT_FOUND :
+            pw_webinput_open(&remote_input.web, pw_webinput_ps5_system_ops(webinput_log), listener, remote_input.pin);
+        PS5LOG_LOG("PW_WINE64 webinput listen tcp port=%u socket=%d status=%s address=%s",
+                   (unsigned)PW_WEBINPUT_PORT, listener, pw_result_name(remote_input.status),
+                   remote_input.address[0] ? remote_input.address : "?");
+    }
+    PS5LOG_LOG("PW_WINE64 remote input mode=%s status=%s", mode == PW_GAME_REMOTE_SENDER ? "sender" :
+               mode == PW_GAME_REMOTE_BROWSER ? "browser" : "off", pw_result_name(remote_input.status));
+    remote_note();
+}
+
+/* [input] remote as the profile says now, or -1 when it cannot be read. */
+static int remote_profile_mode(void)
+{
+    static uint8_t text[REMOTE_PROFILE_MAX];
+    static PwGameProfile parsed;
+    char path[256];
+    ssize_t n;
+    int fd;
+
+    if (!remote_input.profile[0]) return -1;
+    snprintf(path, sizeof(path), "%s/profiles/%s.profile", PW_WINE64_ROOT_DATA, remote_input.profile);
+    fd = open(path, O_RDONLY);
+    if (fd < 0) return -1;
+    n = read(fd, text, sizeof(text));
+    close(fd);
+    if (n <= 0 || pw_game_profile_parse(text, (size_t)n, &parsed) != PW_OK) return -1;
+    return (int)parsed.input.remote;
+}
+
 /* The process's CPU time, user and system, in milliseconds: a stall that
  * waits shows no growth, one that spins grows by a core a second. */
 static unsigned long long cpu_ms(void)
@@ -1335,10 +1442,6 @@ int main(int argc, char **argv)
     static PwVideoOutPs5 video;
     static PwPadPs5 pad;
     static PwHidPs5 hid;
