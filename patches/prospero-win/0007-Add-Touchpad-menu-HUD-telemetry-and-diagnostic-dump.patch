+                    /* Refresh compact FPS/VRAM telemetry snapshot when opening menu. */
+                    menu_telemetry[0] = '\0';
+                    menu_notice[0] = '\0';
+                    char hud_path[256];
+                    snprintf(hud_path, sizeof(hud_path), "%s/hud_stats.txt", PW_WINE64_ROOT_DATA);
+                    int hfd = open(hud_path, O_RDONLY);
+                    if (hfd >= 0) {
+                        ssize_t n = read(hfd, menu_telemetry, sizeof(menu_telemetry) - 1);
+                        close(hfd);
+                        if (n > 0) {
+                            menu_telemetry[n] = '\0';
+                            for (ssize_t k = 0; k < n; k++) {
+                                if (menu_telemetry[k] == '\r' || menu_telemetry[k] == '\n') {
+                                    menu_telemetry[k] = '\0';
+                                    break;
+                                }
+                            }
+                        }
+                    }
+                }
                 if (was_open && !game_menu.open) {
                     menu_drawn_open = 0;
                     menu_drawn_cursor = -1;
+                    menu_notice[0] = '\0';
                     shown_sequence = 0; /* force GDI library repaint on resume */
