+                    char req_path[256];
+                    snprintf(req_path, sizeof(req_path), "%s/dump_diag.req", PW_WINE64_ROOT_DATA);
+                    int rfd = open(req_path, O_CREAT | O_WRONLY | O_TRUNC, 0666);
+                    if (rfd >= 0) {
+                        (void)write(rfd, "1\n", 2);
+                        close(rfd);
+                        snprintf(menu_notice, sizeof(menu_notice),
+                                 "DIAGNOSTIC DUMP SAVED - DOWNLOAD VIA WEB COMPANION (L1)");
+                    } else {
+                        snprintf(menu_notice, sizeof(menu_notice), "CANNOT WRITE DIAGNOSTIC REQUEST");
+                    }
+                    PS5LOG_LOG("PW_WINE64 menu action=dump-diag");
+                    menu_drawn_open = 0; /* redraw menu with notice banner */
+                } else if (view.action == PW_GAME_MENU_ACTION_KEYBOARD && osk_status == PW_OK) {
                     pw_osk_open(&osk);
                 } else if (view.action == PW_GAME_MENU_ACTION_LIBRARY) {
                     PS5LOG_LOG("PW_WINE64 menu action=library");
@@ -1681,7 +1719,7 @@ int main(int argc, char **argv)
                     frame_shown, PW_LAUNCHER_RENDER_WIDTH, PW_LAUNCHER_RENDER_HEIGHT,
