+static void trinityxsx_write_startup(const char *line, size_t length)
+{
+    int fd = open(PW_WINE64_ROOT_DATA "/startup.log", O_WRONLY | O_CREAT | O_APPEND, 0644);
+    if (fd < 0) return;
+    (void)write(fd, line, length);
+    close(fd);
+}
+
+static void trinityxsx_startup(const char *stage, int status, int detail)
+{
+    char line[128];
+    int length = snprintf(line, sizeof(line), "%s status=%d (0x%08x) detail=%d\n",
+                          stage, status, (unsigned)status, detail);
+    if (length <= 0 || (size_t)length >= sizeof(line)) return;
+    trinityxsx_write_startup(line, (size_t)length);
+}
+
+static void trinityxsx_startup_text(const char *tag, const char *message)
+{
+    char line[1024];
+    int length = snprintf(line, sizeof(line), "%s %.980s\n", tag, message);
+    if (length <= 0 || (size_t)length >= sizeof(line)) return;
+    trinityxsx_write_startup(line, (size_t)length);
+}
