diff --git a/src/pw_game_menu.c b/src/pw_game_menu.c
index b5f151b..e08dcbb 100644
--- a/src/pw_game_menu.c
+++ b/src/pw_game_menu.c
@@ -2,36 +2,44 @@
 #include "pw_game_menu.h"
 #include <string.h>
 
-/* Lines in order; only those with an action can take the cursor. Without
- * the console's keyboard its line says there is nothing else yet. */
-enum { ACTION_NONE, ACTION_CLOSE, ACTION_KEYBOARD };
+enum { ACTION_NONE, ACTION_CLOSE, ACTION_LIBRARY, ACTION_KEYBOARD, ACTION_EXIT };
 typedef struct MenuLine { const char *text; int action; } MenuLine;
+
 static const MenuLine with_keyboard[] = {
-    { "Keyboard input", ACTION_KEYBOARD },
-    { "Close", ACTION_CLOSE },
+    { "RESUME", ACTION_CLOSE },
+    { "RETURN TO TRINITYXSX LIBRARY", ACTION_LIBRARY },
+    { "ON-SCREEN KEYBOARD", ACTION_KEYBOARD },
+    { "EXIT TO PS5 HOME", ACTION_EXIT },
 };
 static const MenuLine without_keyboard[] = {
-    { "No cheats for this game yet", ACTION_NONE },
-    { "Close", ACTION_CLOSE },
+    { "RESUME", ACTION_CLOSE },
+    { "RETURN TO TRINITYXSX LIBRARY", ACTION_LIBRARY },
+    { "EXIT TO PS5 HOME", ACTION_EXIT },
 };
-enum { LINE_COUNT = sizeof(with_keyboard) / sizeof(with_keyboard[0]) };
-_Static_assert(sizeof(without_keyboard) == sizeof(with_keyboard), "both menus have the same lines");
 
-static const MenuLine *lines_of(const PwGameMenu *menu)
+static const MenuLine *lines_of(const PwGameMenu *menu, int *count)
 {
-    return menu->keyboard ? with_keyboard : without_keyboard;
+    if (menu->keyboard) {
+        *count = (int)(sizeof(with_keyboard) / sizeof(with_keyboard[0]));
+        return with_keyboard;
+    }
+    *count = (int)(sizeof(without_keyboard) / sizeof(without_keyboard[0]));
+    return without_keyboard;
 }
 
 static int selectable(const PwGameMenu *menu, int line)
 {
-    return line >= 0 && line < LINE_COUNT && lines_of(menu)[line].action != ACTION_NONE;
+    int count = 0;
+    const MenuLine *lines = lines_of(menu, &count);
+    return line >= 0 && line < count && lines[line].action != ACTION_NONE;
 }
 
-/* The next selectable line from the cursor in direction step, wrapping. */
 static int move(const PwGameMenu *menu, int cursor, int step)
 {
-    for (int i = 1; i <= LINE_COUNT; i++) {
-        int line = ((cursor + step * i) % LINE_COUNT + LINE_COUNT) % LINE_COUNT;
+    int count = 0;
+    (void)lines_of(menu, &count);
+    for (int i = 1; i <= count; i++) {
+        int line = ((cursor + step * i) % count + count) % count;
         if (selectable(menu, line)) return line;
     }
     return cursor;
@@ -39,48 +47,57 @@ static int move(const PwGameMenu *menu, int cursor, int step)
 
 static void snapshot_of(const PwGameMenu *menu, struct pw_title_menu *snapshot)
 {
+    int count = 0;
+    const MenuLine *lines = lines_of(menu, &count);
     memset(snapshot, 0, sizeof(*snapshot));
     snapshot->version = PW_TITLE_MENU_VERSION;
     if (!menu->open) return;
     snapshot->open = 1;
-    snapshot->lines = LINE_COUNT;
+    snapshot->lines = (uint32_t)count;
     snapshot->selected = menu->cursor;
-    strcpy(snapshot->title, "prospero-win");
-    for (int i = 0; i < LINE_COUNT; i++) strcpy(snapshot->line[i], lines_of(menu)[i].text);
+    strcpy(snapshot->title, "TRINITYXSX MENU");
+    for (int i = 0; i < count; i++) strcpy(snapshot->line[i], lines[i].text);
 }
 
 int pw_game_menu_tick(PwGameMenu *menu, uint32_t held, uint32_t pressed, uint32_t released,
-                      struct pw_title_menu *snapshot, PwGameMenuView *view)
+                      int two_finger_touch, struct pw_title_menu *snapshot, PwGameMenuView *view)
 {
     int combo = (held & PW_GAME_MENU_COMBO) == PW_GAME_MENU_COMBO && (pressed & PW_GAME_MENU_COMBO);
+    int touchpad = (pressed & PW_GAME_MENU_TOUCHPAD) != 0 && !two_finger_touch;
+    int toggle = touchpad || combo;
     uint32_t game;
 
     if (!menu || !snapshot || !view) return 0;
     view->action = PW_GAME_MENU_ACTION_NONE;
     if (!menu->open) {
-        if (combo) {
+        if (toggle) {
             menu->open = 1;
             menu->cursor = move(menu, -1, 1);
         }
-    } else if (combo || (pressed & PW_GAME_MENU_CIRCLE)) {
+    } else if (toggle || (pressed & PW_GAME_MENU_CIRCLE)) {
         menu->open = 0;
     } else {
         if (pressed & PW_GAME_MENU_UP) menu->cursor = move(menu, menu->cursor, -1);
         if (pressed & PW_GAME_MENU_DOWN) menu->cursor = move(menu, menu->cursor, 1);
         if ((pressed & PW_GAME_MENU_CROSS) && selectable(menu, menu->cursor)) {
-            if (lines_of(menu)[menu->cursor].action == ACTION_KEYBOARD)
-                view->action = PW_GAME_MENU_ACTION_KEYBOARD;
-            menu->open = 0;             /* every entry closes the menu */
+            int count = 0;
+            const MenuLine *lines = lines_of(menu, &count);
+            switch (lines[menu->cursor].action) {
+            case ACTION_KEYBOARD: view->action = PW_GAME_MENU_ACTION_KEYBOARD; break;
+            case ACTION_LIBRARY:  view->action = PW_GAME_MENU_ACTION_LIBRARY; break;
+            case ACTION_EXIT:     view->action = PW_GAME_MENU_ACTION_EXIT; break;
+            default: break;
+            }
+            menu->open = 0;
         }
     }
     snapshot_of(menu, snapshot);
 
-    menu->withheld = menu->open ? ~0u : menu->withheld & held;
+    menu->withheld = menu->open ? ~0u : (menu->withheld & held);
+    if (toggle) menu->withheld |= (held & (PW_GAME_MENU_TOUCHPAD | PW_GAME_MENU_COMBO));
     game = held & ~menu->withheld;
     view->held = game;
     view->pressed = (pressed & ~menu->withheld) | (game & ~menu->game_held);
-    /* A release is the game's only for a button it saw down, or one pressed
-     * and let go within this tick that it is shown pressed. */
     view->released = (menu->game_held & ~game) | (released & pressed & ~menu->withheld & ~game);
     view->neutral = menu->open;
     menu->game_held = game;
diff --git a/src/pw_game_menu.h b/src/pw_game_menu.h
index 830aa8c..db3d32b 100644
--- a/src/pw_game_menu.h
+++ b/src/pw_game_menu.h
@@ -4,26 +4,25 @@
 #include <stdint.h>
 #include "../wine/ps5/menu/pw_title_menu.h"
 
-/* The in-game menu a profile turns on with [display] menu = true. L3+R3
- * pressed together opens it over the game and closes it again; while it is
- * open the title keeps the DualSense from the game, the d-pad moves the
- * cursor, Cross picks the line and Circle closes. The game's renderer draws
- * the snapshot (DXVK's HUD, through ntdll's ProcessWineTitleMenu).
- *
- * Its entries are "Keyboard input", which asks the title for the console's
- * on-screen keyboard (src/pw_osk.h), and Close. Picking either closes the
- * menu. Without the console's keyboard (keyboard 0, which the title sets)
- * the first line says there are no cheats yet and only Close is offered. */
+/* TrinityXSX quick menu triggered by a single-finger DualSense Touchpad click
+ * (or L3+R3). While open, the runner withholds controller input from the game,
+ * signals ntdll's PW_TITLE_MENU_PROCESS_INFO so XCL pauses Vulkan presentation,
+ * and renders the menu directly through VideoOut / libvulkan idle flip. */
 typedef struct PwGameMenu {
     int open;
     int cursor;
-    int keyboard;           /* 1: the console's keyboard can be opened */
+    int keyboard;           /* 1: the console's on-screen keyboard can be opened */
     uint32_t withheld;      /* buttons the game must not see yet */
     uint32_t game_held;     /* what the game saw held last tick */
 } PwGameMenu;
 
 /* What the picked line asks the title for. */
-enum { PW_GAME_MENU_ACTION_NONE = 0, PW_GAME_MENU_ACTION_KEYBOARD };
+enum {
+    PW_GAME_MENU_ACTION_NONE = 0,
+    PW_GAME_MENU_ACTION_KEYBOARD,
+    PW_GAME_MENU_ACTION_LIBRARY,
+    PW_GAME_MENU_ACTION_EXIT
+};
 
 /* The pad as the game should see it this tick. */
 typedef struct PwGameMenuView {
@@ -33,17 +32,18 @@ typedef struct PwGameMenuView {
 } PwGameMenuView;
 
 /* DualSense buttons the menu reads, as scePadRead reports them. */
-enum { PW_GAME_MENU_L3 = 0x2u, PW_GAME_MENU_R3 = 0x4u, PW_GAME_MENU_UP = 0x10u,
-       PW_GAME_MENU_DOWN = 0x40u, PW_GAME_MENU_CIRCLE = 0x2000u, PW_GAME_MENU_CROSS = 0x4000u,
-       PW_GAME_MENU_COMBO = PW_GAME_MENU_L3 | PW_GAME_MENU_R3 };
+enum {
+    PW_GAME_MENU_L3 = 0x2u,
+    PW_GAME_MENU_R3 = 0x4u,
+    PW_GAME_MENU_UP = 0x10u,
+    PW_GAME_MENU_DOWN = 0x40u,
+    PW_GAME_MENU_CIRCLE = 0x2000u,
+    PW_GAME_MENU_CROSS = 0x4000u,
+    PW_GAME_MENU_TOUCHPAD = 0x100000u,
+    PW_GAME_MENU_COMBO = PW_GAME_MENU_L3 | PW_GAME_MENU_R3
+};
 
-/* One tick of the title's loop with the pad's held buttons and the edges
- * since the last tick. Fills *snapshot (closed when the menu is) and *view,
- * and returns 1 while the menu is open. While open the game sees nothing
- * held; buttons still down when the menu closes stay hidden from the game
- * until they are released, so the press that closed it is not the game's.
- * With nothing hidden the view is the pad's own. */
 int pw_game_menu_tick(PwGameMenu *menu, uint32_t held, uint32_t pressed, uint32_t released,
-                      struct pw_title_menu *snapshot, PwGameMenuView *view);
+                      int two_finger_touch, struct pw_title_menu *snapshot, PwGameMenuView *view);
 
 #endif
diff --git a/src/pw_launcher_render.c b/src/pw_launcher_render.c
index e1697f3..2c28ae0 100644
--- a/src/pw_launcher_render.c
+++ b/src/pw_launcher_render.c
@@ -1,5 +1,6 @@
 /* SPDX-License-Identifier: LGPL-2.1-or-later */
 #include "pw_launcher_render.h"
+#include "../wine/ps5/menu/pw_title_menu.h"
 #include <string.h>
 
 enum { W=PW_LAUNCHER_RENDER_WIDTH,H=PW_LAUNCHER_RENDER_HEIGHT,
@@ -328,3 +329,43 @@ int pw_launcher_navigate(PwLauncherScene *scene,PwLauncherAction action,uint32_t
     }
     return 0;
 }
+
+int pw_launcher_render_menu(const struct pw_title_menu *menu,const PwPresentTarget *target)
+{
+    if(!menu || !target || !target->pixels)return PW_ERR_PRECONDITION;
+    if(target->width!=W || target->height!=H || target->stride<(uint32_t)W*4u ||
+       target->stride%4u || (uint64_t)target->stride*H>target->bytes)return PW_ERR_MALFORMED;
+
+    const Canvas c={target->pixels,target->stride};
+    const uint32_t bg=rgb(14,23,29);
+    const uint32_t panel=rgb(24,37,44);
+    const uint32_t card=rgb(32,48,56);
+    const uint32_t card_sel=rgb(39,78,72);
+    const uint32_t mint=rgb(133,230,189);
+    const uint32_t snow=rgb(238,247,248);
+    const uint32_t muted=rgb(178,199,203);
+
+    fill(&c,0,0,W,H,bg);
+
+    const int32_t pw=960,ph=640;
+    const int32_t px=(W-pw)/2,py=(H-ph)/2;
+    rounded(&c,px,py,pw,ph,18,panel,panel);
+    fill(&c,px,py,pw,6,mint);
+
+    const char *heading=menu->title[0]?menu->title:"TRINITYXSX MENU";
+    text(&c,px+54,py+48,heading,5,snow,pw-108);
+    text(&c,px+54,py+104,"QUICK OVERLAY  -  GAME PAUSED",3,mint,pw-108);
+
+    uint32_t count=menu->lines>PW_TITLE_MENU_LINES?PW_TITLE_MENU_LINES:menu->lines;
+    for(uint32_t i=0;i<count;i++) {
+        int32_t ry=py+168+(int32_t)i*92;
+        int selected=(int32_t)i==menu->selected;
+        rounded(&c,px+48,ry,pw-96,76,10,selected?card_sel:card,selected?card_sel:card);
+        if(selected)fill(&c,px+48,ry,8,76,mint);
+        text(&c,px+80,ry+24,menu->line[i],4,selected?snow:muted,pw-160);
+    }
+
+    const char *hint="D-PAD MOVE    X SELECT    O / TOUCHPAD RESUME";
+    text(&c,px+54,py+ph-54,hint,3,muted,pw-108);
+    return PW_OK;
+}
