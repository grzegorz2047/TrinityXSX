+/* Persists a live Touchpad-menu PC INPUT mode change back to the library profile. */
+static void remote_save_profile_mode(int mode)
+{
+    static uint8_t src[REMOTE_PROFILE_MAX], dst[REMOTE_PROFILE_MAX];
+    char path[256], tmp[272];
+    size_t src_len = 0, dst_len = 0;
+    int fd;
+
+    snprintf(path, sizeof(path), "%s/profiles/%s.profile", PW_WINE64_ROOT_DATA, REMOTE_SETTINGS_PROFILE);
+    snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+    fd = open(path, O_RDONLY);
+    if (fd >= 0) {
+        ssize_t got = read(fd, src, sizeof(src));
+        close(fd);
+        if (got > 0) src_len = (size_t)got;
+    }
+    if (pw_game_profile_set_value(src, src_len, "input", "remote", remote_mode_name(mode),
+                                  dst, sizeof(dst), &dst_len) != PW_OK)
+        return;
+    fd = open(tmp, O_CREAT | O_WRONLY | O_TRUNC, 0666);
+    if (fd >= 0) {
+        ssize_t wrote = write(fd, dst, dst_len);
+        close(fd);
+        if (wrote == (ssize_t)dst_len && rename(tmp, path) == 0) {
+            remote_input.last_profile_mode = mode;
+            return;
+        }
+        (void)unlink(tmp);
+    }
+    fd = open(path, O_CREAT | O_WRONLY | O_TRUNC, 0666);
+    if (fd >= 0) {
+        if (write(fd, dst, dst_len) == (ssize_t)dst_len)
+            remote_input.last_profile_mode = mode;
+        close(fd);
+    }
+}
