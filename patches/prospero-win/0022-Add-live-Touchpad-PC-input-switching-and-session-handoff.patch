+/* Deliberate DualSense input (ignoring minor stick drift) to reclaim control
+ * from automatic PC-session stick-drift muting. */
+static int pad_user_active(const PwPadPs5 *p)
+{
+    int lx, ly, rx, ry;
+    if (!p || !p->core.connected || p->intercepted) return 0;
+    if (p->core.pressed_edges & ~(uint32_t)PW_PAD_PS5_TOUCHPAD) return 1;
+    if (p->l2 > 64 || p->r2 > 64) return 1;
+    lx = (int)p->left_stick.x - 0x80;
+    ly = (int)p->left_stick.y - 0x80;
+    rx = (int)p->right_stick.x - 0x80;
+    ry = (int)p->right_stick.y - 0x80;
+    return lx > 48 || lx < -48 || ly > 48 || ly < -48 ||
+           rx > 48 || rx < -48 || ry > 48 || ry < -48;
+}
