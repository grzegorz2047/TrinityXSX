+
+static int append_bytes(uint8_t *out, size_t cap, size_t *used, const void *data, size_t n)
+{
+    if (n > cap - *used) return PW_ERR_LIMIT;
+    if (n) memcpy(out + *used, data, n);
+    *used += n;
+    return PW_OK;
+}
+
+static int append_kv(uint8_t *out, size_t cap, size_t *used, const char *key, const char *value,
+                     const char *eol, size_t eol_len)
+{
+    if (append_bytes(out, cap, used, key, strlen(key)) != PW_OK) return PW_ERR_LIMIT;
+    if (append_bytes(out, cap, used, " = ", 3) != PW_OK) return PW_ERR_LIMIT;
+    if (append_bytes(out, cap, used, value, strlen(value)) != PW_OK) return PW_ERR_LIMIT;
+    return append_bytes(out, cap, used, eol, eol_len);
+}
+
+int pw_game_profile_set_value(const uint8_t *src, size_t src_length,
+                              const char *section, const char *key, const char *value,
+                              uint8_t *out, size_t out_capacity, size_t *out_length)
+{
+    size_t pos = 0, used = 0;
+    int in_section = 0, found_section = 0, written = 0;
+
+    if (!section || !*section || !key || !*key || !value || !out || !out_length)
+        return PW_ERR_PRECONDITION;
+    if (!src && src_length > 0) return PW_ERR_PRECONDITION;
+
+    while (pos < src_length) {
+        size_t line_start = pos, line_end = pos, raw_end;
+        while (line_end < src_length && src[line_end] != '\n' && src[line_end] != '\r') line_end++;
+        raw_end = line_end;
+        if (raw_end < src_length && src[raw_end] == '\r') raw_end++;
+        if (raw_end < src_length && src[raw_end] == '\n') raw_end++;
+        const char *eol = (raw_end - line_end == 2) ? "\r\n" : "\n";
+        size_t eol_len = (raw_end - line_end == 2) ? 2 : 1;
+
+        const uint8_t *b = src + line_start, *e = src + line_end;
+        trim(&b, &e);
+        if (b < e && *b == '[' && e[-1] == ']') {
+            const uint8_t *sb = b + 1, *se = e - 1;
+            trim(&sb, &se);
+            int matches = is(sb, (size_t)(se - sb), section);
+            if (in_section && !written) {
+                if (append_kv(out, out_capacity, &used, key, value, "\n", 1) != PW_OK)
+                    return PW_ERR_LIMIT;
+                written = 1;
+            }
+            in_section = matches;
+            if (matches) found_section = 1;
+        } else if (in_section && !written && b < e && *b != ';' && *b != '#') {
+            const uint8_t *eq = memchr(b, '=', (size_t)(e - b));
+            if (eq) {
+                const uint8_t *kb = b, *ke = eq;
+                trim(&kb, &ke);
+                if (is(kb, (size_t)(ke - kb), key)) {
+                    if (append_kv(out, out_capacity, &used, key, value, eol, eol_len) != PW_OK)
+                        return PW_ERR_LIMIT;
+                    written = 1;
+                    pos = raw_end;
+                    continue;
+                }
+            }
+        }
+        if (append_bytes(out, out_capacity, &used, src + line_start, raw_end - line_start) != PW_OK)
+            return PW_ERR_LIMIT;
+        pos = raw_end;
+    }
+
+    if (!written) {
+        if (used > 0 && out[used - 1] != '\n') {
+            if (append_bytes(out, out_capacity, &used, "\n", 1) != PW_OK) return PW_ERR_LIMIT;
+        }
+        if (!found_section) {
+            if (used > 0 && append_bytes(out, out_capacity, &used, "\n", 1) != PW_OK)
+                return PW_ERR_LIMIT;
+            if (append_bytes(out, out_capacity, &used, "[", 1) != PW_OK ||
+                append_bytes(out, out_capacity, &used, section, strlen(section)) != PW_OK ||
+                append_bytes(out, out_capacity, &used, "]\n", 2) != PW_OK)
+                return PW_ERR_LIMIT;
+        }
+        if (append_kv(out, out_capacity, &used, key, value, "\n", 1) != PW_OK) return PW_ERR_LIMIT;
+    }
+
+    *out_length = used;
+    return PW_OK;
+}
