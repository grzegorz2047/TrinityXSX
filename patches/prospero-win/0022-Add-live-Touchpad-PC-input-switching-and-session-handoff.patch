+    if (remote_input.web_open && remote_input.web.controller >= 0 && remote_input.web.capturing) {
+        state = PC_SESSION_CAPTURING;
+        source = PC_SOURCE_BROWSER;
+        peer = remote_input.web.clients[remote_input.web.controller].address;
+    } else if (remote_input.udp_open && remote_input.udp.input.linked &&
+               !remote_input.udp.input.released && remote_input.udp.input.capturing) {
+        state = PC_SESSION_CAPTURING;
+        source = PC_SOURCE_SENDER;
+        peer = remote_input.udp.input.address;
+    } else if (remote_input.web_open && remote_input.web.controller >= 0) {
+        state = PC_SESSION_CONNECTED;
+        source = PC_SOURCE_BROWSER;
+        peer = remote_input.web.clients[remote_input.web.controller].address;
+    }
+    if (state == remote_input.session_state && source == remote_input.session_source &&
+        peer == remote_input.session_peer)
+        return 0;
+    remote_input.session_state = state;
+    remote_input.session_source = source;
+    remote_input.session_peer = peer;
