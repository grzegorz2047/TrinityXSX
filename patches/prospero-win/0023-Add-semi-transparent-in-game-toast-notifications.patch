diff --git a/tests/test_pw_toast.c b/tests/test_pw_toast.c
new file mode 100644
index 0000000..90e0391
--- /dev/null
+++ b/tests/test_pw_toast.c
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../src/pw_toast.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static void test_opacity_envelope(void)
+{
+    assert(pw_toast_opacity(0, 3300) == 0);
+    assert(pw_toast_opacity(75, 3300) >= 125 && pw_toast_opacity(75, 3300) <= 130);
+    assert(pw_toast_opacity(150, 3300) == 255);
+    assert(pw_toast_opacity(1500, 3300) == 255);
+    assert(pw_toast_opacity(2900, 3300) == 255);
+    assert(pw_toast_opacity(3100, 3300) >= 125 && pw_toast_opacity(3100, 3300) <= 130);
+    assert(pw_toast_opacity(3299, 3300) > 0 && pw_toast_opacity(3299, 3300) < 5);
+    assert(pw_toast_opacity(3300, 3300) == 0);
+    assert(pw_toast_opacity(99999, 3300) == 0);
+    assert(pw_toast_opacity(10, 0) == 0);
+
+    /* Short duration scales fade-in/out without underflow. */
+    assert(pw_toast_opacity(50, 200) == 255);
+    assert(pw_toast_opacity(125, 200) > 0 && pw_toast_opacity(125, 200) < 255);
+    assert(pw_toast_opacity(200, 200) == 0);
+}
+
+static void test_raster_and_accents(void)
+{
+    static uint8_t rgba[PW_TOAST_BYTES];
+
+    assert(pw_toast_render_rgba8(NULL, sizeof(rgba), "HELLO", NULL, PW_TOAST_ACCENT_MINT) == -1);
+    assert(pw_toast_render_rgba8(rgba, PW_TOAST_BYTES - 1, "HELLO", NULL, PW_TOAST_ACCENT_MINT) == -1);
+
+    /* Two-line mint toast. */
+    assert(pw_toast_render_rgba8(rgba, sizeof(rgba), "PC K+M ACTIVE", "F9 MENU - PAD MUTED",
+                                 PW_TOAST_ACCENT_MINT) == 0);
+    /* Outer corner (0,0) is rounded away (alpha == 0). */
+    assert(rgba[3] == 0);
+    /* Left accent stripe mid-height (x=2, y=27) has mint RGB. */
+    const uint8_t *stripe = rgba + ((size_t)27 * PW_TOAST_WIDTH + 2u) * 4u;
+    assert(stripe[0] == 133 && stripe[1] == 230 && stripe[2] == 189 && stripe[3] == 242);
+    /* Glass interior background away from text is semi-transparent (alpha ~198..210). */
+    const uint8_t *glass = rgba + ((size_t)27 * PW_TOAST_WIDTH + (PW_TOAST_WIDTH - 6u)) * 4u;
+    assert(glass[3] >= 180 && glass[3] <= 225);
+
+    /* Check that white text ink pixels were drawn in the text band. */
+    int ink = 0;
+    for (int y = 9; y < 23; y++) {
+        for (int x = 20; x < 240; x++) {
+            const uint8_t *p = rgba + ((size_t)y * PW_TOAST_WIDTH + (size_t)x) * 4u;
+            if (p[0] > 220 && p[1] > 220 && p[2] > 220 && p[3] == 255) ink++;
+        }
+    }
+    assert(ink > 100);
+
+    /* Amber and coral accents. */
+    assert(pw_toast_render_rgba8(rgba, sizeof(rgba), "DUALSENSE RECLAIMED", NULL,
+                                 PW_TOAST_ACCENT_AMBER) == 0);
+    assert(stripe[0] == 247 && stripe[1] == 198 && stripe[2] == 114);
+
+    assert(pw_toast_render_rgba8(rgba, sizeof(rgba), "PC INPUT PORT FAILED", "CHECK SETTINGS",
+                                 PW_TOAST_ACCENT_CORAL) == 0);
+    assert(stripe[0] == 242 && stripe[1] == 118 && stripe[2] == 118);
+}
+
+static void test_bgrx8_blend(void)
+{
+    static uint8_t rgba[PW_TOAST_BYTES];
+    static uint8_t frame[800 * 600 * 4];
+    const uint32_t W = 800, H = 600, stride = W * 4u;
+
+    assert(pw_toast_render_rgba8(rgba, sizeof(rgba), "PC K+M ACTIVE", "F9 MENU",
+                                 PW_TOAST_ACCENT_MINT) == 0);
+
+    /* Fill frame with flat BGRX8 grey (80, 100, 120, 255). */
+    for (uint32_t i = 0; i < W * H; i++) {
+        frame[i * 4 + 0] = 80;
+        frame[i * 4 + 1] = 100;
+        frame[i * 4 + 2] = 120;
+        frame[i * 4 + 3] = 255;
+    }
+
+    /* Opacity 0 leaves frame untouched. */
+    pw_toast_blend_bgrx8(frame, W, H, stride, rgba, 0);
+    for (uint32_t i = 0; i < W * H; i++) {
+        assert(frame[i * 4 + 0] == 80 && frame[i * 4 + 1] == 100 && frame[i * 4 + 2] == 120);
+    }
+
+    /* Full opacity blends into top-right quadrant only, leaving top-left untouched. */
+    pw_toast_blend_bgrx8(frame, W, H, stride, rgba, 255);
+    assert(frame[0] == 80 && frame[1] == 100 && frame[2] == 120);
+
+    int touched_tr = 0, touched_bl = 0;
+    for (uint32_t y = 0; y < 120; y++) {
+        for (uint32_t x = 400; x < W; x++) {
+            const uint8_t *p = frame + ((size_t)y * W + x) * 4u;
+            if (p[0] != 80 || p[1] != 100 || p[2] != 120) touched_tr++;
+        }
+    }
+    for (uint32_t y = 300; y < H; y++) {
+        for (uint32_t x = 0; x < 400; x++) {
+            const uint8_t *p = frame + ((size_t)y * W + x) * 4u;
+            if (p[0] != 80 || p[1] != 100 || p[2] != 120) touched_bl++;
+        }
+    }
+    assert(touched_tr > 2000 && touched_bl == 0);
+}
+
+int main(void)
+{
+    test_opacity_envelope();
+    test_raster_and_accents();
+    test_bgrx8_blend();
+    puts("test_pw_toast: ok");
+    return 0;
+}
