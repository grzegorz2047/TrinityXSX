+static struct {
+    void (*set_toast)(const struct pw_title_toast *);
+    int enabled;
+    int last_profile_toasts;
+    struct pw_title_toast active;
+    uint8_t rgba[PW_TOAST_BYTES];
+    uint32_t rendered_seq;
+    int gdi_had_toast;
+    uint64_t reclaim_toast_ns;
+} title_toast = { .enabled = 1, .last_profile_toasts = -1 };
+
+static void toast_clear(void)
+{
+    if (title_toast.active.visible) {
+        title_toast.active.visible = 0;
+        title_toast.active.line1[0] = '\0';
+        title_toast.active.line2[0] = '\0';
+        if (title_toast.set_toast) title_toast.set_toast(NULL);
+    }
+}
+
+static void toast_post(uint64_t now, uint32_t accent, const char *line1, const char *line2)
+{
+    struct pw_title_toast next;
+
+    if (!title_toast.enabled || !line1 || !line1[0]) return;
+    memset(&next, 0, sizeof(next));
+    next.version = PW_TITLE_TOAST_VERSION;
+    next.sequence = title_toast.active.sequence + 1u;
+    next.visible = 1;
+    next.accent = accent;
+    next.duration_ms = PW_TOAST_DEFAULT_DURATION_MS;
+    next.created_ns = now;
+    snprintf(next.line1, sizeof(next.line1), "%s", line1);
+    if (line2 && line2[0]) snprintf(next.line2, sizeof(next.line2), "%s", line2);
+    title_toast.active = next;
+    if (title_toast.set_toast) title_toast.set_toast(&next);
+}
+
+static uint8_t toast_current_opacity(uint64_t now)
+{
+    uint64_t elapsed_ms;
+
+    if (!title_toast.active.visible) return 0u;
+    elapsed_ms = now > title_toast.active.created_ns ? (now - title_toast.active.created_ns) / 1000000ull : 0u;
+    if (elapsed_ms >= title_toast.active.duration_ms) {
+        toast_clear();
+        return 0u;
+    }
+    return pw_toast_opacity(elapsed_ms, title_toast.active.duration_ms);
+}
+
+static void toast_apply_gdi(uint8_t *bgrx, uint32_t width, uint32_t height, uint32_t stride, uint8_t opacity)
+{
+    if (!opacity || !bgrx) return;
+    if (title_toast.rendered_seq != title_toast.active.sequence) {
+        if (pw_toast_render_rgba8(title_toast.rgba, sizeof(title_toast.rgba),
+                                  title_toast.active.line1, title_toast.active.line2,
+                                  title_toast.active.accent) != 0)
+            return;
+        title_toast.rendered_seq = title_toast.active.sequence;
+    }
+    pw_toast_blend_bgrx8(bgrx, width, height, stride, title_toast.rgba, opacity);
+}
