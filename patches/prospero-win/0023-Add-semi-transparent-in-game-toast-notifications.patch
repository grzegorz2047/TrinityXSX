++void *ps5_toast_vk_create( struct vulkan_device *device, VkSwapchainKHR host_swapchain,
++                           const VkSwapchainCreateInfoKHR *create_info,
++                           PFN_vkGetInstanceProcAddr get_instance_proc,
++                           PFN_vkGetDeviceProcAddr get_device_proc )
++{
++    struct ps5_toast_swapchain *ctx;
++
++    if (!device || !host_swapchain || !create_info || !get_instance_proc || !get_device_proc)
++        return NULL;
++    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return NULL;
++    ctx->device = device;
++    ctx->host_swapchain = host_swapchain;
++    ctx->format = create_info->imageFormat;
++    ctx->extent = create_info->imageExtent;
++    ctx->usage = create_info->imageUsage;
++    ctx->array_layers = create_info->imageArrayLayers;
++    ctx->get_instance_proc = get_instance_proc;
++    ctx->get_device_proc = get_device_proc;
++
++    pthread_mutex_lock( &ps5_toast_lock );
++    ctx->next = ps5_toast_list;
++    ps5_toast_list = ctx;
++    pthread_mutex_unlock( &ps5_toast_lock );
++    return ctx;
++}
++
++void ps5_toast_vk_destroy( void *opaque )
++{
++    struct ps5_toast_swapchain *ctx = opaque;
++    struct ps5_toast_swapchain **pp;
++
++    if (!ctx) return;
++    pthread_mutex_lock( &ps5_toast_lock );
++    for (pp = &ps5_toast_list; *pp; pp = &(*pp)->next)
++    {
++        if (*pp == ctx)
++        {
++            *pp = ctx->next;
++            break;
++        }
++    }
++    ps5_toast_destroy_gpu( ctx );
++    pthread_mutex_unlock( &ps5_toast_lock );
++    free( ctx );
++}
++
++void ps5_toast_vk_destroy_device( struct vulkan_device *device )
++{
++    struct ps5_toast_swapchain *ctx;
++
++    if (!device) return;
++    pthread_mutex_lock( &ps5_toast_lock );
++    for (ctx = ps5_toast_list; ctx; ctx = ctx->next)
++    {
++        if (ctx->device == device)
++        {
++            ps5_toast_destroy_gpu( ctx );
++            ctx->device = NULL;
++            ctx->state = -1;
++        }
++    }
++    pthread_mutex_unlock( &ps5_toast_lock );
++}
