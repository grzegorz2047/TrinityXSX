 static PwWinePad pad_state;
 static uint32_t rumble_left,rumble_right,rumble_changed;
 static struct pw_title_menu menu_state={.version=PW_TITLE_MENU_VERSION};
+static struct pw_title_toast toast_state={.version=PW_TITLE_TOAST_VERSION};
+static uint32_t toast_visible_atomic;
 /* Audio has its own lock: its sink blocks for a grain, which must not hold
  * up frames or input. */
 static pthread_mutex_t audio_lock=PTHREAD_MUTEX_INITIALIZER;
@@ -247,3 +249,42 @@ void pw_wine_menu(struct pw_title_menu *menu)
     *menu=menu_state;
     pthread_mutex_unlock(&lock);
 }
+void pw_wine_set_toast(const struct pw_title_toast *toast)
+{
+    struct pw_title_toast next={.version=PW_TITLE_TOAST_VERSION};
+    if(toast && toast->visible && toast->line1[0]) {
+        next.visible=1;
+        next.accent=toast->accent<=PW_TITLE_TOAST_ACCENT_CORAL?toast->accent:PW_TITLE_TOAST_ACCENT_MINT;
+        next.duration_ms=toast->duration_ms?toast->duration_ms:3300u;
+        if(next.duration_ms<500u)next.duration_ms=500u;
+        if(next.duration_ms>15000u)next.duration_ms=15000u;
+        next.created_ns=toast->created_ns;
+        memcpy(next.line1,toast->line1,sizeof(next.line1));
+        next.line1[sizeof(next.line1)-1]=0;
+        memcpy(next.line2,toast->line2,sizeof(next.line2));
+        next.line2[sizeof(next.line2)-1]=0;
+    }
+    pthread_mutex_lock(&lock);
+    if(next.visible) {
+        next.sequence=toast_state.sequence+1;
+        toast_state=next;
+        __atomic_store_n(&toast_visible_atomic,1u,__ATOMIC_RELEASE);
+    } else if(toast_state.visible) {
+        next.sequence=toast_state.sequence+1;
+        toast_state=next;
+        __atomic_store_n(&toast_visible_atomic,0u,__ATOMIC_RELEASE);
+    }
+    pthread_mutex_unlock(&lock);
+}
+void pw_wine_toast(struct pw_title_toast *toast)
+{
+    if(!toast)return;
+    if(!__atomic_load_n(&toast_visible_atomic,__ATOMIC_ACQUIRE)) {
+        memset(toast,0,sizeof(*toast));
+        toast->version=PW_TITLE_TOAST_VERSION;
+        return;
+    }
+    pthread_mutex_lock(&lock);
+    *toast=toast_state;
+    pthread_mutex_unlock(&lock);
+}
