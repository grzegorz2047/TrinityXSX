+};
+
+static const PwToastGlyph *pw_toast_find_glyph(char ch)
+{
+    const PwToastGlyph *fallback = &pw_toast_glyphs[0];
+    if (ch >= 'a' && ch <= 'z') ch = (char)(ch - 'a' + 'A');
+    for (size_t i = 0; i < sizeof(pw_toast_glyphs) / sizeof(pw_toast_glyphs[0]); i++) {
+        if (pw_toast_glyphs[i].c == ch) return &pw_toast_glyphs[i];
+        if (pw_toast_glyphs[i].c == '?') fallback = &pw_toast_glyphs[i];
+    }
+    return fallback;
+}
+
+static int pw_toast_outside_corner(int32_t x, int32_t y, int32_t w, int32_t h, int32_t r)
+{
+    int32_t dx = x < r ? (r - 1 - x) : (x >= w - r ? (x - (w - r)) : -1);
+    int32_t dy = y < r ? (r - 1 - y) : (y >= h - r ? (y - (h - r)) : -1);
+    return dx >= 0 && dy >= 0 && dx * dx + dy * dy >= r * r;
+}
+
+/* 4x4 subpixel coverage (0..16) inside a rounded rectangle of radius r. */
+static uint32_t pw_toast_corner_cov(int32_t x, int32_t y, int32_t w, int32_t h, int32_t r)
+{
+    if (x >= r && x < w - r) return 16u;
+    if (y >= r && y < h - r) return 16u;
+    uint32_t hits = 0;
+    const int32_t sw = w * 4, sh = h * 4, sr = r * 4;
+    for (int32_t sy = 0; sy < 4; sy++) {
+        for (int32_t sx = 0; sx < 4; sx++) {
+            if (!pw_toast_outside_corner(x * 4 + sx, y * 4 + sy, sw, sh, sr)) hits++;
+        }
+    }
+    return hits;
+}
+
+static void pw_toast_blend_px(uint8_t *rgba, int32_t x, int32_t y,
+                              uint8_t r, uint8_t g, uint8_t b, uint8_t a)
+{
+    if (x < 0 || y < 0 || x >= PW_TOAST_WIDTH || y >= PW_TOAST_HEIGHT || !a) return;
+    uint8_t *p = rgba + ((size_t)y * PW_TOAST_WIDTH + (size_t)x) * 4u;
+    if (p[3] == 0) {
+        p[0] = r; p[1] = g; p[2] = b; p[3] = a;
+        return;
+    }
+    uint32_t sa = a, da = p[3];
+    uint32_t out_a = sa + (da * (255u - sa) + 127u) / 255u;
+    if (!out_a) { p[0] = p[1] = p[2] = p[3] = 0; return; }
+    uint32_t inv_sa = 255u - sa;
+    p[0] = (uint8_t)((sa * r + ((da * inv_sa + 127u) / 255u) * p[0] + out_a / 2u) / out_a);
+    p[1] = (uint8_t)((sa * g + ((da * inv_sa + 127u) / 255u) * p[1] + out_a / 2u) / out_a);
+    p[2] = (uint8_t)((sa * b + ((da * inv_sa + 127u) / 255u) * p[2] + out_a / 2u) / out_a);
+    p[3] = (uint8_t)(out_a > 255u ? 255u : out_a);
+}
+
+static void pw_toast_draw_text(uint8_t *rgba, int32_t x, int32_t y, const char *s, int32_t scale,
+                               uint8_t r, uint8_t g, uint8_t b, uint8_t a, int32_t max_w)
+{
+    int32_t used = 0;
+    if (!s || scale <= 0) return;
+    for (; *s; s++) {
+        if (used + 5 * scale > max_w) break;
+        const PwToastGlyph *gl = pw_toast_find_glyph(*s);
+        for (int32_t row = 0; row < 7; row++) {
+            for (int32_t col = 0; col < 5; col++) {
+                if (!(gl->rows[row] & (0x10u >> col))) continue;
+                int32_t px = x + used + col * scale;
+                int32_t py = y + row * scale;
+                /* Soft 1px shadow behind glyph pixel for bright scenes. */
+                for (int32_t dy = 0; dy < scale; dy++) {
+                    for (int32_t dx = 0; dx < scale; dx++) {
+                        pw_toast_blend_px(rgba, px + dx + 1, py + dy + 1, 6, 12, 16, 140);
+                    }
+                }
+            }
+        }
+        for (int32_t row = 0; row < 7; row++) {
+            for (int32_t col = 0; col < 5; col++) {
+                if (!(gl->rows[row] & (0x10u >> col))) continue;
+                int32_t px = x + used + col * scale;
+                int32_t py = y + row * scale;
+                for (int32_t dy = 0; dy < scale; dy++) {
+                    for (int32_t dx = 0; dx < scale; dx++) {
+                        pw_toast_blend_px(rgba, px + dx, py + dy, r, g, b, a);
+                    }
+                }
+            }
+        }
+        used += 6 * scale;
+    }
+}
+
+PW_TOAST_API uint8_t pw_toast_opacity(uint64_t elapsed_ms, uint32_t duration_ms)
+{
+    uint32_t fade_in = PW_TOAST_FADE_IN_MS;
+    uint32_t fade_out = PW_TOAST_FADE_OUT_MS;
+
+    if (!duration_ms || elapsed_ms >= duration_ms) return 0u;
+    if (fade_in + fade_out > duration_ms) {
+        fade_in = duration_ms / 4u;
+        fade_out = duration_ms - fade_in;
+    }
+    if (fade_in && elapsed_ms < fade_in) {
+        uint64_t v = (elapsed_ms * 255u + fade_in / 2u) / fade_in;
+        return (uint8_t)(v > 255u ? 255u : v);
+    }
+    if (fade_out && elapsed_ms > duration_ms - fade_out) {
+        uint64_t rem = duration_ms - elapsed_ms;
+        uint64_t v = (rem * 255u + fade_out / 2u) / fade_out;
+        return (uint8_t)(v > 255u ? 255u : v);
+    }
+    return 255u;
+}
+
+PW_TOAST_API int pw_toast_render_rgba8(uint8_t *rgba, size_t capacity,
+                                       const char *line1, const char *line2, uint32_t accent)
+{
+    const int32_t W = PW_TOAST_WIDTH, H = PW_TOAST_HEIGHT, R = 10, STRIPE = 6;
+    uint8_t acc_r = 133, acc_g = 230, acc_b = 189; /* mint */
+
+    if (!rgba || capacity < (size_t)PW_TOAST_BYTES) return -1;
+    if (accent == PW_TOAST_ACCENT_AMBER) {
+        acc_r = 247; acc_g = 198; acc_b = 114;
+    } else if (accent == PW_TOAST_ACCENT_CORAL) {
+        acc_r = 242; acc_g = 118; acc_b = 118;
+    }
+
+    memset(rgba, 0, (size_t)PW_TOAST_BYTES);
+
+    for (int32_t y = 0; y < H; y++) {
+        /* Subtle vertical dark-glass gradient. */
+        uint8_t bg_r = (uint8_t)(22 - (8 * y) / (H - 1));
+        uint8_t bg_g = (uint8_t)(35 - (11 * y) / (H - 1));
+        uint8_t bg_b = (uint8_t)(43 - (13 * y) / (H - 1));
+        uint8_t bg_a = (uint8_t)(210 - (12 * y) / (H - 1));
+
+        for (int32_t x = 0; x < W; x++) {
+            uint32_t cov = pw_toast_corner_cov(x, y, W, H, R);
+            if (!cov) continue;
+            uint8_t *p = rgba + ((size_t)y * W + (size_t)x) * 4u;
+            if (x < STRIPE) {
+                p[0] = acc_r;
+                p[1] = acc_g;
+                p[2] = acc_b;
+                p[3] = (uint8_t)((242u * cov + 8u) / 16u);
+            } else {
+                int inner_border = (x == W - 1 || y == 0 || y == H - 1) ||
+                                   (cov > 0 && cov < 16u);
+                if (inner_border) {
+                    /* Crisp glass highlight rim. */
+                    p[0] = (uint8_t)((bg_r * 2u + 150u) / 3u);
+                    p[1] = (uint8_t)((bg_g * 2u + 190u) / 3u);
+                    p[2] = (uint8_t)((bg_b * 2u + 200u) / 3u);
+                    p[3] = (uint8_t)((220u * cov + 8u) / 16u);
+                } else {
+                    p[0] = bg_r;
+                    p[1] = bg_g;
+                    p[2] = bg_b;
+                    p[3] = (uint8_t)((bg_a * cov + 8u) / 16u);
+                }
+            }
+        }
+    }
+
+    const int32_t text_x = 20;
+    const int32_t max_w = W - text_x - 16;
+    const int has_line2 = line2 && line2[0] != '\0';
+    if (line1 && line1[0]) {
+        if (has_line2) {
+            pw_toast_draw_text(rgba, text_x, 9, line1, 2, 242, 249, 250, 255, max_w);
+            pw_toast_draw_text(rgba, text_x, 30, line2, 2, 176, 204, 210, 245, max_w);
+        } else {
+            size_t len = strlen(line1);
+            int32_t scale = ((int32_t)len * 18 <= max_w) ? 3 : 2;
+            int32_t ty = (H - 7 * scale) / 2;
+            pw_toast_draw_text(rgba, text_x, ty, line1, scale, 242, 249, 250, 255, max_w);
+        }
+    }
+    return 0;
+}
+
+#ifndef PW_TOAST_NO_BGRX8
+PW_TOAST_API void pw_toast_blend_bgrx8(uint8_t *dst_bgrx, uint32_t dst_w, uint32_t dst_h,
+                                       uint32_t dst_stride, const uint8_t *toast_rgba,
+                                       uint8_t opacity)
+{
+    if (!dst_bgrx || !toast_rgba || !opacity || dst_w < 64 || dst_h < 64 || dst_stride < dst_w * 4u)
+        return;
+
+    /* Scale proportionally to height relative to 1080p, clamped to <= 65% width. */
+    uint32_t draw_w = (uint32_t)(((uint64_t)PW_TOAST_WIDTH * dst_h + 540u) / 1080u);
+    uint32_t draw_h = (uint32_t)(((uint64_t)PW_TOAST_HEIGHT * dst_h + 540u) / 1080u);
+    uint32_t max_w = (dst_w * 65u) / 100u;
+    if (draw_w > max_w && draw_w > 0) {
+        draw_h = (uint32_t)(((uint64_t)draw_h * max_w) / draw_w);
+        draw_w = max_w;
+    }
+    if (draw_w < 120u) draw_w = 120u;
+    if (draw_h < 24u) draw_h = 24u;
+    if (draw_w >= dst_w || draw_h >= dst_h) return;
+
+    uint32_t margin_x = (uint32_t)(((uint64_t)36u * dst_h + 540u) / 1080u);
+    uint32_t margin_y = (uint32_t)(((uint64_t)28u * dst_h + 540u) / 1080u);
+    if (margin_x < 10u) margin_x = 10u;
+    if (margin_y < 8u) margin_y = 8u;
+    if (draw_w + margin_x > dst_w) margin_x = dst_w - draw_w;
+    if (draw_h + margin_y > dst_h) margin_y = dst_h - draw_h;
+
+    uint32_t ox = dst_w - margin_x - draw_w;
+    uint32_t oy = margin_y;
+
+    for (uint32_t dy = 0; dy < draw_h; dy++) {
+        uint32_t sy = (uint32_t)(((uint64_t)dy * PW_TOAST_HEIGHT) / draw_h);
+        if (sy >= PW_TOAST_HEIGHT) sy = PW_TOAST_HEIGHT - 1u;
+        const uint8_t *srow = toast_rgba + (size_t)sy * PW_TOAST_WIDTH * 4u;
+        uint8_t *drow = dst_bgrx + (size_t)(oy + dy) * dst_stride + (size_t)ox * 4u;
+
+        for (uint32_t dx = 0; dx < draw_w; dx++) {
+            uint32_t sx = (uint32_t)(((uint64_t)dx * PW_TOAST_WIDTH) / draw_w);
+            if (sx >= PW_TOAST_WIDTH) sx = PW_TOAST_WIDTH - 1u;
+            const uint8_t *sp = srow + (size_t)sx * 4u;
+            uint32_t sa = ((uint32_t)sp[3] * opacity + 127u) / 255u;
+            if (!sa) continue;
+            uint32_t inv = 255u - sa;
+            uint8_t *dp = drow + (size_t)dx * 4u;
+            /* dst is BGRX8, src is RGBA8. */
+            dp[0] = (uint8_t)((sp[2] * sa + dp[0] * inv + 127u) / 255u);
+            dp[1] = (uint8_t)((sp[1] * sa + dp[1] * inv + 127u) / 255u);
+            dp[2] = (uint8_t)((sp[0] * sa + dp[2] * inv + 127u) / 255u);
+            dp[3] = 0xffu;
+        }
+    }
+}
+#endif
diff --git a/src/pw_toast.h b/src/pw_toast.h
new file mode 100644
index 0000000..66d8a66
--- /dev/null
+++ b/src/pw_toast.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_TOAST_H
+#define PW_TOAST_H
+/*
+ * Pure C rasterizer and fade/blend helper for semi-transparent top-right
+ * in-game notification pills. Shared between the native GDI presenter
+ * (native/wine64_main.c) and win32u's PS5 Vulkan toast overlay so both paths
+ * draw the exact same pill.
+ */
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    PW_TOAST_WIDTH = 560,
+    PW_TOAST_HEIGHT = 54,
+    PW_TOAST_BYTES = PW_TOAST_WIDTH * PW_TOAST_HEIGHT * 4,
+    PW_TOAST_FADE_IN_MS = 150,
+    PW_TOAST_FADE_OUT_MS = 400,
+    PW_TOAST_DEFAULT_DURATION_MS = 3300,
+    PW_TOAST_ACCENT_MINT = 0,
+    PW_TOAST_ACCENT_AMBER = 1,
+    PW_TOAST_ACCENT_CORAL = 2,
+};
+
+#ifdef PW_TOAST_INTERNAL
+#define PW_TOAST_API static
+#else
+#define PW_TOAST_API
+#endif
+
+/* Global fade opacity (0..255) at elapsed_ms into a duration_ms toast.
+ * Returns 0 once expired (elapsed_ms >= duration_ms). */
+PW_TOAST_API uint8_t pw_toast_opacity(uint64_t elapsed_ms, uint32_t duration_ms);
+
+/* Rasterizes a 560x54 straight-alpha RGBA8 pill into rgba (capacity >=
+ * PW_TOAST_BYTES). Returns 0 on success, -1 on invalid arguments. */
+PW_TOAST_API int pw_toast_render_rgba8(uint8_t *rgba, size_t capacity,
+                                       const char *line1, const char *line2, uint32_t accent);
+
+#ifndef PW_TOAST_NO_BGRX8
+/* Alpha-blends a 560x54 straight-alpha RGBA8 toast pill into a top-down BGRX8
+ * frame in the top-right corner with global opacity (0..255), scaled smoothly
+ * for the target frame dimensions. */
+PW_TOAST_API void pw_toast_blend_bgrx8(uint8_t *dst_bgrx, uint32_t dst_w, uint32_t dst_h,
+                                       uint32_t dst_stride, const uint8_t *toast_rgba,
+                                       uint8_t opacity);
+#endif
+
+#endif
