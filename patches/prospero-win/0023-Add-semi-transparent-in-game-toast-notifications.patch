@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_TITLE_TOAST_H
+#define PW_TITLE_TOAST_H
+#include <stdint.h>
+
+/* A short, non-blocking, semi-transparent in-game notification pill shown in
+ * the top-right corner. The title writes snapshots into the sink
+ * (pw_wine_set_toast) and win32u's PS5 Vulkan overlay (or the title's own GDI
+ * presenter) reads them with pw_wine_toast and alpha-blends them over the
+ * active frame with smooth fade-in and fade-out.
+ *
+ * Pointer-free wire layout, identical across modules. Text is ASCII,
+ * NUL-terminated. */
+enum {
+    PW_TITLE_TOAST_COLUMNS = 64,
+    PW_TITLE_TOAST_ACCENT_MINT = 0,
+    PW_TITLE_TOAST_ACCENT_AMBER = 1,
+    PW_TITLE_TOAST_ACCENT_CORAL = 2,
+};
+
+struct pw_title_toast
+{
+    uint32_t version;       /* PW_TITLE_TOAST_VERSION */
+    uint32_t sequence;      /* the sink's: incremented on every update */
+    uint32_t visible;       /* 0: draw nothing */
+    uint32_t accent;        /* PW_TITLE_TOAST_ACCENT_* */
+    uint32_t duration_ms;   /* total lifetime including fades (ms) */
+    uint32_t reserved;
+    uint64_t created_ns;    /* CLOCK_MONOTONIC timestamp in ns */
+    char line1[PW_TITLE_TOAST_COLUMNS];
+    char line2[PW_TITLE_TOAST_COLUMNS];
+};
+
+#define PW_TITLE_TOAST_VERSION 1u
+
+#endif
