+static void test_toast(void)
+{
+    struct pw_title_toast got,toast;
+    memset(&got,0xa5,sizeof(got));
+    pw_wine_toast(&got);
+    assert(got.version==PW_TITLE_TOAST_VERSION && !got.visible && !got.line1[0]);
+    pw_wine_toast(NULL);
+
+    memset(&toast,0,sizeof(toast));
+    toast.visible=1;toast.accent=PW_TITLE_TOAST_ACCENT_AMBER;toast.duration_ms=3300;
+    toast.created_ns=123456789ull;
+    strcpy(toast.line1,"PC K+M ACTIVE");strcpy(toast.line2,"F9 MENU");
+    pw_wine_set_toast(&toast);
+    pw_wine_toast(&got);
+    assert(got.version==PW_TITLE_TOAST_VERSION && got.sequence==1 && got.visible==1);
+    assert(got.accent==PW_TITLE_TOAST_ACCENT_AMBER && got.duration_ms==3300);
+    assert(got.created_ns==123456789ull && !strcmp(got.line1,"PC K+M ACTIVE") && !strcmp(got.line2,"F9 MENU"));
+
+    /* Re-posting increments sequence so repeated notifications refresh fade-in. */
+    pw_wine_set_toast(&toast);
+    pw_wine_toast(&got);
+    assert(got.sequence==2);
+
+    /* Out-of-range accent and duration are clamped; strings terminated. */
+    toast.accent=99;toast.duration_ms=50;
+    memset(toast.line1,'A',sizeof(toast.line1));
+    memset(toast.line2,'B',sizeof(toast.line2));
+    pw_wine_set_toast(&toast);
+    pw_wine_toast(&got);
+    assert(got.sequence==3 && got.accent==PW_TITLE_TOAST_ACCENT_MINT && got.duration_ms==500);
+    assert(strlen(got.line1)==PW_TITLE_TOAST_COLUMNS-1 && strlen(got.line2)==PW_TITLE_TOAST_COLUMNS-1);
+
+    /* Clearing hides toast; clearing again keeps sequence unchanged. */
+    pw_wine_set_toast(NULL);
+    pw_wine_toast(&got);
+    assert(!got.visible && !got.line1[0]);
+    pw_wine_set_toast(NULL);
+    pw_wine_toast(&got);
+    assert(!got.visible);
+}
+
 int main(void)
 {
     uint32_t frame[4*3];
@@ -327,5 +368,6 @@ int main(void)
     assert(!pw_wine_rumble(&left,NULL) && left==0xffff);
     test_display_release();
     test_menu();
+    test_toast();
     return 0;
 }
