From 090066b29ea19bd5c9a79831752bf3188d0af17a Mon Sep 17 00:00:00 2001
From: TrinityXSX <trinityxsx@users.noreply.github.com>
Date: Thu, 26 Nov 2026 08:39:41 +0100
Subject: [PATCH] TrinityXSX: add 1-button restart, VKD3D feature level, shader


The library part of this change (crates/xcl/src/library*.rs) now lives
in TrinityXSX's library/ folder; see the last TrinityXSX patch.
---
 crates/xcl/src/config.rs | 4 ++++
 crates/xcl/src/host.rs   | 5 +++++
 2 files changed, 9 insertions(+)

diff --git a/crates/xcl/src/config.rs b/crates/xcl/src/config.rs
index 7bdaa21..46f5f45 100644
--- a/crates/xcl/src/config.rs
+++ b/crates/xcl/src/config.rs
@@ -79,6 +79,9 @@ pub struct Config {
     /// Optional direct DXIL mode ("", "1", or "all") – sets `XCL_DIRECT_DXIL` when unset.
     /// Useful under runtimes that restrict custom environment variables (e.g. prospero-win).
     pub direct_dxil: String,
+    /// Optional vkd3d-proton D3D12 feature level override ("", "12_0", or "12_1") – sets
+    /// `VKD3D_FEATURE_LEVEL` when unset (useful for games requiring FL 12_0 on PS5 RADV).
+    pub vkd3d_feature_level: String,
     /// Network access for the title (default true). False sets `XCL_NETWORK=0` when unset.
     pub network: bool,
     /// Periodic 2 s activity & memory log (`XCL_ACTIVITY=1`).
@@ -210,6 +213,7 @@ impl Default for Config {
             keyboard_mouse: true,
             mouse_sensitivity: 1.0,
             direct_dxil: String::new(),
+            vkd3d_feature_level: String::new(),
             network: true,
             activity: false,
             trace_input: false,
diff --git a/crates/xcl/src/host.rs b/crates/xcl/src/host.rs
index ee30af5..032c593 100644
--- a/crates/xcl/src/host.rs
+++ b/crates/xcl/src/host.rs
@@ -41,6 +41,11 @@ pub fn host_main(boot_path: &Path) -> i32 {
     if std::env::var_os("XCL_DIRECT_DXIL").is_none() && !boot.config.direct_dxil.is_empty() {
         std::env::set_var("XCL_DIRECT_DXIL", &boot.config.direct_dxil);
     }
+    if std::env::var_os("VKD3D_FEATURE_LEVEL").is_none() && !boot.config.vkd3d_feature_level.trim().is_empty() {
+        let fl = boot.config.vkd3d_feature_level.trim();
+        std::env::set_var("VKD3D_FEATURE_LEVEL", fl);
+        crate::xlog_info!("vkd3d-proton: VKD3D_FEATURE_LEVEL={fl}");
+    }
     if std::env::var_os("XCL_NETWORK").is_none() && !boot.config.network {
         std::env::set_var("XCL_NETWORK", "0");
     }
-- 
2.48.1.windows.1

