+fn sanitize_zip_rel_path(raw: &str) -> Option<PathBuf> {
+    let norm = raw.replace('\\', "/");
+    if norm.is_empty() || norm.starts_with('/') || norm.contains(':') {
+        return None;
+    }
+    let mut out = PathBuf::new();
+    for seg in norm.split('/') {
+        match seg {
+            "" | "." => continue,
+            ".." => return None,
+            part => out.push(part),
+        }
+    }
+    if out.as_os_str().is_empty() {
+        None
+    } else {
+        Some(out)
+    }
+}
