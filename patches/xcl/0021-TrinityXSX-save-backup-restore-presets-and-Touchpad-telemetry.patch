From 20e4f6ed290ea0451efa5f5e1d0ea483bf4cb1be Mon Sep 17 00:00:00 2001
From: TrinityXSX <trinityxsx@users.noreply.github.com>
Date: Thu, 26 Nov 2026 08:39:39 +0100
Subject: [PATCH] TrinityXSX: add save backup/restore ZIP, compatibility

The library part of this change (crates/xcl/src/library*.rs) now lives
in TrinityXSX's library/ folder; see the last TrinityXSX patch.
---
 crates/xcl/src/host.rs | 102 +++++++++++++++++++++++++++++------------
 1 file changed, 73 insertions(+), 29 deletions(-)

diff --git a/crates/xcl/src/host.rs b/crates/xcl/src/host.rs
index 80920ae..825d4ae 100644
--- a/crates/xcl/src/host.rs
+++ b/crates/xcl/src/host.rs
@@ -123,16 +123,83 @@ pub fn host_main(boot_path: &Path) -> i32 {
         let _ = std::thread::Builder::new().name("xcl-stall-watch".into()).spawn(|| {
             const INITIAL_STALL_SECS: u64 = 30;
             const RUNTIME_STALL_SECS: u64 = 15;
+            let ps5_root = std::path::Path::new("Z:\\data\\homebrew\\PPSA83601");
+            let hud_path = ps5_root.join("hud_stats.txt");
+            let req_path = ps5_root.join("dump_diag.req");
+            let diag_path = ps5_root.join("diag_dump.log");
             let mut last_presents = crate::hle::d3d12x::present::activity().0;
+            let mut last_fps_presents = last_presents;
+            let mut last_fps_at = std::time::Instant::now();
             let mut last_progress = std::time::Instant::now();
             let mut reported_stall = false;
+            let mut tick: u64 = 0;
+
+            let format_telemetry = |phase: &str, elapsed_s: u64| -> String {
+                let (presents, submits) = crate::hle::d3d12x::present::activity();
+                let (draws, dispatches) = crate::hle::d3d12x::bind::activity();
+                let f = crate::hle::d3d12x::frame::activity();
+                let (ds_req, ds_bytes, ds_fail) = crate::hle::dstorage::counters();
+                let (local, non_local) = crate::hle::d3d12x::real::video_memory().unwrap_or((0, 0));
+                let (arenas, arenas_made) = crate::hle::d3d12x::vram::arena_bytes();
+                let (pools, pools_mapped) = crate::hle::d3d12x::sparse::pool_bytes();
+                format!(
+                    "phase={phase}, idle={elapsed_s}s, presents={presents}, submits={submits}, draws={draws}, dispatches={dispatches}, frame_waits={}/{} timeouts, DirectStorage={ds_req} req/{} MiB/{ds_fail} fail, VRAM={} MiB local/{} MiB non-local, arenas={}/{} MiB, sparse={}/{} MiB",
+                    f[0],
+                    f[1],
+                    ds_bytes >> 20,
+                    local >> 20,
+                    non_local >> 20,
+                    arenas >> 20,
+                    arenas_made >> 20,
+                    pools >> 20,
+                    pools_mapped >> 20
+                )
+            };
+
             loop {
-                std::thread::sleep(std::time::Duration::from_secs(3));
-                if crate::hle::d3d12x::present::title_menu_open() {
+                std::thread::sleep(std::time::Duration::from_millis(500));
+                tick = tick.wrapping_add(1);
+
+                // Manual diagnostic dump triggered from the PS5 Touchpad Quick Menu
+                if req_path.is_file() {
+                    let _ = std::fs::remove_file(&req_path);
+                    let summary = format_telemetry("manual-dump", last_progress.elapsed().as_secs());
+                    crate::xlog_warn!("TOUCHPAD DIAG DUMP: {summary}");
+                    crate::eh::dump_threads();
+                    crate::log::flush();
+                    let _ = std::fs::write(&diag_path, format!("TrinityXSX Touchpad Diagnostic Dump\n{summary}\n"));
+                }
+
+                let menu_open = crate::hle::d3d12x::present::title_menu_open();
+                let (presents, _) = crate::hle::d3d12x::present::activity();
+
+                // Update compact 1-line HUD telemetry every ~1s while game is running (not paused in menu)
+                if !menu_open && tick.is_multiple_of(2) && ps5_root.is_dir() {
+                    let dt = last_fps_at.elapsed().as_secs_f64();
+                    if dt >= 0.9 {
+                        let df = presents.saturating_sub(last_fps_presents) as f64;
+                        let fps = df / dt;
+                        let ms = if fps > 0.05 { 1000.0 / fps } else { 0.0 };
+                        let (local, non_local) = crate::hle::d3d12x::real::video_memory().unwrap_or((0, 0));
+                        let line = if presents == 0 {
+                            format!("LOADING  |  VRAM {}+{} MB  |  FRAME 0\n", local >> 20, non_local >> 20)
+                        } else if fps < 0.05 {
+                            format!("0.0 FPS (STALLED)  |  VRAM {}+{} MB  |  FRAME {}\n", local >> 20, non_local >> 20, presents)
+                        } else {
+                            format!("{fps:.1} FPS  |  {ms:.1} MS  |  VRAM {}+{} MB  |  FRAME {presents}\n", local >> 20, non_local >> 20)
+                        };
+                        let _ = std::fs::write(&hud_path, line);
+                        last_fps_presents = presents;
+                        last_fps_at = std::time::Instant::now();
+                    }
+                }
+
+                if menu_open {
                     last_progress = std::time::Instant::now();
+                    last_fps_presents = presents;
+                    last_fps_at = std::time::Instant::now();
                     continue;
                 }
-                let (presents, submits) = crate::hle::d3d12x::present::activity();
                 if presents != last_presents {
                     if reported_stall {
                         crate::xlog_info!("STALL: rendering resumed (presents={presents})");
@@ -145,32 +212,9 @@ pub fn host_main(boot_path: &Path) -> i32 {
                 let threshold = if presents == 0 { INITIAL_STALL_SECS } else { RUNTIME_STALL_SECS };
                 if !reported_stall && last_progress.elapsed().as_secs() >= threshold {
                     reported_stall = true;
-                    let (draws, dispatches) = crate::hle::d3d12x::bind::activity();
-                    let f = crate::hle::d3d12x::frame::activity();
-                    let (ds_req, ds_bytes, ds_fail) = crate::hle::dstorage::counters();
-                    let (local, non_local) = crate::hle::d3d12x::real::video_memory().unwrap_or((0, 0));
-                    let (arenas, arenas_made) = crate::hle::d3d12x::vram::arena_bytes();
-                    let (pools, pools_mapped) = crate::hle::d3d12x::sparse::pool_bytes();
-                    crate::xlog_warn!(
-                        "STALL: no new frame for {} s (phase={}, presents={}, submits={}, draws={}, dispatches={}, frame_waits={}/{} timeouts, DirectStorage={} req/{} MiB/{} fail, VRAM={} MiB local/{} MiB non-local, arenas={}/{} MiB, sparse={}/{} MiB)",
-                        last_progress.elapsed().as_secs(),
-                        if presents == 0 { "initial-loading" } else { "in-game" },
-                        presents,
-                        submits,
-                        draws,
-                        dispatches,
-                        f[0],
-                        f[1],
-                        ds_req,
-                        ds_bytes >> 20,
-                        ds_fail,
-                        local >> 20,
-                        non_local >> 20,
-                        arenas >> 20,
-                        arenas_made >> 20,
-                        pools >> 20,
-                        pools_mapped >> 20
-                    );
+                    let phase = if presents == 0 { "initial-loading" } else { "in-game" };
+                    let summary = format_telemetry(phase, last_progress.elapsed().as_secs());
+                    crate::xlog_warn!("STALL: no new frame ({summary})");
                     crate::eh::dump_threads();
                     crate::log::flush();
                 }
-- 
2.48.1.windows.1

