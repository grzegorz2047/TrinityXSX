+/// The title's command line when the host runs in the launcher's process (`xcl run
+/// --in-process`): NUL-terminated wide and ANSI copies, kept for the process's lifetime.
+static COMMAND_LINE: std::sync::OnceLock<CommandLines> = std::sync::OnceLock::new();
+/// The wide and the ANSI command line, each NUL-terminated.
+type CommandLines = (Box<[u16]>, Box<[u8]>);
+
+/// `xcl run --in-process`: the command line GetCommandLineW / GetCommandLineA hand the title,
+/// also written to the UCRT's cached copies (`_wcmdln` / `_acmdln`), which a title's CRT
+/// startup builds argv from. Without it (a host process of its own) Windows' line is the title's.
+pub fn set_command_line(line: &str) {
+    let w: Box<[u16]> = line.encode_utf16().chain(Some(0)).collect();
+    let mut a = vec![0u8; line.len() * 4 + 1];
+    let n = unsafe { write_ansi_out(line, a.as_mut_ptr(), a.len() as u32) } as usize;
+    a.truncate(n + 1);
+    let (w, a) = COMMAND_LINE.get_or_init(|| (w, a.into_boxed_slice()));
+    unsafe { set_ucrt_command_line(w.as_ptr(), a.as_ptr()) };
+}
+
+unsafe fn set_ucrt_command_line(w: *const u16, a: *const u8) {
+    let ucrt = ll::GetModuleHandleW(crate::util::wide("ucrtbase.dll").as_ptr());
+    if ucrt.is_null() {
+        return;
+    }
+    type Wide = unsafe extern "C" fn() -> *mut *const u16;
+    type Ansi = unsafe extern "C" fn() -> *mut *const u8;
+    if let Some(f) = ll::GetProcAddress(ucrt, c"__p__wcmdln".as_ptr().cast()) {
+        *std::mem::transmute::<unsafe extern "system" fn() -> isize, Wide>(f)() = w;
+    }
+    if let Some(f) = ll::GetProcAddress(ucrt, c"__p__acmdln".as_ptr().cast()) {
+        *std::mem::transmute::<unsafe extern "system" fn() -> isize, Ansi>(f)() = a;
+    }
+}
+
+/// # Safety
+/// No preconditions: it is `unsafe` only as the `kernel32` export the title calls.
+pub unsafe extern "system" fn GetCommandLineW() -> *const u16 {
+    match COMMAND_LINE.get() {
+        Some((w, _)) => w.as_ptr(),
+        None => windows_sys::Win32::System::Environment::GetCommandLineW(),
+    }
+}
+
+/// # Safety
+/// No preconditions: it is `unsafe` only as the `kernel32` export the title calls.
+pub unsafe extern "system" fn GetCommandLineA() -> *const u8 {
+    match COMMAND_LINE.get() {
+        Some((_, a)) => a.as_ptr(),
+        None => windows_sys::Win32::System::Environment::GetCommandLineA(),
+    }
+}
+
