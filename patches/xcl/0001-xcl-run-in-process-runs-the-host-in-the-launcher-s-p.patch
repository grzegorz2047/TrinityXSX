+/// The host in this process (`xcl run --in-process`): Wine on the PS5 (prospero-win) runs one
+/// process per program, so the child `spawn_host` starts would not run. The title gets what the
+/// child would have: its command line (kernelx's GetCommandLineW / A and the UCRT's copy) and
+/// the game folder as the current directory. A title that ends with ExitProcess ends XCL too,
+/// so the launcher's summary is printed only when the host returns.
+fn run_host_here(cmdline: &str, cwd: &Path, boot_path: &Path) -> Result<u32, String> {
+    std::env::set_current_dir(cwd).map_err(|e| format!("{}: {e}", cwd.display()))?;
+    crate::hle::kernelx::set_command_line(cmdline);
+    Ok(crate::host::host_main(boot_path) as u32)
+}
