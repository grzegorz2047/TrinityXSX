+#[cfg(test)]
+mod trinityxsx_tests {
+    use super::*;
+    use std::ffi::{c_char, CStr};
+    use std::sync::atomic::AtomicUsize;
+
+    // title_menu_open caches its answer in a function-local static (STATE). On stock Windows
+    // that answer is always "unsupported", so setting it here is what any other caller in this
+    // process would see anyway.
+    #[test]
+    fn title_menu_reports_closed_when_ntdll_rejects_the_ps5_info_class() {
+        // Stock ntdll fails class 0x50574D01 (STATUS_INVALID_INFO_CLASS). Only the PS5 Wine
+        // runner answers it. The second and third calls take the cached "unsupported" path.
+        for _ in 0..3 {
+            assert!(!title_menu_open());
+        }
+        // A closed (or absent) menu does not hold PresentX/vkQueuePresentKHR. This would
+        // otherwise poll every 16 ms forever.
+        wait_while_title_menu_open();
+    }
+
+    // Must match the C struct the PS5 runner fills in (prospero-win
+    // wine/ps5/menu/pw_title_menu.h, read with NtQueryInformationProcess):
+    //   enum { PW_TITLE_MENU_LINES=16,PW_TITLE_MENU_COLUMNS=48 };
+    //   struct pw_title_menu
+    //   {
+    //       uint32_t version;       /* PW_TITLE_MENU_VERSION */
+    //       uint32_t sequence;      /* the sink's: changes whenever the snapshot does */
+    //       uint32_t open;          /* 0: draw nothing; the rest is then zero */
+    //       uint32_t lines;         /* lines in use, at most PW_TITLE_MENU_LINES */
+    //       int32_t selected;       /* the highlighted line, or -1 */
+    //       char title[PW_TITLE_MENU_COLUMNS];
+    //       char line[PW_TITLE_MENU_LINES][PW_TITLE_MENU_COLUMNS];
+    //   };
+    //   #define PW_TITLE_MENU_PROCESS_INFO 0x50574D01u
+    //   #define PW_TITLE_MENU_VERSION 1u
+    #[test]
+    fn title_menu_snapshot_matches_the_c_wire_layout() {
+        use std::mem::{align_of, offset_of, size_of};
+        assert_eq!(offset_of!(PwTitleMenuSnapshot, version), 0);
+        assert_eq!(offset_of!(PwTitleMenuSnapshot, sequence), 4);
+        assert_eq!(offset_of!(PwTitleMenuSnapshot, open), 8);
+        assert_eq!(offset_of!(PwTitleMenuSnapshot, lines), 12);
+        assert_eq!(offset_of!(PwTitleMenuSnapshot, selected), 16);
+        assert_eq!(offset_of!(PwTitleMenuSnapshot, title), 20);
+        assert_eq!(offset_of!(PwTitleMenuSnapshot, line), 20 + 48);
+        // 5 * 4 + 48 + 16 * 48, no tail padding (all members are 4- or 1-byte aligned)
+        assert_eq!(size_of::<PwTitleMenuSnapshot>(), 836);
+        assert_eq!(align_of::<PwTitleMenuSnapshot>(), 4);
+
+        let snap: PwTitleMenuSnapshot = unsafe { std::mem::zeroed() };
+        assert_eq!(snap.title.len(), 48);
+        assert_eq!(snap.line.len(), 16);
+        assert_eq!(snap.line[0].len(), 48);
+        let _signed_like_c: i32 = snap.selected; // int32_t, -1 = no highlighted line
+
+        assert_eq!(PW_TITLE_MENU_PROCESS_INFO, 0x5057_4D01);
+        assert_eq!(PW_TITLE_MENU_VERSION, 1);
+    }
+
+    // ---- fakes for the Vulkan loader's entry points ----
+    // Each fake has a different body, so the MSVC linker's identical-code folding (/OPT:ICF,
+    // on in release) cannot merge two of them into one address.
+
+    const FAKE_INSTANCE: usize = 0x1111_0000;
+    const FAKE_DEVICE: usize = 0x2222_0000;
+    /// a device created without VK_KHR_swapchain: its GDPA answers 0 for vkQueuePresentKHR
+    const DEVICE_WITHOUT_SWAPCHAIN: usize = 0x2222_0BAD;
+    const FAKE_QUEUE: usize = 0x3333_0000;
+    /// what the fake GIPA answers for a null name, to show the hook passes it through
+    const NULL_NAME_ANSWER: usize = 0x5555_0000;
+    const VK_SUBOPTIMAL_KHR: i32 = 1_000_001_003;
+    const VK_ERROR_OUT_OF_DATE_KHR: i32 = -1_000_001_004;
+    const VK_ERROR_UNKNOWN: i32 = -13;
+
+    // Private to this test module and touched only by the one Vulkan test below.
+    static GIPA_LAST_INSTANCE: AtomicUsize = AtomicUsize::new(0);
+    static GDPA_LAST_DEVICE: AtomicUsize = AtomicUsize::new(0);
+    static PRESENT_LAST_QUEUE: AtomicUsize = AtomicUsize::new(0);
+    static PRESENT_LAST_INFO: AtomicUsize = AtomicUsize::new(0);
+
+    unsafe extern "system" fn fake_other_command() {}
+
+    unsafe extern "system" fn fake_gipa(instance: usize, name: *const c_char) -> usize {
+        GIPA_LAST_INSTANCE.store(instance, Ordering::SeqCst);
+        if name.is_null() {
+            return NULL_NAME_ANSWER;
+        }
+        match CStr::from_ptr(name).to_bytes() {
+            b"vkGetDeviceProcAddr" => fake_gdpa as usize,
+            b"vkQueuePresentKHR" => fake_present_from_instance as usize,
+            b"vkCreateDevice" => fake_other_command as usize,
+            _ => 0,
+        }
+    }
+
+    unsafe extern "system" fn fake_gdpa(device: usize, name: *const c_char) -> usize {
+        GDPA_LAST_DEVICE.store(device, Ordering::SeqCst);
+        if name.is_null() || device == DEVICE_WITHOUT_SWAPCHAIN {
+            return 0;
+        }
+        match CStr::from_ptr(name).to_bytes() {
+            b"vkQueuePresentKHR" => fake_present_from_device as usize,
+            b"vkCmdDraw" => fake_other_command as usize,
+            _ => 0,
+        }
+    }
+
+    unsafe extern "system" fn fake_present_from_instance(queue: usize, info: *const c_void) -> i32 {
+        PRESENT_LAST_QUEUE.store(queue, Ordering::SeqCst);
+        PRESENT_LAST_INFO.store(info as usize, Ordering::SeqCst);
+        VK_SUBOPTIMAL_KHR
+    }
+
+    unsafe extern "system" fn fake_present_from_device(queue: usize, info: *const c_void) -> i32 {
+        PRESENT_LAST_QUEUE.store(queue, Ordering::SeqCst);
+        PRESENT_LAST_INFO.store(info as usize, Ordering::SeqCst);
+        VK_ERROR_OUT_OF_DATE_KHR
+    }
+
+    fn vk_name(s: &'static [u8]) -> *const c_char {
+        assert_eq!(s.last(), Some(&0), "Vulkan names are NUL-terminated");
+        s.as_ptr().cast()
+    }
+
+    unsafe fn as_proc_addr(f: usize) -> VkGetInstanceProcAddrFn {
+        std::mem::transmute::<usize, VkGetInstanceProcAddrFn>(f)
+    }
+
+    unsafe fn as_present(f: usize) -> VkQueuePresentKhrFn {
+        std::mem::transmute::<usize, VkQueuePresentKhrFn>(f)
+    }
+
+    fn reset_real_vk() {
+        REAL_VK_GIPA.store(0, Ordering::SeqCst);
+        REAL_VK_GDPA.store(0, Ordering::SeqCst);
+        REAL_VK_PRESENT.store(0, Ordering::SeqCst);
+    }
+
+    fn real_vk() -> (usize, usize, usize) {
+        (
+            REAL_VK_GIPA.load(Ordering::SeqCst),
+            REAL_VK_GDPA.load(Ordering::SeqCst),
+            REAL_VK_PRESENT.load(Ordering::SeqCst),
+        )
+    }
+
+    // REAL_VK_GIPA / REAL_VK_GDPA / REAL_VK_PRESENT are process-wide. Every check that reads or
+    // writes them is in this one test, so tests cannot race each other. Outside this test they
+    // are reached only through resolver.rs, for vulkan-1.dll / winevulkan.dll imports, and no
+    // XCL test resolves those DLLs. The test resets them to 0 at the start and at the end.
+    #[test]
+    fn vulkan_entry_points_are_wrapped_and_forward_to_the_loader() {
+        let gipa_hook = xcl_vk_get_instance_proc_addr as usize;
+        let gdpa_hook = xcl_vk_get_device_proc_addr as usize;
+        let present_hook = xcl_vk_queue_present_khr as usize;
+        let other = fake_other_command as usize;
+        reset_real_vk();
+        unsafe {
+            // Nothing resolved yet: the hooks fail safe instead of calling address 0.
+            assert_eq!(as_proc_addr(gipa_hook)(FAKE_INSTANCE, vk_name(b"vkQueuePresentKHR\0")), 0);
+            assert_eq!(as_proc_addr(gdpa_hook)(FAKE_DEVICE, vk_name(b"vkQueuePresentKHR\0")), 0);
+            assert_eq!(as_present(present_hook)(FAKE_QUEUE, std::ptr::null()), VK_ERROR_UNKNOWN);
+
+            // A missing export stays missing and is not recorded.
+            assert_eq!(wrap_vulkan_proc("vkGetInstanceProcAddr", 0), 0);
+            assert_eq!(wrap_vulkan_proc("vkGetDeviceProcAddr", 0), 0);
+            assert_eq!(wrap_vulkan_proc("vkQueuePresentKHR", 0), 0);
+            assert_eq!(real_vk(), (0, 0, 0));
+
+            // Other exports pass through untouched. Vulkan names are case-sensitive.
+            assert_eq!(wrap_vulkan_proc("vkCreateInstance", other), other);
+            assert_eq!(wrap_vulkan_proc("vkqueuepresentkhr", other), other);
+            assert_eq!(wrap_vulkan_proc("", other), other);
+            assert_eq!(real_vk(), (0, 0, 0));
+
+            // vkGetInstanceProcAddr is replaced by the hook, which asks the real one first.
+            assert_eq!(wrap_vulkan_proc("vkGetInstanceProcAddr", fake_gipa as usize), gipa_hook);
+            assert_eq!(real_vk(), (fake_gipa as usize, 0, 0));
+            let gipa = as_proc_addr(gipa_hook);
+            assert_eq!(gipa(FAKE_INSTANCE, vk_name(b"vkCreateDevice\0")), other);
+            assert_eq!(GIPA_LAST_INSTANCE.load(Ordering::SeqCst), FAKE_INSTANCE);
+            assert_eq!(gipa(FAKE_INSTANCE + 1, vk_name(b"vkNotACommand\0")), 0);
+            assert_eq!(GIPA_LAST_INSTANCE.load(Ordering::SeqCst), FAKE_INSTANCE + 1);
+            // A null name reaches the real GIPA, and its answer comes back unchanged.
+            assert_eq!(gipa(FAKE_INSTANCE, std::ptr::null()), NULL_NAME_ANSWER);
+            assert_eq!(real_vk(), (fake_gipa as usize, 0, 0));
+            // GIPA hands out the GDPA and present hooks and records the real addresses.
+            assert_eq!(gipa(FAKE_INSTANCE, vk_name(b"vkGetDeviceProcAddr\0")), gdpa_hook);
+            assert_eq!(REAL_VK_GDPA.load(Ordering::SeqCst), fake_gdpa as usize);
+            assert_eq!(gipa(FAKE_INSTANCE, vk_name(b"vkQueuePresentKHR\0")), present_hook);
+            assert_eq!(REAL_VK_PRESENT.load(Ordering::SeqCst), fake_present_from_instance as usize);
+
+            // vkGetDeviceProcAddr through the hook
+            let gdpa = as_proc_addr(gdpa_hook);
+            assert_eq!(gdpa(FAKE_DEVICE, vk_name(b"vkCmdDraw\0")), other);
+            assert_eq!(GDPA_LAST_DEVICE.load(Ordering::SeqCst), FAKE_DEVICE);
+            // The real GDPA answers 0 (no swapchain): the hook answers 0 and keeps the present it has.
+            assert_eq!(gdpa(DEVICE_WITHOUT_SWAPCHAIN, vk_name(b"vkQueuePresentKHR\0")), 0);
+            assert_eq!(REAL_VK_PRESENT.load(Ordering::SeqCst), fake_present_from_instance as usize);
+            assert_eq!(gdpa(FAKE_DEVICE, vk_name(b"vkQueuePresentKHR\0")), present_hook);
+            assert_eq!(REAL_VK_PRESENT.load(Ordering::SeqCst), fake_present_from_device as usize);
+
+            // vkGetDeviceProcAddr / vkQueuePresentKHR imported directly (resolver path)
+            assert_eq!(wrap_vulkan_proc("vkGetDeviceProcAddr", fake_gdpa as usize), gdpa_hook);
+            assert_eq!(REAL_VK_GDPA.load(Ordering::SeqCst), fake_gdpa as usize);
+            assert_eq!(wrap_vulkan_proc("vkQueuePresentKHR", fake_present_from_instance as usize), present_hook);
+            assert_eq!(REAL_VK_PRESENT.load(Ordering::SeqCst), fake_present_from_instance as usize);
+
+            // The hooked present writes PS5 HUD telemetry if this folder exists. Never do that
+            // from a test.
+            if std::path::Path::new(r"Z:\data\homebrew\PPSA83601").is_dir() {
+                eprintln!("skipping hooked-present calls: PS5 homebrew folder present on Z:");
+                reset_real_vk();
+                return;
+            }
+
+            // The hooked present calls the real one with the title's arguments and returns its
+            // result (non-success codes included). It also counts the frame.
+            let before = presents();
+            let info = 0x4444_0000usize as *const c_void; // passed through, never dereferenced
+            assert_eq!(as_present(present_hook)(FAKE_QUEUE, info), VK_SUBOPTIMAL_KHR);
+            assert_eq!(PRESENT_LAST_QUEUE.load(Ordering::SeqCst), FAKE_QUEUE);
+            assert_eq!(PRESENT_LAST_INFO.load(Ordering::SeqCst), info as usize);
+            assert!(presents() > before, "a hooked Vulkan present counts as a shown frame");
+
+            REAL_VK_PRESENT.store(fake_present_from_device as usize, Ordering::SeqCst);
+            assert_eq!(as_present(present_hook)(FAKE_QUEUE + 8, std::ptr::null()), VK_ERROR_OUT_OF_DATE_KHR);
+            assert_eq!(PRESENT_LAST_QUEUE.load(Ordering::SeqCst), FAKE_QUEUE + 8);
+            assert_eq!(PRESENT_LAST_INFO.load(Ordering::SeqCst), 0);
+        }
+        reset_real_vk();
+    }
+}
