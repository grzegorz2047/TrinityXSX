--- /dev/null
+++ b/crates/xcl/tests/trinityxsx_no_uma.rs
@@ -0,0 +1,22 @@
+//! `XCL_NO_UMA` (TrinityXSX, set for standalone Win64 executables): the unified memory is not
+//! reserved. The UMA is a process-wide `OnceLock`, so the check runs in a child process of this
+//! test binary, where nothing else has touched it.
+
+use std::process::Command;
+
+const CHILD: &str = "XCL_TEST_NO_UMA_CHILD";
+
+#[test]
+fn no_uma_skips_the_unified_memory_reservation() {
+    if std::env::var_os(CHILD).is_some() {
+        assert!(xcl::gpu::uma::get().is_none(), "the UMA was reserved although XCL_NO_UMA is set");
+        return;
+    }
+    let status = Command::new(std::env::current_exe().unwrap())
+        .args(["no_uma_skips_the_unified_memory_reservation", "--exact", "--nocapture", "--test-threads=1"])
+        .env(CHILD, "1")
+        .env("XCL_NO_UMA", "1")
+        .status()
+        .unwrap();
+    assert!(status.success(), "child test failed: {status}");
+}
