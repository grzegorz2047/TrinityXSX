+//! WASAPI compatibility for console clients. FMOD's GameCore backend passes bit 0x01000000
+//! to IAudioClient::Initialize; Wine rejects it before creating a stream. Only retry that
+//! rejected request without the extra bit; preserve accepted requests and all other flags.
+
+use std::ffi::c_void;
+use std::sync::{Mutex, Once};
+
+use crate::util::{E_INVALIDARG, HRESULT};
+
+const INITIALIZE: usize = 3;
+const CONSOLE_STREAM_FLAG: u32 = 0x0100_0000;
+type Initialize = unsafe extern "system" fn(*mut c_void, u32, u32, i64, i64, *const c_void, *const c_void) -> HRESULT;
+static ORIGINALS: Mutex<Vec<(usize, usize)>> = Mutex::new(Vec::new());
+
+unsafe extern "system" fn initialize(
+    this: *mut c_void, mode: u32, flags: u32, duration: i64, period: i64,
+    format: *const c_void, session: *const c_void,
+) -> HRESULT {
+    let vt = *(this as *const usize);
+    let original = ORIGINALS.lock().unwrap().iter().find(|&&(v, _)| v == vt).map(|&(_, f)| f);
+    let Some(original) = original else { return 0x8000_FFFFu32 as i32 };
+    let call: Initialize = std::mem::transmute(original);
+    let hr = call(this, mode, flags, duration, period, format, session);
+    if hr == E_INVALIDARG && flags & CONSOLE_STREAM_FLAG != 0 {
+        let retried = call(this, mode, flags & !CONSOLE_STREAM_FLAG, duration, period, format, session);
+        static LOGGED: Once = Once::new();
+        LOGGED.call_once(|| crate::xlog_info!("WASAPI: Initialize rejected flags {flags:#x}; retry without {CONSOLE_STREAM_FLAG:#x} -> {:#x}", retried as u32));
+        retried
+    } else {
+        hr
+    }
+}
+
+unsafe fn patch_client(client: *mut c_void) -> bool {
+    use windows_sys::Win32::System::LibraryLoader::{GetModuleHandleExW, GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, GET_MODULE_HANDLE_EX_FLAG_PIN};
+    use windows_sys::Win32::System::Memory::{VirtualProtect, PAGE_READWRITE};
+    let vt = *(client as *const *mut usize);
+    let slot = vt.add(INITIALIZE);
+    let mut originals = ORIGINALS.lock().unwrap();
+    if originals.iter().any(|&(v, _)| v == vt as usize) {
+        return true;
+    }
+    let original = slot.read();
+    // The client is released after installation; keep its implementation loaded for the hook.
+    let mut module = std::ptr::null_mut();
+    if GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+        original as *const u16, &mut module) == 0 {
+        return false;
+    }
+    let mut protection = 0;
+    if VirtualProtect(slot as *const c_void, std::mem::size_of::<usize>(), PAGE_READWRITE, &mut protection) == 0 {
+        return false;
+    }
+    originals.push((vt as usize, original));
+    slot.write(initialize as usize);
+    VirtualProtect(slot as *const c_void, std::mem::size_of::<usize>(), protection, &mut protection);
+    true
+}
+
+/// Install on the system audio client's shared vtable without starting a stream.
+pub fn install() {
+    static INSTALLED: Once = Once::new();
+    INSTALLED.call_once(|| unsafe {
+        use windows::core::Interface;
+        use windows::Win32::Media::Audio::{eConsole, eRender, IAudioClient, IMMDeviceEnumerator, MMDeviceEnumerator};
+        use windows::Win32::System::Com::{CoCreateInstance, CoInitializeEx, CoUninitialize, CLSCTX_ALL, COINIT_MULTITHREADED};
+        let initialized = CoInitializeEx(None, COINIT_MULTITHREADED).is_ok();
+        let installed = (|| {
+            let enumerator: IMMDeviceEnumerator = CoCreateInstance(&MMDeviceEnumerator, None, CLSCTX_ALL).ok()?;
+            let device = enumerator.GetDefaultAudioEndpoint(eRender, eConsole).ok()?;
+            let client: IAudioClient = device.Activate(CLSCTX_ALL, None).ok()?;
+            Some(patch_client(client.as_raw()))
+        })().unwrap_or(false);
+        if initialized {
+            CoUninitialize();
+        }
+        if installed {
+            crate::xlog_info!("WASAPI: console stream flag compatibility installed");
+        } else {
+            crate::xlog_info!("WASAPI: compatibility hook unavailable (no default audio client or writable vtable)");
+        }
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::util::S_OK;
+
+    #[repr(C)]
+    struct Client {
+        vtable: *mut usize,
+        calls: Vec<u32>,
+        accepts_extra: bool,
+        error: HRESULT,
+    }
+
+    unsafe extern "system" fn system_initialize(
+        this: *mut c_void, mode: u32, flags: u32, duration: i64, period: i64,
+        format: *const c_void, session: *const c_void,
+    ) -> HRESULT {
+        assert_eq!((mode, duration, period, format as usize, session as usize), (0, 300000, 100000, 0x1230, 0x4560));
+        let client = &mut *(this as *mut Client);
+        client.calls.push(flags);
+        if client.error != S_OK {
+            client.error
+        } else if flags & 0x0200_0000 != 0 || (!client.accepts_extra && flags & CONSOLE_STREAM_FLAG != 0) {
+            E_INVALIDARG
+        } else {
+            S_OK
+        }
+    }
+
+    unsafe fn invoke(client: &mut Client, flags: u32) -> HRESULT {
+        let call: Initialize = std::mem::transmute(*client.vtable.add(INITIALIZE));
+        call(client as *mut Client as *mut c_void, 0, flags, 300000, 100000, 0x1230 as _, 0x4560 as _)
+    }
+
+    #[test]
+    fn rejected_console_initialize_retries_real_client_without_losing_flags_or_errors() {
+        unsafe {
+            // Keep the test vtable alive because the hook registry retains its address.
+            let vtable = Box::leak(Box::new([0, 0, 0, system_initialize as usize])).as_mut_ptr();
+            let mut client = Client { vtable, calls: Vec::new(), accepts_extra: false, error: S_OK };
+            let flags = CONSOLE_STREAM_FLAG | 0x40000;
+            assert_eq!(invoke(&mut client, flags), E_INVALIDARG);
+            client.calls.clear();
+            assert!(patch_client(&mut client as *mut Client as *mut c_void));
+            assert_eq!(invoke(&mut client, flags), S_OK);
+            assert_eq!(client.calls, [flags, 0x40000]);
+
+            client.calls.clear();
+            client.accepts_extra = true;
+            assert_eq!(invoke(&mut client, flags), S_OK);
+            assert_eq!(client.calls, [flags], "a host accepting the flag is unchanged");
+
+            client.calls.clear();
+            client.error = 0x8889_0008u32 as i32;
+            assert_eq!(invoke(&mut client, flags), client.error);
+            assert_eq!(client.calls, [flags], "format and device failures are not retried");
+
+            client.calls.clear();
+            client.error = S_OK;
+            assert_eq!(invoke(&mut client, 0x0204_0000), E_INVALIDARG);
+            assert_eq!(client.calls, [0x0204_0000], "other unknown flags remain rejected");
+        }
+    }
+}
