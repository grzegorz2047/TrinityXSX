 crates/xcl/src/library_i18n.rs |   6 ++
 crates/xcl/src/library_menu.rs |  97 +++++++++++++++++---
 3 files changed, 251 insertions(+), 14 deletions(-)

diff --git a/crates/xcl/src/library.rs b/crates/xcl/src/library.rs
index 08255e1..3babaa7 100644
--- a/crates/xcl/src/library.rs
+++ b/crates/xcl/src/library.rs
@@ -979,6 +979,143 @@ pub fn ui_settings_file() -> PathBuf {
     launcher::data_root().join("ui_settings.toml")
