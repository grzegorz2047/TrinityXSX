diff --git a/crates/xcl/src/debug_tools.rs b/crates/xcl/src/debug_tools.rs
new file mode 100644
index 0000000..29568f8
--- /dev/null
+++ b/crates/xcl/src/debug_tools.rs
@@ -0,0 +1,179 @@
+//! Runtime debugging & live diagnostics for titles (especially under runtimes like
+//! `prospero-win` on PS5 where interactive debuggers and custom `XCL_*` env vars are unavailable).
+//!
+//! Configured through `xcl.toml`:
+//! * `trace_input = true`: logs XUser device-association execution, XTaskQueue port modes,
+//!   XUser privilege/device queries, and GameInput button edges.
+//! * `trace_net = true`: logs up to 128 unique blocked network targets under `XCL_NETWORK=0`.
+//! * `trace_vfs = "minecraftWorlds,hbui,options"`: logs VFS file opens matching any substring.
+//! * `sw_probes = ["0x106b940", ...]`: installs `retour::RawDetour` software call probes on up to
+//!   8 function-entry RVAs in the main title module (works without hardware debug registers).
+//! * `live_flush = true`: flushes `xcl.log` on every INFO line for live FTP inspection.
+
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+use retour::RawDetour;
+
+use crate::config::Config;
+
+static TRACE_INPUT: AtomicBool = AtomicBool::new(false);
+static TRACE_NET: AtomicBool = AtomicBool::new(false);
+static LIVE_FLUSH: AtomicBool = AtomicBool::new(false);
+static VFS_FILTERS: OnceLock<Vec<String>> = OnceLock::new();
+
+pub fn init(cfg: &Config) {
+    TRACE_INPUT.store(cfg.trace_input, Ordering::Release);
+    TRACE_NET.store(cfg.trace_net, Ordering::Release);
+    LIVE_FLUSH.store(cfg.live_flush, Ordering::Release);
+    let filters: Vec<String> = cfg
+        .trace_vfs
+        .split(',')
+        .map(|s| s.trim().to_ascii_lowercase())
+        .filter(|s| !s.is_empty())
+        .collect();
+    let _ = VFS_FILTERS.set(filters.clone());
+    if cfg.trace_input || cfg.trace_net || cfg.live_flush || !filters.is_empty() || !cfg.sw_probes.is_empty() || cfg.activity {
+        crate::xlog_info!(
+            "debug: active (activity={}, trace_input={}, trace_net={}, live_flush={}, trace_vfs={:?}, sw_probes={:?})",
+            cfg.activity,
+            cfg.trace_input,
+            cfg.trace_net,
+            cfg.live_flush,
+            filters,
+            cfg.sw_probes
+        );
+    }
+}
+
+pub fn trace_input() -> bool {
+    TRACE_INPUT.load(Ordering::Acquire)
+}
+
+pub fn trace_net() -> bool {
+    TRACE_NET.load(Ordering::Acquire)
+}
+
+pub fn live_flush() -> bool {
+    LIVE_FLUSH.load(Ordering::Acquire)
+}
+
+pub fn matches_vfs_filter(path: &str) -> bool {
+    let Some(filters) = VFS_FILTERS.get() else { return false };
+    if filters.is_empty() {
+        return false;
+    }
+    let lower = path.to_ascii_lowercase();
+    filters.iter().any(|f| lower.contains(f.as_str()))
+}
+
+// ---------------------------------------------------------------------------------------
+// Software function-entry call probes (up to 8 RVAs in main module via retour::RawDetour)
+// ---------------------------------------------------------------------------------------
+
+const MAX_SW_PROBES: usize = 8;
+
+static PROBE_ORIG: [AtomicUsize; MAX_SW_PROBES] = [const { AtomicUsize::new(0) }; MAX_SW_PROBES];
+static PROBE_ADDR: [AtomicUsize; MAX_SW_PROBES] = [const { AtomicUsize::new(0) }; MAX_SW_PROBES];
+static PROBE_HITS: [AtomicUsize; MAX_SW_PROBES] = [const { AtomicUsize::new(0) }; MAX_SW_PROBES];
+static PROBE_LINES: [AtomicUsize; MAX_SW_PROBES] = [const { AtomicUsize::new(0) }; MAX_SW_PROBES];
+static PROBE_LAST_SIG: Mutex<[(u64, u64, u64, u64); MAX_SW_PROBES]> = Mutex::new([(u64::MAX, u64::MAX, u64::MAX, u64::MAX); MAX_SW_PROBES]);
+
+type ProbeFn = unsafe extern "system" fn(u64, u64, u64, u64, u64, u64) -> u64;
+
+unsafe fn read_u64s(ptr: u64) -> Option<[u64; 3]> {
+    let p = ptr as usize;
+    if p < 0x10000 || !crate::gpu::shader::readable(p, 24) {
+        return None;
+    }
+    let s = p as *const u64;
+    Some([s.read_unaligned(), s.add(1).read_unaligned(), s.add(2).read_unaligned()])
+}
+
+unsafe fn probe_enter(idx: usize, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> u64 {
+    let orig_addr = PROBE_ORIG[idx].load(Ordering::Acquire);
+    let orig: ProbeFn = std::mem::transmute(orig_addr);
+    let hit = PROBE_HITS[idx].fetch_add(1, Ordering::Relaxed) + 1;
+    let m1 = read_u64s(a1);
+    let m3 = read_u64s(a3);
+    let sig = (a4 & 0xFFFF_FFFF, a5 & 0xFF, a6 & 0xFF, m3.map_or(0, |v| v[0]));
+    let changed = {
+        let mut g = PROBE_LAST_SIG.lock().unwrap_or_else(|e| e.into_inner());
+        let diff = g[idx] != sig;
+        if diff {
+            g[idx] = sig;
+        }
+        diff
+    };
+    let should_log = hit <= 16 || (changed && PROBE_LINES[idx].load(Ordering::Relaxed) < 64) || hit.is_multiple_of(256);
+    let ret = orig(a1, a2, a3, a4, a5, a6);
+    if should_log && PROBE_LINES[idx].fetch_add(1, Ordering::Relaxed) < 80 {
+        let addr = PROBE_ADDR[idx].load(Ordering::Relaxed);
+        let desc = crate::modules::describe_address(addr);
+        let m1_str = match m1 {
+            Some([q0, q1, q2]) => format!(" [rcx]={q0:#x},{q1:#x},{q2:#x}"),
+            None => String::new(),
+        };
+        let m3_str = match m3 {
+            Some([q0, q1, q2]) => format!(" [r8]={q0:#x},{q1:#x},{q2:#x}"),
+            None => String::new(),
+        };
+        crate::xlog_info!(
+            "[SW_PROBE #{idx}] {desc} hit #{hit}: rcx={a1:#x} rdx={a2:#x} r8={a3:#x} r9={a4:#x} s5={:#x} s6={:#x}{m1_str}{m3_str} → ret={ret:#x}",
+            a5 & 0xFFFF_FFFF,
+            a6 & 0xFFFF_FFFF
+        );
+    }
+    ret
+}
+
+unsafe extern "system" fn sw_probe_trampoline<const IDX: usize>(a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> u64 {
+    probe_enter(IDX, a1, a2, a3, a4, a5, a6)
+}
+
+const TRAMPOLINES: [ProbeFn; MAX_SW_PROBES] = [
+    sw_probe_trampoline::<0>,
+    sw_probe_trampoline::<1>,
+    sw_probe_trampoline::<2>,
+    sw_probe_trampoline::<3>,
+    sw_probe_trampoline::<4>,
+    sw_probe_trampoline::<5>,
+    sw_probe_trampoline::<6>,
+    sw_probe_trampoline::<7>,
+];
+
+/// Install software call probes on up to `MAX_SW_PROBES` function-entry RVAs of the main module.
+///
+/// # Safety
+/// `main_base` must be the base of the mapped main module and each RVA the entry of a function in
+/// it: the probes patch the code there and stay installed for the life of the process.
+pub unsafe fn install_sw_probes(main_base: usize, rvas: &[String]) {
+    let mut slot = 0usize;
+    for raw in rvas {
+        if slot >= MAX_SW_PROBES {
+            crate::xlog_warn!("sw_probes: max {MAX_SW_PROBES} probes supported; ignoring {raw:?}");
+            break;
+        }
+        let cleaned = raw.trim().trim_start_matches("0x").trim_start_matches("0X");
+        let Ok(rva) = usize::from_str_radix(cleaned, 16) else {
+            crate::xlog_warn!("sw_probes: invalid hex RVA {raw:?}");
+            continue;
+        };
+        let target = main_base + rva;
+        match RawDetour::new(target as *const (), TRAMPOLINES[slot] as *const ()) {
+            Ok(d) => {
+                PROBE_ADDR[slot].store(target, Ordering::Release);
+                PROBE_ORIG[slot].store(d.trampoline() as *const () as usize, Ordering::Release);
+                match d.enable() {
+                    Ok(()) => {
+                        Box::leak(Box::new(d));
+                        crate::xlog_info!("sw_probe #{slot} active at {} ({target:#x})", crate::modules::describe_address(target));
+                        slot += 1;
+                    }
+                    Err(e) => crate::xlog_warn!("sw_probe enable at +{rva:#x} failed: {e}"),
+                }
+            }
+            Err(e) => crate::xlog_warn!("sw_probe detour at +{rva:#x} failed: {e}"),
+        }
+    }
+}
