diff --git a/crates/xcl/src/hle/xgameruntime/taskqueue.rs b/crates/xcl/src/hle/xgameruntime/taskqueue.rs
index e5565ad..1267ae3 100644
--- a/crates/xcl/src/hle/xgameruntime/taskqueue.rs
+++ b/crates/xcl/src/hle/xgameruntime/taskqueue.rs
@@ -100,6 +100,22 @@ pub struct QueueHandle {
 
 const MAGIC: u64 = 0x5843_4C51_5545_5545; // "XCLQUEUE"
 
+/// Diagnostic helper: return `(work_mode, completion_mode)` for an XCL-owned `XTaskQueueHandle`.
+///
+/// # Safety
+/// `h` is read only after `readable` and the magic check; the queue must not be freed while this
+/// runs.
+pub unsafe fn queue_modes(h: *mut c_void) -> Option<(u32, u32)> {
+    if h.is_null() || !crate::gpu::shader::readable(h as usize, std::mem::size_of::<QueueHandle>()) {
+        return None;
+    }
+    let qh = &*(h as *const QueueHandle);
+    if qh.magic != MAGIC {
+        return None;
+    }
+    Some((qh.queue.ports[0].mode, qh.queue.ports[1].mode))
+}
+
