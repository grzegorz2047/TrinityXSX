From 3ab9f9adf82e34fff29178e3d0b00fedddad20b9 Mon Sep 17 00:00:00 2001
From: TrinityXSX <trinityxsx@users.noreply.github.com>
Date: Thu, 26 Nov 2026 10:54:26 +0100
Subject: [PATCH] TrinityXSX: double-buffer library UI to eliminate list
 flicker

---
 crates/xcl/src/library_menu.rs | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/crates/xcl/src/library_menu.rs b/crates/xcl/src/library_menu.rs
index 26b27c4..fb27bdc 100644
--- a/crates/xcl/src/library_menu.rs
+++ b/crates/xcl/src/library_menu.rs
@@ -975,9 +975,20 @@ fn scroll_window(selected: usize, total: usize, visible: usize) -> usize {
 
 unsafe fn paint(window: HWND, menu: &Menu) {
     let mut ps: PAINTSTRUCT = std::mem::zeroed();
-    let dc = BeginPaint(window, &mut ps);
+    let screen_dc = BeginPaint(window, &mut ps);
     let mut client: RECT = std::mem::zeroed();
     GetClientRect(window, &mut client);
+    let width = (client.right - client.left).max(1);
+    let height = (client.bottom - client.top).max(1);
+    // Double-buffer into an offscreen memory DC and present atomically with one BitBlt
+    // so Wine/PS5 VideoOut scanout never flashes an incomplete clear or partial redraw.
+    let mem_dc = CreateCompatibleDC(screen_dc);
+    let mem_bmp = if !mem_dc.is_null() { CreateCompatibleBitmap(screen_dc, width, height) } else { null_mut() };
+    let (dc, old_bmp) = if !mem_dc.is_null() && !mem_bmp.is_null() {
+        (mem_dc, SelectObject(mem_dc, mem_bmp))
+    } else {
+        (screen_dc, null_mut())
+    };
     fill(dc, client, rgb(14, 23, 29));
     let scale = |vertical: i32| (vertical * client.bottom / 1080).max(1);
     let left = client.right / 14;
@@ -1520,6 +1531,16 @@ unsafe fn paint(window: HWND, menu: &Menu) {
         }
     }
 
+    if !mem_dc.is_null() && !mem_bmp.is_null() && dc == mem_dc {
+        BitBlt(screen_dc, 0, 0, width, height, mem_dc, 0, 0, SRCCOPY);
+        SelectObject(mem_dc, old_bmp);
+    }
+    if !mem_bmp.is_null() {
+        DeleteObject(mem_bmp);
+    }
+    if !mem_dc.is_null() {
+        DeleteDC(mem_dc);
+    }
     EndPaint(window, &ps);
 }
 
@@ -1528,6 +1549,9 @@ unsafe extern "system" fn window_proc(window: HWND, msg: u32, wparam: WPARAM, lp
         PostQuitMessage(0);
         return 0;
     }
+    if msg == WM_ERASEBKGND {
+        return 1;
+    }
     let pointer = GetWindowLongPtrW(window, GWLP_USERDATA) as *mut Menu;
     let Some(menu) = pointer.as_mut() else { return DefWindowProcW(window, msg, wparam, lparam) };
     let pressed = match msg {
-- 
