 crates/xcl/src/host.rs               | 185 ++++++++++++++++++++++++++-
 2 files changed, 202 insertions(+), 1 deletion(-)

diff --git a/crates/xcl/src/hle/d3d12x/present.rs b/crates/xcl/src/hle/d3d12x/present.rs
index 879d0bb..cacd6ba 100644
--- a/crates/xcl/src/hle/d3d12x/present.rs
+++ b/crates/xcl/src/hle/d3d12x/present.rs
@@ -41,6 +41,22 @@ static RTVS: Mutex<Option<HashMap<usize, usize>>> = Mutex::new(None);
 static LISTS: Mutex<Option<HashMap<usize, usize>>> = Mutex::new(None);
 static CANDIDATE: Mutex<Option<(usize, usize)>> = Mutex::new(None); // (queue, resource) – resource AddRef'd
 static PRESENTS: AtomicU64 = AtomicU64::new(0);
+/// Present times while a benchmark measures (`host::bench`, `XCL_BENCH_SECONDS`); off otherwise.
+static BENCH_RECORDING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static BENCH_FRAMES: Mutex<Vec<Instant>> = Mutex::new(Vec::new());
+
+/// Start (`true`) or stop (`false`) recording present times; stopping returns them.
+pub fn bench_record(on: bool) -> Vec<Instant> {
+    let mut frames = BENCH_FRAMES.lock().unwrap_or_else(|e| e.into_inner());
+    BENCH_RECORDING.store(on, Ordering::Release);
+    std::mem::take(&mut *frames)
+}
+
+fn bench_frame() {
+    if BENCH_RECORDING.load(Ordering::Acquire) {
+        BENCH_FRAMES.lock().unwrap_or_else(|e| e.into_inner()).push(Instant::now());
+    }
+}
 static LAST_FRAME_DUMP: Mutex<Option<FrameDumpSample>> = Mutex::new(None);
 static BOUNDARIES: AtomicU64 = AtomicU64::new(0);
 static LAST_BOUNDARY_MS: AtomicU64 = AtomicU64::new(0);
