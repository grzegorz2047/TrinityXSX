     if frames == 1 || frames.is_multiple_of(15) {
         let ps5_root = std::path::Path::new("Z:\\data\\homebrew\\PPSA83601");
@@ -1421,6 +1438,7 @@ unsafe fn present_now(min_interval: Duration, frame: Option<(usize, Vec<(usize,
         }
     }
     let n = PRESENTS.fetch_add(1, Ordering::Relaxed);
+    bench_frame();
