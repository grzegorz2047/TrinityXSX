From 24d1630250c2969fbb6b38230e6c1a2f4debaefd Mon Sep 17 00:00:00 2001
From: Grzegorz <grzegorz2047@gmail.com>
Date: Wed, 25 Nov 2026 22:22:20 +0100
Subject: [PATCH] TrinityXSX: support Win64 Vulkan titles and Touchpad quick
 menu hook

- Allow valid x64 Win64 PE titles without console DLL imports in library prepare
- Skip unused D3D12.X backend and PresentX stall-watch for non-console PE titles
- Hook vulkan-1.dll/winevulkan.dll vkQueuePresentKHR to pause while PS5 Touchpad
  quick menu is open and publish live Vulkan FPS telemetry to hud_stats.txt
---
 crates/xcl/src/hle/d3d12x/present.rs | 119 +++++++++++++++++++++++++++
 crates/xcl/src/host.rs               |  17 +++-
 crates/xcl/src/library.rs            |   4 +-
 crates/xcl/src/resolver.rs           |   9 ++
 4 files changed, 146 insertions(+), 3 deletions(-)

diff --git a/crates/xcl/src/hle/d3d12x/present.rs b/crates/xcl/src/hle/d3d12x/present.rs
index c512d7a..cb4e29d 100644
--- a/crates/xcl/src/hle/d3d12x/present.rs
+++ b/crates/xcl/src/hle/d3d12x/present.rs
@@ -112,6 +112,125 @@ fn wait_while_title_menu_open() {
     }
 }
 
+type VkGetInstanceProcAddrFn = unsafe extern "system" fn(usize, *const std::ffi::c_char) -> usize;
+type VkGetDeviceProcAddrFn = unsafe extern "system" fn(usize, *const std::ffi::c_char) -> usize;
+type VkQueuePresentKhrFn = unsafe extern "system" fn(usize, *const c_void) -> i32;
+
+static REAL_VK_GIPA: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static REAL_VK_GDPA: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static REAL_VK_PRESENT: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static VK_LOGGED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static VK_HUD_STATE: Mutex<Option<(u64, Instant)>> = Mutex::new(None);
+
+unsafe extern "system" fn xcl_vk_queue_present_khr(queue: usize, info: *const c_void) -> i32 {
+    wait_while_title_menu_open();
+    let f = REAL_VK_PRESENT.load(Ordering::Acquire);
+    if f == 0 {
+        return -13; // VK_ERROR_UNKNOWN
+    }
+    let real: VkQueuePresentKhrFn = std::mem::transmute(f);
+    let res = real(queue, info);
+    let frames = PRESENTS.fetch_add(1, Ordering::Relaxed) + 1;
+    // Update PS5 Touchpad Quick Menu HUD telemetry every ~1s for native Vulkan titles.
+    if frames == 1 || frames % 15 == 0 {
+        let ps5_root = std::path::Path::new("Z:\\data\\homebrew\\PPSA83601");
+        if ps5_root.is_dir() {
+            if let Ok(mut guard) = VK_HUD_STATE.try_lock() {
+                let now = Instant::now();
+                match *guard {
+                    None => *guard = Some((frames, now)),
+                    Some((last_f, last_t)) => {
+                        let dt = now.duration_since(last_t).as_secs_f64();
+                        if dt >= 0.9 {
+                            let fps = frames.saturating_sub(last_f) as f64 / dt;
+                            let ms = if fps > 0.05 { 1000.0 / fps } else { 0.0 };
+                            let line = format!("{fps:.1} FPS  |  {ms:.1} MS  |  VULKAN  |  FRAME {frames}\n");
+                            let _ = std::fs::write(ps5_root.join("hud_stats.txt"), line);
+                            *guard = Some((frames, now));
+                        }
+                    }
+                }
+            }
+        }
+    }
+    res
+}
+
+unsafe extern "system" fn xcl_vk_get_device_proc_addr(device: usize, p_name: *const std::ffi::c_char) -> usize {
+    let f = REAL_VK_GDPA.load(Ordering::Acquire);
+    if f == 0 {
+        return 0;
+    }
+    let real: VkGetDeviceProcAddrFn = std::mem::transmute(f);
+    let addr = real(device, p_name);
+    if addr != 0 && !p_name.is_null() {
+        if let Ok(name) = std::ffi::CStr::from_ptr(p_name).to_str() {
+            if name == "vkQueuePresentKHR" {
+                REAL_VK_PRESENT.store(addr, Ordering::Release);
+                if !VK_LOGGED.swap(true, Ordering::AcqRel) {
+                    crate::xlog_info!("Vulkan: hooked vkQueuePresentKHR for PS5 Touchpad quick menu & FPS HUD");
+                }
+                return xcl_vk_queue_present_khr as usize;
+            }
+        }
+    }
+    addr
+}
+
+unsafe extern "system" fn xcl_vk_get_instance_proc_addr(instance: usize, p_name: *const std::ffi::c_char) -> usize {
+    let f = REAL_VK_GIPA.load(Ordering::Acquire);
+    if f == 0 {
+        return 0;
+    }
+    let real: VkGetInstanceProcAddrFn = std::mem::transmute(f);
+    let addr = real(instance, p_name);
+    if addr != 0 && !p_name.is_null() {
+        if let Ok(name) = std::ffi::CStr::from_ptr(p_name).to_str() {
+            match name {
+                "vkGetDeviceProcAddr" => {
+                    REAL_VK_GDPA.store(addr, Ordering::Release);
+                    return xcl_vk_get_device_proc_addr as usize;
+                }
+                "vkQueuePresentKHR" => {
+                    REAL_VK_PRESENT.store(addr, Ordering::Release);
+                    if !VK_LOGGED.swap(true, Ordering::AcqRel) {
+                        crate::xlog_info!("Vulkan: hooked vkQueuePresentKHR for PS5 Touchpad quick menu & FPS HUD");
+                    }
+                    return xcl_vk_queue_present_khr as usize;
+                }
+                _ => {}
+            }
+        }
+    }
+    addr
+}
+
+/// Wrap native Vulkan entry points (`vulkan-1.dll` / `winevulkan.dll`) so standalone
+/// Win64 Vulkan titles pause cleanly when the PS5 Touchpad quick menu opens.
+pub fn wrap_vulkan_proc(name: &str, real: usize) -> usize {
+    if real == 0 {
+        return 0;
+    }
+    match name {
+        "vkGetInstanceProcAddr" => {
+            REAL_VK_GIPA.store(real, Ordering::Release);
+            xcl_vk_get_instance_proc_addr as usize
+        }
+        "vkGetDeviceProcAddr" => {
+            REAL_VK_GDPA.store(real, Ordering::Release);
+            xcl_vk_get_device_proc_addr as usize
+        }
+        "vkQueuePresentKHR" => {
+            REAL_VK_PRESENT.store(real, Ordering::Release);
+            if !VK_LOGGED.swap(true, Ordering::AcqRel) {
+                crate::xlog_info!("Vulkan: hooked vkQueuePresentKHR for PS5 Touchpad quick menu & FPS HUD");
+            }
+            xcl_vk_queue_present_khr as usize
+        }
+        _ => real,
+    }
+}
+
 /// command queue #30 PresentX(planeCount, planes, parameters): plane 0's first resource is
 /// the frame; S_OK always (a console present does not fail for the title).
 pub unsafe extern "system" fn present_x(queue: *mut c_void, plane_count: u32, planes: *const u8, _params: *const u8) -> i32 {
diff --git a/crates/xcl/src/host.rs b/crates/xcl/src/host.rs
index 0245284..1afe11a 100644
--- a/crates/xcl/src/host.rs
+++ b/crates/xcl/src/host.rs
@@ -46,6 +46,21 @@ pub fn host_main(boot_path: &Path) -> i32 {
     if std::env::var_os("XCL_ACTIVITY").is_none() && boot.config.activity {
         std::env::set_var("XCL_ACTIVITY", "1");
     }
+    let mut boot = boot;
+    let has_console_imports = crate::inspect::console_imports(&boot.exe_path)
+        .is_some_and(|imports| !imports.is_empty());
+    if !has_console_imports {
+        // Standalone Win64 / native Vulkan executables (e.g. Godot) do not import d3d12_xs.dll.
+        // Skip D3D12.X / vkd3d-proton / 1024 MiB coherent UMA initialization and the PresentX
+        // stall watchdog (which would falsely fire at 30s and SuspendThread active Vulkan threads).
+        if boot.config.graphics.is_empty()
+            || boot.config.graphics.eq_ignore_ascii_case("d3d12")
+            || boot.config.graphics.eq_ignore_ascii_case("real")
+        {
+            boot.config.graphics = "null".into();
+        }
+        crate::xlog_info!("non-console Win64 PE detected: disabling unused D3D12.X UMA and PresentX stall watchdog");
+    }
     crate::debug_tools::init(&boot.config);
     crate::hle::netoff::install_getnameinfo_guard();
     crate::state::set_boot(boot.clone());
@@ -114,7 +129,7 @@ pub fn host_main(boot_path: &Path) -> i32 {
     // Automatic 0-FPS loading / rendering stall watchdog (disable with XCL_NO_STALL_WATCH=1).
     // Captures GPU/DirectStorage/VRAM counters + thread dump once per stall so black-screen
     // bug reports always contain actionable diagnostics.
-    if std::env::var_os("XCL_NO_STALL_WATCH").is_none() {
+    if has_console_imports && std::env::var_os("XCL_NO_STALL_WATCH").is_none() {
         let _ = std::thread::Builder::new().name("xcl-stall-watch".into()).spawn(|| {
             const INITIAL_STALL_SECS: u64 = 30;
             const RUNTIME_STALL_SECS: u64 = 15;
diff --git a/crates/xcl/src/library.rs b/crates/xcl/src/library.rs
index 637ce16..08255e1 100644
--- a/crates/xcl/src/library.rs
+++ b/crates/xcl/src/library.rs
@@ -835,8 +835,8 @@ pub fn prepare(game: &Game) -> Result<(), String> {
 
 pub fn prepare_with_profile(game: &Game, profile: &Profile) -> Result<(), String> {
     let (_, _, title) = launcher::resolve_target(&game.executable)?;
-    if !crate::inspect::console_imports(&game.executable).is_some_and(|imports| !imports.is_empty()) {
-        return Err("the selected executable is not an Xbox Series PE program".into());
+    if crate::inspect::console_imports(&game.executable).is_none() {
+        return Err("the selected executable is not a valid 64-bit Windows PE program".into());
     }
     let dir = launcher::data_root().join(title);
     let cfg_path = dir.join("xcl.toml");
diff --git a/crates/xcl/src/resolver.rs b/crates/xcl/src/resolver.rs
index 7882042..4819cd5 100644
--- a/crates/xcl/src/resolver.rs
+++ b/crates/xcl/src/resolver.rs
@@ -317,6 +317,8 @@ pub fn resolve_import(dll: &str, what: &ImportName, importer: &str, delay: bool)
     let (mut addr, source) = resolve_inner(&key, what, 0);
     if matches!(source, Source::GameDll(_)) && crate::hle::bink::is_bink_dll(&key) {
         addr = crate::hle::bink::wrap(&fname(what), addr);
+    } else if matches!(source, Source::System(_)) && (key == "vulkan-1.dll" || key == "winevulkan.dll") {
+        addr = crate::hle::d3d12x::present::wrap_vulkan_proc(&fname(what), addr);
     }
     crate::xlog_debug!("import {importer}: {key}!{what} → {source:?}");
     if let Some(f) = trace_filter() {
@@ -447,6 +449,13 @@ pub fn get_proc_address(h: usize, what: &ImportName) -> Option<usize> {
                 }
             }
         }
+        if key == "vulkan-1.dll" || key == "winevulkan.dll" {
+            if let ImportName::Name { name, .. } = what {
+                if let Some(real) = system_proc_in(h, what) {
+                    return Some(crate::hle::d3d12x::present::wrap_vulkan_proc(name, real));
+                }
+            }
+        }
     }
     system_proc_in(h, what)
 }
