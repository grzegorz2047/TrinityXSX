diff --git a/crates/xcl/src/hle/xgameruntime/mod.rs b/crates/xcl/src/hle/xgameruntime/mod.rs
index 616b5d3..669d45a 100644
--- a/crates/xcl/src/hle/xgameruntime/mod.rs
+++ b/crates/xcl/src/hle/xgameruntime/mod.rs
@@ -852,11 +852,51 @@ static ASSOCIATION_CALLBACKS: std::sync::Mutex<Vec<(u64, usize, usize, usize, bo
 /// the local user was handed to the title (XUserAddResult): the input devices are associated
 /// with it from then on
 static USER_SIGNED_IN: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// Signals when at least one `XUserRegisterForDeviceAssociationChanged` callback has finished
+/// executing on the title's queue, so async `GameInput::RegisterDeviceCallback` can let device
+/// association run first without racing ahead.
+fn association_signal() -> &'static (std::sync::Mutex<bool>, std::sync::Condvar) {
+    static SIG: std::sync::OnceLock<(std::sync::Mutex<bool>, std::sync::Condvar)> = std::sync::OnceLock::new();
+    SIG.get_or_init(|| (std::sync::Mutex::new(false), std::sync::Condvar::new()))
+}
+
+fn mark_association_delivered() {
+    let (lock, cv) = association_signal();
+    let mut done = lock.lock().unwrap_or_else(|e| e.into_inner());
+    *done = true;
+    cv.notify_all();
+}
+
+/// Wait up to `max_wait` for a device association callback to finish running, if the local user
+/// is already signed in. Returns `true` if a device association callback has been delivered.
+/// Titles that never register an association callback simply resume once `max_wait` elapses.
+pub fn wait_for_device_association(max_wait: std::time::Duration) -> bool {
+    if !USER_SIGNED_IN.load(Ordering::Acquire) {
+        return false;
+    }
+    let (lock, cv) = association_signal();
+    let mut done = lock.lock().unwrap_or_else(|e| e.into_inner());
+    if *done {
+        return true;
+    }
+    let deadline = std::time::Instant::now() + max_wait;
+    while !*done {
+        let Some(rem) = deadline.checked_duration_since(std::time::Instant::now()) else {
+            break;
+        };
+        let (guard, wait_res) = cv.wait_timeout(done, rem).unwrap_or_else(|e| e.into_inner());
+        done = guard;
+        if wait_res.timed_out() {
+            break;
+        }
+    }
+    *done
+}
 
-/// Fire every registered device association callback that has not been notified yet, once both
-/// the user is signed in and no async GameInput device enumeration is still pending.
+/// Fire every registered device association callback that has not been notified yet once the
+/// user is signed in.
 fn flush_association_callbacks() {
-    if !USER_SIGNED_IN.load(Ordering::Acquire) || crate::hle::gameinput::device_enum_pending() {
+    if !USER_SIGNED_IN.load(Ordering::Acquire) {
         return;
     }
     let pending: Vec<(usize, usize, usize)> = {
@@ -875,12 +915,6 @@ fn flush_association_callbacks() {
     }
 }
 
-/// Called by GameInput once its async device arrival enumeration finishes delivering the
