+    mark_association_delivered();
 }
 
 /// The title's association callback gets the gamepad → user association, on its queue's
@@ -945,13 +982,10 @@ pub unsafe extern "system" fn XUserRegisterForDeviceAssociationChanged(queue: *m
     *token = t;
     ASSOCIATION_CALLBACKS.lock().unwrap().push((t, queue as usize, ctx as usize, cb, false));
     let signed_in = USER_SIGNED_IN.load(Ordering::Acquire);
-    let enum_pending = crate::hle::gameinput::device_enum_pending();
     crate::xlog_info!(
         "XUser: device association callback #{t:#x} registered (queue {queue:?}){}",
         if !signed_in {
             " – before the user is signed in"
-        } else if enum_pending {
-            " – waiting for GameInput device arrival"
         } else {
             ""
         }
@@ -1233,4 +1267,22 @@ mod tests {
             let _ = std::fs::remove_file(&probe);
         }
     }
+
+    #[test]
+    fn wait_for_device_association_wakes_on_delivery() {
+        let _g = crate::hle::xgameruntime::xasync::ASYNC_TEST_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+        USER_SIGNED_IN.store(true, Ordering::Release);
+        {
+            let (lock, _) = association_signal();
+            *lock.lock().unwrap() = false;
+        }
+        let t = std::thread::spawn(|| {
+            std::thread::sleep(std::time::Duration::from_millis(20));
+            mark_association_delivered();
+        });
+        let start = std::time::Instant::now();
+        assert!(wait_for_device_association(std::time::Duration::from_secs(2)));
+        assert!(start.elapsed() < std::time::Duration::from_secs(1));
+        t.join().unwrap();
+    }
