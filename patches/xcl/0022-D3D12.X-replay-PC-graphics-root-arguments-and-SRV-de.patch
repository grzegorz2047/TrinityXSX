-/// #42 / #44 / #46 SetGraphicsRoot{ConstantBuffer,ShaderResource,UnorderedAccess}View (PC #38 /
-/// #40 / #42)
-pub(super) unsafe extern "system" fn set_graphics_root_descriptor(this: *mut c_void, i: u32, va: u64) {
+/// #42 SetGraphicsRootConstantBufferView (PC #38)
+pub(super) unsafe extern "system" fn set_graphics_root_cbv(this: *mut c_void, i: u32, va: u64) {
+    note_address(va);
+    put_in(this, true, i, 0, &va.to_le_bytes());
+    with(this, |s| {
+        s.pc_gfx_ops.retain(|op| !matches!(op, PcGfxOp::Cbv(idx, _) if *idx == i));
+        s.pc_gfx_ops.push(PcGfxOp::Cbv(i, va));
+    });
+}
+
+/// #44 SetGraphicsRootShaderResourceView (PC #40)
+pub(super) unsafe extern "system" fn set_graphics_root_srv(this: *mut c_void, i: u32, va: u64) {
+    note_address(va);
+    put_in(this, true, i, 0, &va.to_le_bytes());
+    with(this, |s| {
+        s.pc_gfx_ops.retain(|op| !matches!(op, PcGfxOp::Srv(idx, _) if *idx == i));
+        s.pc_gfx_ops.push(PcGfxOp::Srv(i, va));
