+}
+
+/// #46 SetGraphicsRootUnorderedAccessView (PC #42)
+pub(super) unsafe extern "system" fn set_graphics_root_uav(this: *mut c_void, i: u32, va: u64) {
     note_address(va);
     put_in(this, true, i, 0, &va.to_le_bytes());
+    with(this, |s| {
+        s.pc_gfx_ops.retain(|op| !matches!(op, PcGfxOp::Uav(idx, _) if *idx == i));
+        s.pc_gfx_ops.push(PcGfxOp::Uav(i, va));
