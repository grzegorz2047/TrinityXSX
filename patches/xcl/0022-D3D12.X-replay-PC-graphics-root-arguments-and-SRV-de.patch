+}
+
+unsafe fn bind_pc_graphics_args(this: *mut c_void, list: &ID3D12GraphicsCommandList) {
+    let (rs, ops) = with(this, |s| (s.rs_gfx, s.pc_gfx_ops.clone()));
+    let rs_ptr = rs as *mut c_void;
+    let Some(r) = ID3D12RootSignature::from_raw_borrowed(&rs_ptr) else {
+        return;
+    };
+    if ops.iter().any(|op| matches!(op, PcGfxOp::Table(_, _))) {
+        super::list_x::ensure_view_heap(this);
+    }
+    list.SetGraphicsRootSignature(r);
+    for op in ops {
+        match op {
+            PcGfxOp::Table(i, handle) => {
+                if let Some(gpu) = super::console_heap::pc_gpu_handle(handle) {
+                    list.SetGraphicsRootDescriptorTable(i, D3D12_GPU_DESCRIPTOR_HANDLE { ptr: gpu });
+                }
+            }
+            PcGfxOp::Constant(i, value, offset) => {
+                list.SetGraphicsRoot32BitConstant(i, value, offset);
+            }
+            PcGfxOp::Constants(i, words, offset) => {
+                if !words.is_empty() {
+                    list.SetGraphicsRoot32BitConstants(i, words.len() as u32, words.as_ptr() as *const c_void, offset);
+                }
+            }
+            PcGfxOp::Cbv(i, va) => {
+                let pc_va = super::list_x::pc_va_of(va);
+                if pc_va != 0 {
+                    list.SetGraphicsRootConstantBufferView(i, pc_va);
+                }
+            }
+            PcGfxOp::Srv(i, va) => {
+                let pc_va = super::list_x::pc_va_of(va);
+                if pc_va != 0 {
+                    list.SetGraphicsRootShaderResourceView(i, pc_va);
+                }
+            }
+            PcGfxOp::Uav(i, va) => {
+                let pc_va = super::list_x::pc_va_of(va);
+                if pc_va != 0 {
+                    list.SetGraphicsRootUnorderedAccessView(i, pc_va);
+                }
+            }
+        }
+    }
 }
 
