     HEAPS.lock().unwrap().iter().find(|h| h.obj == obj).map(|h| h.shadow as u64)
 }
 
+/// Shader-visible PC GPU descriptor handle for the SRV (or sampler) at a console descriptor handle.
+pub fn pc_gpu_handle(handle: u64) -> Option<u64> {
+    if handle == 0 {
+        return None;
+    }
+    let full = if handle < (1u64 << 32) {
+        crate::gpu::uma::get().map(|u| u.base() as u64 + handle)?
+    } else {
+        handle
+    };
+    let s = slot(full)?;
+    if s.sampler {
+        let heaps = HEAPS.lock().unwrap();
+        let h = heaps.iter().find(|h| full >= h.shadow as u64 && full < (h.shadow + (h.n * h.slot_bytes()) as usize) as u64)?;
+        return (h.pc_gpu != 0).then(|| h.pc_gpu + (s.k * h.inc) as u64);
+    }
+    if s.shared_srv != 0 {
+        let g = GLOBAL.lock().unwrap();
+        let g = g.as_ref()?;
+        return Some(g.gpu + s.index as u64 * g.inc as u64);
+    }
+    let heaps = HEAPS.lock().unwrap();
+    let h = heaps.iter().find(|h| full >= h.shadow as u64 && full < (h.shadow + (h.n * h.slot_bytes()) as usize) as u64)?;
+    (h.pc_gpu != 0).then(|| h.pc_gpu + (2 * s.k * h.inc) as u64)
+}
+
 /// A console slot: where its descriptor goes and its PC descriptors.
 #[derive(Clone, Copy, Debug)]
 pub struct Slot {
