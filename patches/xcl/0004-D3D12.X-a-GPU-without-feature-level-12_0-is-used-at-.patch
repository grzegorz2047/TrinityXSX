+/// The feature levels a hardware adapter is asked for, in this order: 12_0 (the console's), then
+/// 11_0. vkd3d-proton on the PS5's RADV gives only 11_0 (tiled resources tier 1); without the
+/// second level that GPU was passed over for WARP – DXVK's dxgi hands out the same GPU as WARP
+/// there, but on Windows WARP is the software renderer.
+pub const LEVELS: [D3D_FEATURE_LEVEL; 2] = [D3D_FEATURE_LEVEL_12_0, D3D_FEATURE_LEVEL_11_0];
+
+/// The first `(adapter index, level, device)` that `create` gives: every adapter at the first
+/// level, then every adapter at the next one (a device at 12_0 on any adapter is preferred to
+/// one at 11_0 on a higher-performance one).
+pub fn first_device<A, L: Copy, D>(adapters: &[A], levels: &[L], mut create: impl FnMut(&A, L) -> Option<D>) -> Option<(usize, L, D)> {
+    levels.iter().find_map(|&l| adapters.iter().enumerate().find_map(|(i, a)| create(a, l).map(|d| (i, l, d))))
+}
+
+/// A D3D12 device and what it is.
+pub struct Device {
+    pub device: windows::Win32::Graphics::Direct3D12::ID3D12Device,
+    /// "<adapter> (<n> MiB VRAM)", ", feature level 11_0" when below 12_0; or "WARP (software renderer)"
+    pub name: String,
+    pub warp: bool,
+    pub level: D3D_FEATURE_LEVEL,
+}
+
+/// The device the title gets (`hle::d3d12x::real`) and the launcher's checks probe (`preflight`):
+/// the first of `adapters` at a level of `LEVELS` (`first_device`), else WARP at 11_0.
+pub fn create_device(factory: &IDXGIFactory6, adapters: &[(IDXGIAdapter1, DXGI_ADAPTER_DESC1)]) -> Result<Device, String> {
+    let found = first_device(adapters, &LEVELS, |(a, _), l| crate::gpu::agility::create_device(a, l).ok());
+    if let Some((i, level, device)) = found {
+        let desc = &adapters[i].1;
+        let mut name = format!("{} ({} MiB VRAM)", self::name(desc), desc.DedicatedVideoMemory >> 20);
+        if level != D3D_FEATURE_LEVEL_12_0 {
+            name.push_str(", feature level 11_0");
+        }
+        return Ok(Device { device, name, warp: false, level });
+    }
+    let warp: IDXGIAdapter = unsafe { factory.EnumWarpAdapter() }.map_err(|e| format!("WARP: {e}"))?;
+    let device = crate::gpu::agility::create_device(&warp, D3D_FEATURE_LEVEL_11_0).map_err(|e| format!("D3D12 device (WARP): {e}"))?;
+    Ok(Device { device, name: "WARP (software renderer)".into(), warp: true, level: D3D_FEATURE_LEVEL_11_0 })
+}
+
 /// "`sel` matches no adapter (have: 0 = …, 1 = …)" – for logs and test skips.
 pub fn no_match(factory: &IDXGIFactory6, sel: &Selector) -> String {
     let have: Vec<String> = hardware(factory).iter().enumerate().map(|(i, (_, d))| format!("{i} = {}", name(d))).collect();
