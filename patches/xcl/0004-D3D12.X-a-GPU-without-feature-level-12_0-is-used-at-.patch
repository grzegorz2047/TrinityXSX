+/// The PS5 under prospero-win: vkd3d-proton on its RADV refuses 12_0 and gives 11_0. That GPU is
+/// taken at 11_0 instead of nothing (WARP), and a GPU that gives 12_0 still wins over one
+/// listed before it that gives only 11_0.
+#[test]
+fn a_gpu_without_12_0_is_used_at_11_0_and_12_0_wins() {
+    use windows::Win32::Graphics::Direct3D::{D3D_FEATURE_LEVEL, D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_12_0};
+    assert_eq!(LEVELS, [D3D_FEATURE_LEVEL_12_0, D3D_FEATURE_LEVEL_11_0]);
+    // "ps5" gives only 11_0, "rtx" any level, "none" nothing
+    fn create(a: &&'static str, l: D3D_FEATURE_LEVEL) -> Option<&'static str> {
+        (*a == "rtx" || (*a == "ps5" && l == D3D_FEATURE_LEVEL_11_0)).then_some(*a)
+    }
+    let mut asked = Vec::new();
+    let got = first_device(&["ps5"], &LEVELS, |a, l| {
+        asked.push((*a, l));
+        create(a, l)
+    });
+    assert_eq!(got, Some((0, D3D_FEATURE_LEVEL_11_0, "ps5")));
+    assert_eq!(asked, vec![("ps5", D3D_FEATURE_LEVEL_12_0), ("ps5", D3D_FEATURE_LEVEL_11_0)]);
+    assert_eq!(first_device(&["ps5", "rtx"], &LEVELS, create), Some((1, D3D_FEATURE_LEVEL_12_0, "rtx")));
+    assert_eq!(first_device(&["none"], &LEVELS, create), None);
+    assert_eq!(first_device(&[] as &[&'static str], &LEVELS, create), None);
+}
