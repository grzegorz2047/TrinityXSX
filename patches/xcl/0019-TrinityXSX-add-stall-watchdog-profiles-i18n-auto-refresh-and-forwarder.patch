+//! Lightweight UI translations for TrinityXSX (English, Polish, Portuguese, Spanish).
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum Lang {
+    #[default]
+    En,
+    Pl,
+    Pt,
+    Es,
+}
+
+impl Lang {
+    pub const ALL: [Lang; 4] = [Lang::En, Lang::Pl, Lang::Pt, Lang::Es];
+
+    pub fn code(self) -> &'static str {
+        match self {
+            Lang::En => "en",
+            Lang::Pl => "pl",
+            Lang::Pt => "pt",
+            Lang::Es => "es",
+        }
+    }
+
+    pub fn display_name(self) -> &'static str {
+        match self {
+            Lang::En => "English",
+            Lang::Pl => "Polski",
+            Lang::Pt => "Português",
+            Lang::Es => "Español",
+        }
+    }
+
+    pub fn parse(raw: &str) -> Option<Self> {
+        match raw.trim().to_ascii_lowercase().as_str() {
+            "en" | "english" => Some(Lang::En),
+            "pl" | "polski" | "polish" => Some(Lang::Pl),
+            "pt" | "portugues" | "português" | "portuguese" => Some(Lang::Pt),
+            "es" | "espanol" | "español" | "spanish" => Some(Lang::Es),
+            _ => None,
+        }
+    }
+
+    pub fn next(self) -> Self {
+        match self {
+            Lang::En => Lang::Pl,
+            Lang::Pl => Lang::Pt,
+            Lang::Pt => Lang::Es,
+            Lang::Es => Lang::En,
+        }
+    }
+
+    pub fn prev(self) -> Self {
+        match self {
+            Lang::En => Lang::Es,
+            Lang::Pl => Lang::En,
+            Lang::Pt => Lang::Pl,
+            Lang::Es => Lang::Pt,
+        }
+    }
+}
+
