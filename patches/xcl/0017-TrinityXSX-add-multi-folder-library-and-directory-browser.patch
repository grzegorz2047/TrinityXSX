+fn should_skip_dir_name(name: &str) -> bool {
+    name.starts_with('.')
+        || name.starts_with('$')
+        || name.eq_ignore_ascii_case("System Volume Information")
+}
+
+fn scan_directory_into(
+    root: &Path,
+    source_label: &str,
+    depth: u8,
+    seen_execs: &mut HashSet<String>,
+    games: &mut Vec<Game>,
+    skipped: &mut usize,
+) -> usize {
+    let mut added_here = 0;
+
+    // If the folder itself contains MicrosoftGame.config, treat it directly as a game.
+    if has_manifest(root) {
+        match from_folder(root, source_label) {
+            Ok(game) => {
+                let key = game.executable.to_string_lossy().to_lowercase();
+                if seen_execs.insert(key) {
+                    games.push(game);
+                    added_here += 1;
+                }
+            }
+            Err(error) => {
+                *skipped += 1;
+                eprintln!("TrinityXSX: skipped {} ({error})", root.display());
+            }
+        }
+        return added_here;
+    }
+
+    let Ok(entries) = fs::read_dir(root) else {
+        return 0;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if !path.is_dir() {
+            continue;
+        }
+        let name = entry.file_name().to_string_lossy().into_owned();
+        if should_skip_dir_name(&name) {
+            continue;
+        }
+        if has_manifest(&path) {
+            match from_folder(&path, source_label) {
+                Ok(game) => {
+                    let key = game.executable.to_string_lossy().to_lowercase();
+                    if seen_execs.insert(key) {
+                        games.push(game);
+                        added_here += 1;
+                    }
+                }
+                Err(error) => {
+                    *skipped += 1;
+                    eprintln!("TrinityXSX: skipped {} ({error})", name);
+                }
+            }
+        } else if depth > 0 {
+            let nested = scan_directory_into(&path, source_label, depth - 1, seen_execs, games, skipped);
+            if nested > 0 {
+                added_here += nested;
+            } else if depth == 1 {
+                *skipped += 1;
+                eprintln!("TrinityXSX: skipped {} (missing MicrosoftGame.config)", name);
+            }
+        } else {
+            *skipped += 1;
+            eprintln!("TrinityXSX: skipped {} (missing MicrosoftGame.config)", name);
+        }
+    }
+    added_here
+}
