+/// Normalize a user or persisted folder path.
+///
+/// Accepts PS5 Unix paths (`/mnt/ext1/xboxseries`), Wine `Z:\...` paths (converted to `/...`),
+/// and Windows drive paths (`C:\XCL\games`). Rejects filesystem roots (`/` or `C:\`) and
+/// relative/malformed paths.
+pub fn normalize_path(raw: &str) -> Option<String> {
+    let trimmed = raw.trim();
+    if trimmed.is_empty()
+        || trimmed.len() > MAX_STORED_PATH_LEN
+        || trimmed.contains(['\0', '\r', '\n'])
+    {
+        return None;
+    }
+    let trimmed = trimmed.strip_prefix("\\\\?\\").unwrap_or(trimmed);
+
+    // Wine Z:\... maps directly to PS5 Unix /...
+    let unix_input = if trimmed.len() >= 2
+        && trimmed.as_bytes()[0].eq_ignore_ascii_case(&b'z')
+        && trimmed.as_bytes()[1] == b':'
+    {
+        let rest = &trimmed[2..];
+        if !rest.is_empty() && !rest.starts_with('\\') && !rest.starts_with('/') {
+            return None;
+        }
+        Some(rest.replace('\\', "/"))
+    } else if trimmed.starts_with('/') {
+        if trimmed.contains('\\') {
+            return None;
+        }
+        Some(trimmed.to_owned())
+    } else {
+        None
+    };
+
+    if let Some(unix) = unix_input {
+        let mut segments: Vec<&str> = Vec::new();
+        for part in unix.split('/') {
+            match part {
+                "" | "." => {}
+                ".." => {
+                    segments.pop();
+                }
+                seg => segments.push(seg),
+            }
+        }
+        if segments.is_empty() {
+            return None;
+        }
+        return Some(format!("/{}", segments.join("/")));
+    }
+
+    // Standard Windows drive path (e.g. C:\XCL\games)
+    let bytes = trimmed.as_bytes();
+    if bytes.len() >= 3 && bytes[0].is_ascii_alphabetic() && bytes[1] == b':' && (bytes[2] == b'\\' || bytes[2] == b'/') {
+        let drive = (bytes[0] as char).to_ascii_uppercase();
+        let mut segments: Vec<&str> = Vec::new();
+        for part in trimmed[3..].split(['\\', '/']) {
+            match part {
+                "" | "." => {}
+                ".." => {
+                    segments.pop();
+                }
+                seg => segments.push(seg),
+            }
+        }
+        if segments.is_empty() {
+            return None;
+        }
+        return Some(format!("{drive}:\\{}", segments.join("\\")));
+    }
+
+    None
+}
