+        assert_eq!(browser_parent("C:\\XCL\\games").as_deref(), Some("C:\\XCL"));
+        assert_eq!(browser_parent("C:\\XCL").as_deref(), Some("C:\\"));
+        assert_eq!(browser_parent("C:\\"), None);
+    }
+
+    #[test]
+    fn reads_writes_and_deduplicates_game_paths() {
