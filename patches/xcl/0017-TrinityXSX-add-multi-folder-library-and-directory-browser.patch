+/// Scan every configured game folder, tolerating disconnected USB/external paths.
+pub fn scan_paths(paths: &[String]) -> Catalog {
+    let mut games = Vec::new();
+    let mut seen_execs = HashSet::new();
+    let mut skipped = 0;
+    let mut folders = Vec::with_capacity(paths.len());
+
+    for stored in paths {
+        let fs_path = to_fs_path(stored);
+        if !fs_path.is_dir() {
+            folders.push(FolderStatus {
+                path: stored.clone(),
+                available: false,
+                game_count: 0,
+            });
             continue;
         }
-        match from_folder(&entry.path()) {
-            Ok(game) => games.push(game),
-            Err(error) => {
-                skipped += 1;
-                eprintln!("TrinityXSX: skipped {} ({error})", entry.file_name().to_string_lossy());
+        let count = scan_directory_into(&fs_path, stored, 1, &mut seen_execs, &mut games, &mut skipped);
+        folders.push(FolderStatus {
+            path: stored.clone(),
+            available: true,
+            game_count: count,
+        });
+    }
