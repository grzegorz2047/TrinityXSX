Subject: [PATCH] TrinityXSX: pause PresentX while Touchpad quick menu
 is open

---
 crates/xcl/src/hle/d3d12x/present.rs | 67 ++++++++++++++++++++++++++++
 crates/xcl/src/host.rs               |  4 ++
 2 files changed, 71 insertions(+)

diff --git a/crates/xcl/src/hle/d3d12x/present.rs b/crates/xcl/src/hle/d3d12x/present.rs
index d47e678..c682d93 100644
--- a/crates/xcl/src/hle/d3d12x/present.rs
+++ b/crates/xcl/src/hle/d3d12x/present.rs
@@ -49,12 +49,79 @@ static HWND_RAW: AtomicIsize = AtomicIsize::new(0);
 static PRESENTX: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
 static PRESENTX_LOCK: Mutex<()> = Mutex::new(());
 
+const PW_TITLE_MENU_PROCESS_INFO: u32 = 0x5057_4D01;
+const PW_TITLE_MENU_VERSION: u32 = 1;
+
+#[repr(C)]
+struct PwTitleMenuSnapshot {
+    version: u32,
+    sequence: u32,
+    open: u32,
+    lines: u32,
+    selected: i32,
+    title: [u8; 48],
+    line: [[u8; 48]; 16],
+}
+
+/// True while the PS5 runner's Touchpad quick menu is open over the game.
+pub fn title_menu_open() -> bool {
+    use std::sync::atomic::AtomicU8;
+    use std::sync::OnceLock;
+    type NtQueryInfoFn = unsafe extern "system" fn(isize, u32, *mut c_void, u32, *mut u32) -> i32;
+    // 0 = unknown, 1 = supported (PS5 Wine), 2 = unsupported (standard Windows)
+    static STATE: AtomicU8 = AtomicU8::new(0);
+    static FUNC: OnceLock<Option<NtQueryInfoFn>> = OnceLock::new();
+
+    if STATE.load(Ordering::Relaxed) == 2 {
+        return false;
+    }
+    let query = *FUNC.get_or_init(|| unsafe {
+        let name: Vec<u16> = "ntdll.dll\0".encode_utf16().collect();
+        let h = windows_sys::Win32::System::LibraryLoader::GetModuleHandleW(name.as_ptr());
+        if h.is_null() {
+            return None;
+        }
+        windows_sys::Win32::System::LibraryLoader::GetProcAddress(h, b"NtQueryInformationProcess\0".as_ptr())
+            .map(|f| std::mem::transmute::<_, NtQueryInfoFn>(f))
+    });
+    let Some(query) = query else {
+        STATE.store(2, Ordering::Relaxed);
+        return false;
+    };
+    let mut snap: PwTitleMenuSnapshot = unsafe { std::mem::zeroed() };
+    let mut ret_len = 0u32;
+    let status = unsafe {
+        query(
+            -1isize,
+            PW_TITLE_MENU_PROCESS_INFO,
+            &mut snap as *mut _ as *mut c_void,
+            std::mem::size_of::<PwTitleMenuSnapshot>() as u32,
+            &mut ret_len,
+        )
+    };
+    if status != 0 {
+        if STATE.load(Ordering::Relaxed) == 0 {
+            STATE.store(2, Ordering::Relaxed);
+        }
+        return false;
+    }
+    STATE.store(1, Ordering::Relaxed);
+    snap.version == PW_TITLE_MENU_VERSION && snap.open != 0
+}
+
+fn wait_while_title_menu_open() {
+    while title_menu_open() {
+        std::thread::sleep(Duration::from_millis(16));
+    }
+}
+
 /// command queue #30 PresentX(planeCount, planes, parameters): plane 0's first resource is
 /// the frame; S_OK always (a console present does not fail for the title).
 pub unsafe extern "system" fn present_x(queue: *mut c_void, plane_count: u32, planes: *const u8, _params: *const u8) -> i32 {
     if plane_count == 0 || planes.is_null() || !crate::gpu::shader::readable(planes as usize, 0x18) {
         return 0;
     }
+    wait_while_title_menu_open();
     let token = (planes as *const u64).read_unaligned();
     let _present = PRESENTX_LOCK.lock().unwrap();
     present_x_frame(queue, plane_count, planes);
diff --git a/crates/xcl/src/host.rs b/crates/xcl/src/host.rs
index 40ed711..80920ae 100644
--- a/crates/xcl/src/host.rs
+++ b/crates/xcl/src/host.rs
@@ -128,6 +128,10 @@ pub fn host_main(boot_path: &Path) -> i32 {
             let mut reported_stall = false;
             loop {
                 std::thread::sleep(std::time::Duration::from_secs(3));
+                if crate::hle::d3d12x::present::title_menu_open() {
+                    last_progress = std::time::Instant::now();
+                    continue;
+                }
                 let (presents, submits) = crate::hle::d3d12x::present::activity();
                 if presents != last_presents {
                     if reported_stall {
