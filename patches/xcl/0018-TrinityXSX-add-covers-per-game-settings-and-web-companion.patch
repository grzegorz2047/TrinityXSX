diff --git a/crates/xcl/src/library_web.rs b/crates/xcl/src/library_web.rs
new file mode 100644
index 0000000..e54e092
--- /dev/null
+++ b/crates/xcl/src/library_web.rs
@@ -0,0 +1,586 @@
+//! Built-in LAN Web Companion for TrinityXSX (clean shutdown before game launch).
+//!
+//! Lets users on the same Wi-Fi scan a QR code on their phone/PC to:
+//! - Download a ready-to-attach `trinityxsx-logs.zip` (no FTP or Python required)
+//! - Edit `game_paths.txt` from a phone/PC keyboard
+//! - View & edit per-game `xcl.toml` settings with TOML validation
+
+use std::fs;
+use std::io::{Read, Write};
+use std::net::{IpAddr, TcpListener, TcpStream, UdpSocket};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::thread::{self, JoinHandle};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use crate::config::Config;
+use crate::library;
+
+const PREFERRED_PORT: u16 = 8360;
+const MAX_LOG_FILE_BYTES: usize = 8 * 1024 * 1024;
+const MAX_HTTP_BODY_BYTES: usize = 64 * 1024;
+
+pub struct WebCompanion {
+    pub url: String,
+    pub qr_url: String,
+    pub pin: String,
+    stop: Arc<AtomicBool>,
+    pub dirty: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl WebCompanion {
+    pub fn start(paths_file: PathBuf) -> Option<Self> {
+        let listener = TcpListener::bind(("0.0.0.0", PREFERRED_PORT))
+            .or_else(|_| TcpListener::bind(("0.0.0.0", 0)))
+            .ok()?;
+        let port = listener.local_addr().ok()?.port();
+        let _ = listener.set_nonblocking(true);
+
+        let ip = detect_lan_ip().unwrap_or_else(|| "127.0.0.1".into());
+        let pin = generate_pin();
+        let url = format!("http://{ip}:{port}");
+        let qr_url = format!("{url}/?pin={pin}");
+
+        let stop = Arc::new(AtomicBool::new(false));
+        let dirty = Arc::new(AtomicBool::new(false));
+        let stop_bg = Arc::clone(&stop);
+        let dirty_bg = Arc::clone(&dirty);
+        let pin_bg = pin.clone();
+
+        let thread = thread::spawn(move || {
+            while !stop_bg.load(Ordering::Acquire) {
+                match listener.accept() {
+                    Ok((stream, _)) => {
+                        let _ = stream.set_nonblocking(false);
+                        let _ = stream.set_read_timeout(Some(Duration::from_secs(3)));
+                        let _ = stream.set_write_timeout(Some(Duration::from_secs(10)));
+                        handle_connection(stream, &pin_bg, &paths_file, &dirty_bg);
+                    }
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                        thread::sleep(Duration::from_millis(50));
+                    }
+                    Err(_) => {
+                        thread::sleep(Duration::from_millis(100));
+                    }
+                }
+            }
+        });
+
+        Some(Self { url, qr_url, pin, stop, dirty, thread: Some(thread) })
+    }
+
+    pub fn take_dirty(&self) -> bool {
+        self.dirty.swap(false, Ordering::AcqRel)
+    }
+
+    pub fn shutdown(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(handle) = self.thread.take() {
+            let _ = handle.join();
+        }
+    }
+}
+
+impl Drop for WebCompanion {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+fn detect_lan_ip() -> Option<String> {
+    let sock = UdpSocket::bind("0.0.0.0:0").ok()?;
+    for target in ["192.0.2.1:80", "10.255.255.255:80", "8.8.8.8:80"] {
+        if sock.connect(target).is_ok() {
+            if let Ok(addr) = sock.local_addr() {
+                if let IpAddr::V4(v4) = addr.ip() {
+                    if !v4.is_loopback() && !v4.is_unspecified() {
+                        return Some(v4.to_string());
+                    }
+                }
+            }
+        }
+    }
+    None
+}
+
+fn generate_pin() -> String {
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_nanos() as u64)
+        .unwrap_or(0x5A3C_1234);
+    let mut x = nanos ^ ((std::process::id() as u64) << 17) ^ 0x9E37_79B9_7F4A_7C15;
+    x ^= x >> 30;
+    x = x.wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    x ^= x >> 27;
+    x = x.wrapping_mul(0x94D0_49BB_1331_11EB);
+    x ^= x >> 31;
+    format!("{:06}", x % 1_000_000)
+}
+
+fn handle_connection(mut stream: TcpStream, pin: &str, paths_file: &Path, dirty: &AtomicBool) {
+    let Some((method, target, body)) = read_http_request(&mut stream) else {
+        return;
+    };
+    let (path, query) = target.split_once('?').unwrap_or((&target, ""));
+    let params = parse_query(query);
+    let supplied_pin = params.iter().find(|(k, _)| k == "pin").map(|(_, v)| v.as_str()).unwrap_or("");
+
+    if supplied_pin != pin {
+        let html = render_login_page(path);
+        send_response(&mut stream, "200 OK", "text/html; charset=utf-8", html.as_bytes(), None);
+        return;
+    }
+
+    match (method.as_str(), path) {
+        ("GET", "/") => {
+            let notice = params.iter().find(|(k, _)| k == "msg").map(|(_, v)| v.as_str()).unwrap_or("");
+            let html = render_dashboard(pin, paths_file, notice);
+            send_response(&mut stream, "200 OK", "text/html; charset=utf-8", html.as_bytes(), None);
+        }
+        ("GET", "/logs.zip") => {
+            let zip = build_logs_zip(paths_file);
+            send_response(
+                &mut stream,
+                "200 OK",
+                "application/zip",
+                &zip,
+                Some("attachment; filename=\"trinityxsx-logs.zip\""),
+            );
+        }
+        ("POST", "/paths") => {
+            let form = parse_query(&body);
+            let raw = form.iter().find(|(k, _)| k == "paths").map(|(_, v)| v.as_str()).unwrap_or("");
+            let mut next = Vec::new();
+            for line in raw.lines() {
+                let _ = library::push_unique_path(&mut next, line);
+            }
+            let msg = match library::write_paths(paths_file, &next) {
+                Ok(()) => {
+                    dirty.store(true, Ordering::Release);
+                    format!("Saved {} game folder(s).", next.len())
+                }
+                Err(e) => format!("Error saving game_paths.txt: {e}"),
+            };
+            send_redirect(&mut stream, &format!("/?pin={pin}&msg={}", url_encode(&msg)));
+        }
+        ("POST", "/config") => {
+            let form = parse_query(&body);
+            let title = form.iter().find(|(k, _)| k == "title").map(|(_, v)| v.as_str()).unwrap_or("");
+            let raw_toml = form.iter().find(|(k, _)| k == "toml").map(|(_, v)| v.as_str()).unwrap_or("");
+            let msg = if !is_safe_title_id(title) {
+                "Invalid title folder name.".into()
+            } else {
+                match toml::from_str::<Config>(raw_toml) {
+                    Ok(_) => {
+                        let cfg_path = library::config_path_for_title(title);
+                        if let Some(parent) = cfg_path.parent() {
+                            let _ = fs::create_dir_all(parent);
+                        }
+                        match fs::write(&cfg_path, raw_toml.replace("\r\n", "\n")) {
+                            Ok(()) => {
+                                dirty.store(true, Ordering::Release);
+                                format!("Saved xcl.toml for {title}.")
+                            }
+                            Err(e) => format!("Write failed: {e}"),
+                        }
+                    }
+                    Err(e) => format!("Invalid TOML (not saved): {e}"),
+                }
+            };
+            send_redirect(&mut stream, &format!("/?pin={pin}&msg={}", url_encode(&msg)));
+        }
+        _ => {
+            send_response(&mut stream, "404 Not Found", "text/plain; charset=utf-8", b"Not Found", None);
+        }
+    }
+}
+
+fn read_http_request(stream: &mut TcpStream) -> Option<(String, String, String)> {
+    let mut buf = Vec::with_capacity(4096);
+    let mut chunk = [0u8; 2048];
+    let header_end;
+    loop {
+        let n = stream.read(&mut chunk).ok()?;
+        if n == 0 {
+            return None;
+        }
+        buf.extend_from_slice(&chunk[..n]);
+        if let Some(pos) = find_subslice(&buf, b"\r\n\r\n") {
+            header_end = pos + 4;
+            break;
+        }
+        if buf.len() > 16384 {
+            return None;
+        }
+    }
+    let header_text = String::from_utf8_lossy(&buf[..header_end]).into_owned();
+    let mut lines = header_text.lines();
+    let req_line = lines.next()?;
+    let mut parts = req_line.split_whitespace();
+    let method = parts.next()?.to_owned();
+    let target = parts.next()?.to_owned();
+    let mut content_length = 0usize;
+    for line in lines {
+        if let Some((k, v)) = line.split_once(':') {
+            if k.eq_ignore_ascii_case("Content-Length") {
+                content_length = v.trim().parse().unwrap_or(0).min(MAX_HTTP_BODY_BYTES);
+            }
+        }
+    }
+    while buf.len() < header_end + content_length {
+        let n = stream.read(&mut chunk).ok()?;
+        if n == 0 {
+            break;
+        }
+        buf.extend_from_slice(&chunk[..n]);
+        if buf.len() > header_end + MAX_HTTP_BODY_BYTES {
+            break;
+        }
+    }
+    let body_end = (header_end + content_length).min(buf.len());
+    let body = String::from_utf8_lossy(&buf[header_end..body_end]).into_owned();
+    Some((method, target, body))
+}
+
+fn find_subslice(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    haystack.windows(needle.len()).position(|w| w == needle)
+}
+
+fn send_response(stream: &mut TcpStream, status: &str, content_type: &str, body: &[u8], disposition: Option<&str>) {
+    let mut header = format!(
+        "HTTP/1.1 {status}\r\nContent-Type: {content_type}\r\nContent-Length: {}\r\nCache-Control: no-store\r\nConnection: close\r\n",
+        body.len()
+    );
+    if let Some(disp) = disposition {
+        header.push_str(&format!("Content-Disposition: {disp}\r\n"));
+    }
+    header.push_str("\r\n");
+    let _ = stream.write_all(header.as_bytes());
+    let _ = stream.write_all(body);
+    let _ = stream.flush();
+}
+
+fn send_redirect(stream: &mut TcpStream, location: &str) {
+    let resp = format!("HTTP/1.1 303 See Other\r\nLocation: {location}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
+    let _ = stream.write_all(resp.as_bytes());
+    let _ = stream.flush();
+}
+
+fn is_safe_title_id(title: &str) -> bool {
+    !title.is_empty()
+        && title.len() <= 80
+        && title.bytes().all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'-' | b'_'))
+        && !title.contains("..")
+}
+
+fn html_escape(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for ch in s.chars() {
+        match ch {
+            '&' => out.push_str("&amp;"),
+            '<' => out.push_str("&lt;"),
+            '>' => out.push_str("&gt;"),
+            '"' => out.push_str("&quot;"),
+            '\'' => out.push_str("&#39;"),
+            _ => out.push(ch),
+        }
+    }
+    out
+}
+
+fn url_encode(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for b in s.bytes() {
+        if b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.' | b'~') {
+            out.push(b as char);
+        } else if b == b' ' {
+            out.push('+');
+        } else {
+            out.push_str(&format!("%{:02X}", b));
+        }
+    }
+    out
+}
+
+pub fn url_decode(s: &str) -> String {
+    let bytes = s.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'+' => {
+                out.push(b' ');
+                i += 1;
+            }
+            b'%' if i + 2 < bytes.len() => {
+                if let (Some(h), Some(l)) = (hex_val(bytes[i + 1]), hex_val(bytes[i + 2])) {
+                    out.push((h << 4) | l);
+                    i += 3;
+                } else {
+                    out.push(b'%');
+                    i += 1;
+                }
+            }
+            b => {
+                out.push(b);
+                i += 1;
+            }
+        }
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+fn hex_val(b: u8) -> Option<u8> {
+    match b {
+        b'0'..=b'9' => Some(b - b'0'),
+        b'a'..=b'f' => Some(b - b'a' + 10),
+        b'A'..=b'F' => Some(b - b'A' + 10),
+        _ => None,
+    }
+}
+
+fn parse_query(input: &str) -> Vec<(String, String)> {
+    let mut out = Vec::new();
+    for pair in input.split('&') {
+        if pair.is_empty() {
+            continue;
+        }
+        let (k, v) = pair.split_once('=').unwrap_or((pair, ""));
+        out.push((url_decode(k), url_decode(v)));
+    }
+    out
+}
