From 5f673a67d23001879ef88b5ea0eb1373594c9a8d Mon Sep 17 00:00:00 2001
From: TrinityXSX <trinityxsx@users.noreply.github.com>
Date: Thu, 26 Nov 2026 13:28:08 +0100
Subject: [PATCH] TrinityXSX: build the library from the TrinityXSX repository

The TrinityXSX library (game catalog, menu, covers, Web Companion,
GOG importer, i18n) is ordinary source in TrinityXSX's library/
folder instead of a patch series on top of XCL. This patch only wires
it in: the `library*` modules of the xcl crate and `library_menu` of
xcl.exe are read from ../../../../library/, which is TrinityXSX's
library/ when this checkout is TrinityXSX's xcl/ (tools/setup-sources.sh).

The modules keep their names (xcl::library, crate::library_i18n, ...),
so xcl.exe is built from the same code as before.
---
 crates/xcl/src/lib.rs  | 10 ++++++++++
 crates/xcl/src/main.rs | 14 ++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/crates/xcl/src/lib.rs b/crates/xcl/src/lib.rs
index 51118ee..6ba8712 100644
--- a/crates/xcl/src/lib.rs
+++ b/crates/xcl/src/lib.rs
@@ -20,6 +20,16 @@ pub mod host;
 pub mod insn;
 pub mod inspect;
 pub mod launcher;
+#[path = "../../../../library/library.rs"]
+pub mod library;
+#[path = "../../../../library/library_art.rs"]
+pub mod library_art;
+#[path = "../../../../library/library_gog.rs"]
+pub mod library_gog;
+#[path = "../../../../library/library_i18n.rs"]
+pub mod library_i18n;
+#[path = "../../../../library/library_web.rs"]
+pub mod library_web;
 pub mod loader;
 pub mod modules;
 pub mod pe;
diff --git a/crates/xcl/src/main.rs b/crates/xcl/src/main.rs
index b127420..0269fc7 100644
--- a/crates/xcl/src/main.rs
+++ b/crates/xcl/src/main.rs
@@ -4,6 +4,9 @@ use std::ffi::c_void;
 use std::path::PathBuf;
 use std::sync::atomic::Ordering;
 
+#[path = "../../../../library/library_menu.rs"]
+mod library_menu;
+
 /// Our own TLS callback: ntdll calls it for every thread start/exit in the process.
 /// In host mode it initialises the game's static TLS for the new thread and forwards
 /// the notification to the game's TLS callbacks / DllMains.
@@ -27,6 +30,9 @@ Usage:
   xcl run --in-process <game folder | file.exe> [-- game arguments]
       The same, with the game in this process instead of a child (for runtimes with one
       process per program, such as Wine on the PS5).
+  xcl library [games folder] [--list] | xcl library --game <game folder>
+      TrinityXSX library for unpacked Scarlett game folders. --list prints the catalog;
+      --game prepares the title with the active profile/preset and launches directly.
   xcl inspect <file.exe|file.dll> [--json]
       Analysis without running: imports and what XCL has for them (HLE / Windows / stub).
   xcl disasm <file> [--offset N] [--length N] [--all] [--hex] [--fssm FILE]
@@ -65,6 +71,14 @@ fn main() {
 
     let args: Vec<String> = std::env::args().skip(1).collect();
     let code = match args.first().map(String::as_str) {
+        Some("library") if args.len() == 3 && args[1] == "--game" => {
+            library_menu::run_direct(PathBuf::from(&args[2]))
+        }
+        Some("library") if args.len() == 1 => library_menu::run(None, false),
+        Some("library") if args.len() == 2 && args[1] == "--list" => library_menu::run(None, true),
+        Some("library") if args.len() == 2 || (args.len() == 3 && args[2] == "--list") => {
+            library_menu::run(Some(PathBuf::from(&args[1])), args.len() == 3)
+        }
         Some("run") if args.len() >= 2 && !(args[1] == "--in-process" && args.len() < 3) => {
             let in_process = args[1] == "--in-process";
             let target = if in_process { 2 } else { 1 };
-- 
